{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
NOTE TO DEVELOPERS: welcome to Impact theme! We hope that you will enjoy editing this theme as much as we did for
  developing it. We have put a lot of work to make this theme as developer friendly as possible by offering you
  hooks to integrate into critical parts of the theme. You will find the complete technical documentation (including
  all events, dependencies...) in the "documentation.txt" file, located in the Assets folder.
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="theme-color" content="{{ settings.header_background }}">

    <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- unless settings.heading_font.system? -%}
      <link rel="preload_tag" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload_tag" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
  </head>

  <body class="{% if settings.zoom_image_on_hover %}zoom-image--enabled{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <a href="#main" class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}

      {%- if settings.cart_type == 'popover' -%}
        <cart-notification-drawer open-from="bottom" class="quick-buy-drawer drawer"></cart-notification-drawer>
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' -%}
      {%- section 'account-banner' -%}
    {%- endif -%}

    <main role="main" id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: due to the very complex logic of margin/padding collapsing in Impact, the footer group is
      added into the main element to ensure that dynamic sections added into the footer group are properly laid out.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
    <script>
// LINKED PRODUCTS SWATCHES - Hover and Hold Behavior
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 Linked Products - Hover and Hold Behavior - Starting...');

  // Mobile touch handling for hold behavior
  let touchStartTime = 0;
  let touchTimer = null;
  let isLongPress = false;
  let isHoldActive = false;

  // Touch start - begin hold detection
  document.addEventListener('touchstart', function(e) {
    const productCard = e.target.closest('product-card');
    if (!productCard) return;

    touchStartTime = Date.now();
    isLongPress = false;
    isHoldActive = false;

    // Set timer for long press (500ms)
    touchTimer = setTimeout(() => {
      isLongPress = true;
      isHoldActive = true;
      productCard.classList.add('hold-active');
      console.log('📱 Long press detected - showing swatches');
    }, 500);
  }, { passive: true });

  // Touch end - handle click or hold
  document.addEventListener('touchend', function(e) {
    const productCard = e.target.closest('product-card');
    if (!productCard) return;

    if (touchTimer) {
      clearTimeout(touchTimer);
      touchTimer = null;
    }

    // If it was a long press, prevent the click and keep swatches visible
    if (isLongPress) {
      e.preventDefault();
      e.stopPropagation();
      console.log('📱 Long press ended - preventing click, keeping swatches visible');
      
      // Keep swatches visible for 3 seconds
      setTimeout(() => {
        productCard.classList.remove('hold-active');
        isHoldActive = false;
        console.log('📱 Hiding swatches after delay');
      }, 3000);
    } else {
      // It was a quick tap, allow normal navigation
      console.log('📱 Quick tap - allowing navigation');
    }
  }, { passive: false });

  // Touch cancel - cleanup
  document.addEventListener('touchcancel', function(e) {
    const productCard = e.target.closest('product-card');
    if (!productCard) return;

    if (touchTimer) {
      clearTimeout(touchTimer);
      touchTimer = null;
    }

    productCard.classList.remove('hold-active');
    isHoldActive = false;
  }, { passive: true });

  // Handle clicking on linked variant thumbnails
  document.addEventListener('click', function(e) {
    const thumb = e.target.closest('.linked-variant-thumb');
    if (!thumb) return;

    const productCard = thumb.closest('product-card');
    if (!productCard) return;

    e.preventDefault();
    e.stopPropagation();
    
    console.log('🎨 Clicked on linked variant thumbnail');
    
    // Get data from attributes
    const productId = thumb.getAttribute('data-product-id');
    const productHandle = thumb.getAttribute('data-handle');
    const isCurrent = thumb.getAttribute('data-is-current') === 'true';
    const primaryImage = thumb.getAttribute('data-primary');
    const secondaryImage = thumb.getAttribute('data-secondary');
    const productUrl = thumb.getAttribute('data-url');
    const variationValue = thumb.getAttribute('data-variation-value');
    
    console.log('📋 Product ID:', productId);
    console.log('📋 Product Handle:', productHandle);
    console.log('📋 Is current product:', isCurrent);
    console.log('🎨 Variation value:', variationValue);
    console.log('🖼️ Primary image:', primaryImage);
    console.log('🔗 Product URL:', productUrl);
    
    // Update selection state
    const swatchesContainer = thumb.closest('.linked-products-swatches');
    if (swatchesContainer) {
      swatchesContainer.querySelectorAll('.linked-variant-thumb').forEach(t => {
        t.classList.remove('is-selected');
        t.setAttribute('aria-pressed', 'false');
      });
      thumb.classList.add('is-selected');
      thumb.setAttribute('aria-pressed', 'true');
    }

    // Switch images for visual feedback (NO REDIRECT)
    if (primaryImage) {
      // Switch main image
      const mainImg = productCard.querySelector('.product-card__image--primary');
      if (mainImg) {
        const imgElement = mainImg.tagName === 'IMG' ? mainImg : mainImg.querySelector('img');
        if (imgElement) {
          imgElement.src = primaryImage;
          imgElement.srcset = primaryImage;
          console.log('✅ Updated main image');
        }
      }
      
      // Switch secondary image
      const secondaryImg = productCard.querySelector('.product-card__image--secondary');
      if (secondaryImg && secondaryImage) {
        const imgElement = secondaryImg.tagName === 'IMG' ? secondaryImg : secondaryImg.querySelector('img');
        if (imgElement) {
          imgElement.src = secondaryImage;
          imgElement.srcset = secondaryImage;
          console.log('✅ Updated secondary image');
        }
      }

      // Update product links (but don't navigate)
      if (productUrl) {
        const links = productCard.querySelectorAll('a[href*="/products/"]');
        links.forEach(link => {
          link.href = productUrl;
        });
        console.log('✅ Updated product links (ready for navigation)');
      }
    }

    // On mobile, keep swatches visible after selection
    if (isHoldActive) {
      console.log('📱 Keeping swatches visible after selection');
      // Keep the hold-active class for a bit longer
      setTimeout(() => {
        productCard.classList.remove('hold-active');
        isHoldActive = false;
        console.log('📱 Hiding swatches after selection');
      }, 2000);
    }

    console.log('✅ Image switched, selection updated - NO REDIRECT');
  });

  console.log('✅ Hover and hold behavior handler initialized');
});
</script>
  </body>
</html>