{%- liquid
  assign nexus_variant = product.selected_or_first_available_variant
  assign nexus_contract = nexus_variant.metafields.nexus.resolved.value
  assign nexus_field = product.metafields.custom.video_product_page
  if nexus_contract.fields contains 'custom.video_product_page'
    assign nexus_field = nexus_variant.metafields.custom.video_product_page
  endif
-%}
{%- assign nexus_entry = nexus_field.value -%}
{%- assign nexus_block_text = nexus_entry.text.value -%}
{%- assign nexus_section_video = nexus_entry.video.value -%}
{%- assign nexus_section_mobile_video = nexus_entry.mobile_video.value -%}
{%- assign nexus_section_text_color = nexus_entry.text_color.value -%}
{%- assign nexus_section_overlay_color = nexus_entry.overlay_color.value -%}
{%- if nexus_entry != blank -%}
{%- unless section.settings.full_width -%}
  {%- render 'section-spacing-collapsing' -%}
{%- endunless -%}

<style>
  #shopify-section-{{ section.id }} {
    {%- if section.settings.full_width -%}
      --section-outer-spacing-block: 0;
    {%- endif -%}

    --content-over-media-overlay: {{ nexus_section_overlay_color.rgb }} / {{ section.settings.overlay_opacity | divided_by: 100.0 }};

    {%- if section.settings.allow_transparent_header -%}
      margin-block-start: calc(-1 * var(--header-height) * var(--section-is-first));
    {%- endif -%}
  }

  {%- unless section.settings.full_width -%}
    #shopify-section-{{ section.id }}:first-child .section[allow-transparent-header] {
      padding-block-start: max(var(--section-inner-max-spacing-block), var(--header-height));
    }
  {%- endunless -%}
</style>

<div
  {% render 'section-properties', text_color: nexus_section_text_color %}
  {% if section.settings.allow_transparent_header %}
    allow-transparent-header
  {% endif %}
>
  {%- capture class -%}content-over-media {% if section.settings.video_size != 'auto' %}content-over-media--{{ section.settings.video_size }}{% endif %} {% if section.settings.full_width %}full-bleed{% else %}shadow-block rounded-lg{% endif %}{%- endcapture -%}

  <div {% render 'surface', class: class, text_color: nexus_section_text_color %}>
    {%- capture poster -%}
      {%- assign poster_image = section.settings.poster | default: nexus_section_video.preview_image -%}

      {%- if section.settings.autoplay == false and poster_image != blank -%}
        {%- capture sizes -%}{% if section.settings.full_width %}100vw{% else %}(max-width: 740px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), min({{ settings.page_width }}px, 100vw - 96px){% endif %}{%- endcapture -%}
        {{- poster_image | image_url: width: poster_image.width | image_tag: sizes: sizes, widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200' -}}
      {%- endif -%}
    {%- endcapture -%}

    {%- if nexus_section_video -%}
      {%- if section.settings.autoplay -%}
        {%- assign show_controls = false -%}
      {%- else -%}
        {%- assign show_controls = true -%}
      {%- endif -%}

      {%- if nexus_section_mobile_video != blank -%}
        {%- assign poster_image = section.settings.poster | default: nexus_section_mobile_video.preview_image -%}

        <video-media
          {% if section.settings.autoplay %}
            autoplay
          {% endif %}
          class="sm:hidden"
          {% if section.settings.video_size == 'auto' %}
            style="--aspect-ratio: {{ nexus_section_mobile_video.aspect_ratio }}"
          {% endif %}
        >
          {{-
            nexus_section_mobile_video
            | video_tag:
              class: 'object-cover sm:hidden',
              controls: show_controls,
              playsinline: true,
              muted: section.settings.autoplay,
              loop: section.settings.autoplay,
              preload: 'metadata',
              image_size: '400x'
          -}}
          {{- poster_image | image_url: width: poster_image.width | image_tag: sizes: '100vw', widths: '200,300,400,500,600,700,800,900,1000,1200' -}}
        </video-media>
      {%- endif -%}

      <video-media
        {% if section.settings.autoplay %}
          autoplay
        {% endif %}
        {% if nexus_section_mobile_video != blank %}
          class="hidden sm:block"
        {% endif %}
        {% if section.settings.video_size == 'auto' %}
          style="--aspect-ratio: {{ nexus_section_video.aspect_ratio }}"
        {% endif %}
      >
        {{-
          nexus_section_video
          | video_tag: playsinline: true, preload: 'metadata', muted: section.settings.autoplay, loop: section.settings.autoplay, controls: show_controls, image_size: '800x'
        -}}
        {{- poster -}}
      </video-media>
    {%- else -%}
      <video-media
        host="{{ section.settings.external_video_url.type }}"
        {% if section.settings.autoplay %}
          autoplay class="pointer-events-none"
        {% endif %}
      >
        {{- poster -}}

        <template>
          {%- if section.settings.external_video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.external_video_url.id }}?playsinline=1&{% if section.settings.autoplay %}autoplay=1&controls=0&mute=1&loop=1&{% endif %}playlist={{ section.settings.external_video_url.id }}&enablejsapi=1&rel=0&modestbranding=1&origin={{ 'https://' | append: request.host | url_encode }}"
              allow="autoplay; encrypted-media"
              allowfullscreen="allowfullscreen"
            ></iframe>
          {%- elsif section.settings.external_video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.external_video_url.id }}?autopause=1&{% if section.settings.autoplay %}background=1&autoplay=1&loop=1&muted=1&{% endif %}transparent=0&responsive=1&portrait=0&title=0&byline=0&color={{ settings.text_color | remove_first: '#' }}"
              allow="autoplay; encrypted-media;"
              allowfullscreen="allowfullscreen"
            ></iframe>
          {%- endif -%}
        </template>
      </video-media>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="place-self-center text-center">
        <div class="prose">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'play' -%}
                {%- unless section.settings.autoplay -%}
                  <button class="video-play-button" type="button" {{ block.shopify_attributes }}>
                    <span class="sr-only">{{ 'general.accessibility.play_video' | t }}</span>
                    {%- render 'icon' with 'play-button', width: 48, height: 48 -%}
                  </button>
                {%- endunless -%}

              {%- when 'subheading' -%}
                {%- if nexus_block_text != blank -%}
                  <p class="bold" {{ block.shopify_attributes }}>{{ nexus_block_text | escape }}</p>
                {%- endif -%}

              {%- when 'heading' -%}
                {%- if nexus_block_text != blank -%}
                  <p class="{{ block.settings.heading_tag }}" {{ block.shopify_attributes }}>{{ nexus_block_text | escape }}</p>
                {%- endif -%}

              {%- when 'richtext' -%}
                {%- if block.settings.content != blank -%}
                  <div {{ block.shopify_attributes }}>
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- if nexus_block_text != blank -%}
                  {% render 'button',
                    content: nexus_block_text,
                    href: block.settings.url,
                    size: block.settings.size,
                    style: block.settings.style,
                    background: block.settings.background,
                    text_color: nexus_block_text_color,
                    block: block
                  %}
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>


{%- endif -%}
