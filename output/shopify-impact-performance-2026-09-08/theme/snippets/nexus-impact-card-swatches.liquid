{%- liquid
  assign nexus_groups = product.metafields.nexus.resolved.value.swatches
  assign nexus_selected = nexus_variant | default: product.selected_or_first_available_variant
  assign nexus_selected_id = nexus_selected.id | append: ''
-%}
{%- capture nexus_thumbnails -%}
  {%- if product.metafields.nexus.resolved.value.managed and nexus_groups.size > 1 -%}
    {%- for nexus_chunk in (0..4) -%}
      {%- assign nexus_offset = nexus_chunk | times: 50 -%}
      {%- for nexus_group in nexus_groups limit: 50 offset: nexus_offset -%}
        {%- liquid
          assign nexus_candidates = null | sort
          for nexus_variant_chunk in (0..4)
            assign nexus_variant_offset = nexus_variant_chunk | times: 50
            for nexus_id in nexus_group.variantIds limit: 50 offset: nexus_variant_offset
              assign nexus_numeric = nexus_id | plus: 0
              assign nexus_match = product.variants | where: 'id', nexus_numeric | where: 'matched', true
              assign nexus_candidates = nexus_candidates | concat: nexus_match
            endfor
          endfor
          assign nexus_available = nexus_candidates | where: 'available', true | sort: 'price'
          assign nexus_choice = nexus_available.first
          if nexus_choice == blank
            assign nexus_candidates = nexus_candidates | sort: 'price'
            assign nexus_choice = nexus_candidates.first
          endif
          assign nexus_chosen = false
          if nexus_group.variantIds contains nexus_selected_id
            assign nexus_chosen = true
          endif
        -%}
        {%- if nexus_choice != blank -%}
          {%- capture nexus_label -%}{%- for nexus_index in nexus_group.optionIndexes -%}{% unless forloop.first %} / {% endunless %}{{ nexus_choice.options[nexus_index] }}{%- endfor -%}{%- endcapture -%}
          <a class="linked-variant-thumb {% if nexus_chosen %}is-selected{% endif %}" href="{{ nexus_choice.url }}" data-nexus-swatch data-variant-id="{{ nexus_choice.id }}" data-nexus-group="{{ nexus_group.id | escape }}" aria-label="{{ nexus_label | escape }}" {% if nexus_chosen %}aria-current="true"{% endif %}>
            {%- if nexus_choice.featured_media -%}{{- nexus_choice.featured_media | image_url: width: 96 | image_tag: alt: nexus_label, loading: 'lazy', width: 48, height: 48 -}}{%- else -%}<span>{{ nexus_label | escape }}</span>{%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- elsif product.metafields.custom.variation_products.value != blank -%}
    {%- for nexus_linked in product.metafields.custom.variation_products.value -%}
      {%- assign nexus_label = nexus_linked.metafields.custom.variation_value | default: nexus_linked.title -%}
      <a class="linked-variant-thumb {% if nexus_linked.id == product.id %}is-selected{% endif %}" href="{{ nexus_linked.selected_or_first_available_variant.url }}" data-nexus-swatch data-variant-id="{{ nexus_linked.selected_or_first_available_variant.id }}" data-nexus-group="{{ nexus_linked.id }}:family" aria-label="{{ nexus_label | escape }}" {% if nexus_linked.id == product.id %}aria-current="true"{% endif %}>
        {{- nexus_linked.featured_image | image_url: width: 96 | image_tag: alt: nexus_label, loading: 'lazy', width: 48, height: 48 -}}
      </a>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if nexus_thumbnails != blank -%}
  <nexus-card-swatches class="linked-products-swatches" aria-label="{{ 'nexus.card_options' | t | escape }}">{{ nexus_thumbnails }}<a class="linked-products-more" data-nexus-more href="{{ product.url }}" hidden aria-label="{{ 'nexus.all_options' | t | escape }}"></a></nexus-card-swatches>
{%- endif -%}
