+nexus-impact-features .features-show-more__count { min-width: 24px; padding: 1px 6px; border-radius: 100px; background: rgb(var(--text-color) / .08); font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
+nexus-impact-features .features-show-more__chevron { display: grid; place-items: center; width: 20px; height: 20px; transition: transform 150ms ease; }
+nexus-impact-features .features-show-more[aria-expanded="true"] .features-show-more__chevron { transform: rotate(180deg); }
+/* Native modal dialogs provide the top layer, focus containment and Escape.
