+nexus-impact-features .features-modal::backdrop { background: #000c; }
+nexus-impact-features .features-modal__header { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-4); position: sticky; top: 0; z-index: 1; padding: var(--spacing-4) var(--spacing-6); border-block-end: 1px solid rgb(var(--text-color) / .15); background: rgb(var(--background)); }
+nexus-impact-features .features-modal__header h2 { overflow-wrap: anywhere; }
+nexus-impact-features .features-modal__close { display: grid; flex: 0 0 44px; width: 44px; height: 44px; place-items: center; border: 1px solid rgb(var(--text-color) / .35); border-radius: 50%; cursor: pointer; }
