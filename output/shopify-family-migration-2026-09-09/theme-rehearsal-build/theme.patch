+.product-info > .product-info__block-item:has(nexus-impact-features) + .accordion-group > .product-info__block-item:first-child > .accordion,
+.product-info > .product-info__block-item:has(nexus-impact-features) + .product-info__block-item > .product-info__accordion { border-block-start-width: 0; }
+nexus-impact-features .accordion__content { padding-inline-end: 0; }
+nexus-impact-features .features-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gutter); }
