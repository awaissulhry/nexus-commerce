+nexus-impact-features .features-card__image { width: 100%; height: 100%; min-height: 0; object-fit: contain; }
+nexus-impact-features .features-card__overlay { display: grid; position: absolute; inset: 0; place-items: center; padding: var(--spacing-3); background: #000c; color: #ff8300; opacity: 0; transition: opacity 150ms ease; font-size: var(--text-sm); }
+nexus-impact-features .features-card__title { display: flex; position: relative; justify-content: center; align-items: center; flex: 1; min-height: 44px; padding: var(--spacing-2) var(--spacing-8); background: #191919; color: #fff; font-size: var(--text-sm); font-weight: 600; line-height: 1.35; }
+nexus-impact-features .features-card__action { position: absolute; inset-inline-end: var(--spacing-3); font-size: 20px; font-weight: 400; }
+nexus-impact-features :is(button, summary):focus-visible { outline: 2px solid rgb(var(--text-color)); outline-offset: 4px; }
+nexus-impact-features .features-card:focus-visible .features-card__overlay { opacity: 1; }
+/* A stable, full-width disclosure with a separate remaining-count badge. */
