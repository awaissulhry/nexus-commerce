{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "**/.env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "NEXT_DIST_DIR", "NODE_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    // @nexus/api and @nexus/web do not use this entry: their own entries below replace it. Change all three together.
    "typecheck": {
      "dependsOn": ["@nexus/shared#build", "@nexus/events#build"],
      "outputs": []
    },
    // 2026-09-30: each app's typecheck cache key must hold every file its tsc program reads from outside its folder.
    // turbo hashes only the package's own folder and the builds it depends on, so an edit to apps/web/src (@nexus/api
    // compiles presence.ts, registry.ts and tone.ts), to apps/api/src (@nexus/web compiles lib/listing-coordinate.ts),
    // to docs/fixtures (vt1/fixtures.ts) or to packages/database (its .d.ts files and the Prisma schema) left the hash
    // unchanged, and a cached pass replayed. That local cache is one directory shared by every worktree of a checkout.
    // See ci.yml, "Typecheck both apps". Here, not in apps/*/turbo.json: a file there is an app file, and
    // deploy-api.yml would ship the services for a CI change. These entries REPLACE "typecheck" for the two apps (turbo
    // does not merge a root package#task with the generic task; tested 2026-09-30): every key is copied, so a change to
    // "typecheck" (dependsOn, outputs, env, cache…) must be made in all three. apps/web/package.json: the API reaches
    // web files through the @nexus/web package, so its package.json takes part in resolving them.
    "@nexus/api#typecheck": {
      "dependsOn": ["@nexus/shared#build", "@nexus/events#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/packages/database/**"
      ],
      "outputs": []
    },
    "@nexus/web#typecheck": {
      "dependsOn": ["@nexus/shared#build", "@nexus/events#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/api/package.json",
        "$TURBO_ROOT$/docs/fixtures/**",
        "$TURBO_ROOT$/packages/database/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["@nexus/shared#build", "@nexus/events#build"],
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    // The factory workspaces (apps/factory-api, apps/factory-web, packages/factory-db, packages/factory-domain,
    // packages/db-kit). They use neither @nexus/shared nor @nexus/events, so these entries replace the generic tasks
    // above for them. The factory packages export TypeScript source: `^typecheck` puts the factory packages a workspace
    // depends on into its cache key (turbo hashes only a package's own folder and the tasks it depends on), and runs
    // factory-db's `prisma generate` before anything that imports its client. Strict env mode: FACTORY_API_URL reaches
    // the web's build and dev server only because it is listed here.
    "@nexus/db-kit#typecheck": {
      "outputs": []
    },
    "@nexus/factory-domain#typecheck": {
      "outputs": []
    },
    "@nexus/factory-db#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["src/generated/**"]
    },
    "@nexus/factory-api#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@nexus/factory-web#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@nexus/factory-api#build": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "@nexus/factory-web#build": {
      "dependsOn": ["^typecheck"],
      "env": ["FACTORY_API_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@nexus/factory-web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["FACTORY_API_URL"]
    }
  }
}
