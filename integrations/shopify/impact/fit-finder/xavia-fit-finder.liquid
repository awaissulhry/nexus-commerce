{%- comment -%}
  ----------------------------------------------------------------------------------------------------------------------
  XAVIA FIT FINDER
  ----------------------------------------------------------------------------------------------------------------------
  The "Size guide" link on the size option's label row, and the data its dialog needs. Rendered by variant-picker.liquid
  for the size option only, in place of the theme's own size chart link (which stays for products without a chart).
  The dialog (assets/xavia-fit-finder.js) loads on the first click, or at idle time when this device already has a
  saved fit profile (then it also warns under the size buttons when the chosen size will not fit).

  Which chart a product gets:
  * the JSON metafield xavia.fit_chart, when set: a whole chart, a default chart's key, or { "men": …, "women": … };
  * else a product whose type or a tag is jacket / jackets / vest / gilet / giacca / giubbotto gets the jacket charts
    in xavia-fit-charts.liquid: tag "men" only = men's chart, tag "women" only = women's chart, both or none = both
    charts, and the shopper's own body type picks one;
  * else nothing: no link (the theme's size chart link stays as it is).
  A "leather" tag makes the recommendation sit a little closer (leather gives with wear).

  Supported variables: product, option (the size option), form_id.
{%- endcomment -%}

{%- liquid
  assign xff_kind = ''
  assign xff_men = false
  assign xff_women = false
  assign xff_material = ''
  assign xff_words = product.tags | join: '|' | append: '|' | append: product.type | downcase | split: '|'
  for xff_word in xff_words
    assign xff_w = xff_word | strip
    case xff_w
      when 'jacket', 'jackets', 'vest', 'gilet', 'giacca', 'giubbotto'
        assign xff_kind = 'jacket'
      when 'men'
        assign xff_men = true
      when 'women'
        assign xff_women = true
      when 'leather'
        assign xff_material = 'leather'
    endcase
  endfor
  if product.metafields.xavia.fit_chart != blank
    assign xff_kind = 'custom'
  endif

  assign xff_lang = request.locale.iso_code | slice: 0, 2
  case xff_lang
    when 'it'
      assign xff_label = 'Guida alle taglie'
    when 'de'
      assign xff_label = 'Größentabelle'
    when 'fr'
      assign xff_label = 'Guide des tailles'
    when 'es'
      assign xff_label = 'Guía de tallas'
    else
      assign xff_label = 'Size guide'
  endcase

  assign xff_logo = ''
  if shop.brand.logo != blank
    assign xff_logo = shop.brand.logo | image_url: width: 300
  endif

  assign xff_image = ''
  if product.featured_image != blank
    assign xff_image = product.featured_image | image_url: width: 400
  endif

  if routes.root_url == '/'
    assign xff_contact = '/pages/contact'
  else
    assign xff_contact = routes.root_url | append: '/pages/contact'
  endif
-%}

{%- if xff_kind != '' -%}
  <div class="xff-entry" data-xff data-xff-form="{{ form_id | escape }}">
    <button type="button" class="xff-trigger text-sm text-subdued" data-xff-open data-xff-module="{{ 'xavia-fit-finder.js' | asset_url }}" aria-haspopup="dialog">
      <span class="link" data-xff-label>{{ xff_label }}</span>
    </button>

    <script type="application/json" data-xff-config>
      {
        "formId": {{ form_id | json }},
        "optionPosition": {{ option.position | json }},
        "values": [
          {%- for value in option.values -%}
            {"name": {{ value.name | json }}, "id": {{ value.id | json }}, "available": {{ value.available | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "kind": {{ xff_kind | json }},
        "audience": [{% if xff_men %}"men"{% endif %}{% if xff_men and xff_women %},{% endif %}{% if xff_women %}"women"{% endif %}],
        "material": {{ xff_material | json }},
        "override": {% if product.metafields.xavia.fit_chart != blank %}{{ product.metafields.xavia.fit_chart.value | json }}{% else %}null{% endif %},
        "defaults": {% render 'xavia-fit-charts' %},
        "product": {"title": {{ product.title | json }}, "image": {{ xff_image | json }}},
        "shop": {{ shop.name | json }},
        "logo": {{ xff_logo | json }},
        "privacyUrl": {{ shop.privacy_policy.url | default: '' | json }},
        "bodies": {"male": {{ 'xavia-fit-body-male.js' | asset_url | json }}, "female": {{ 'xavia-fit-body-female.js' | asset_url | json }}},
        "font": {{ 'xavia-fit-inter.woff2' | asset_url | json }},
        "locale": {{ request.locale.iso_code | json }},
        "country": {{ localization.country.iso_code | json }},
        "contactUrl": {{ xff_contact | json }}
      }
    </script>

    <script>
      (function () {
        if (window.xaviaFit) return;
        var loading = null;
        var load = function (url) { return loading || (loading = import(url)); };
        window.xaviaFit = { load: load };
        document.addEventListener('click', function (event) {
          var button = event.target.closest && event.target.closest('[data-xff-open]');
          if (!button) return;
          event.preventDefault();
          button.setAttribute('aria-busy', 'true');
          load(button.getAttribute('data-xff-module')).then(function (module) {
            button.removeAttribute('aria-busy');
            module.open(button);
          }, function () {
            loading = null;
            button.removeAttribute('aria-busy');
          });
        });
        var saved = null;
        try { saved = window.localStorage.getItem('xavia-fit-profile'); } catch (error) {}
        if (!saved) return;
        var start = function () {
          var button = document.querySelector('[data-xff-open]');
          if (button) load(button.getAttribute('data-xff-module')).then(function (module) { module.init(); }, function () { loading = null; });
        };
        if ('requestIdleCallback' in window) window.requestIdleCallback(start, { timeout: 2500 }); else window.setTimeout(start, 1500);
      })();
    </script>

    <style>
      .xff-entry { display: contents; }
      .xff-trigger { padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; }
      .xff-trigger[aria-busy="true"] { cursor: progress; opacity: .7; }
    </style>
  </div>
{%- endif -%}
