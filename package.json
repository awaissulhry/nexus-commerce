{
  "name": "nexus-commerce",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "cd packages/database && node scripts/migrate-direct.mjs && cd ../.. && node apps/api/dist/index.js",
    "start:api": "cd packages/database && node scripts/migrate-direct.mjs && cd ../.. && node apps/api/dist/index.js",
    "start:web": "cd apps/web && npm start",
    "check:drift": "npm run check:drift --workspace=@nexus/database && npm run check:column-drift --workspace=@nexus/database",
    "tokens:gen": "tsx apps/web/src/design-system/tools/generate-tokens-css.ts",
    "tokens:check": "tsx apps/web/src/design-system/tools/generate-tokens-css.ts --check",
    "tokens:gen:factory": "tsx apps/factory/src/design-system/tools/generate-tokens-css.ts",
    "tokens:check:factory": "tsx apps/factory/src/design-system/tools/generate-tokens-css.ts --check",
    "grid:conformance": "node scripts/check-grid-chrome.mjs",
    "grid:parity": "node scripts/check-workspace-parity.mjs",
    "layout:v2": "node scripts/check-layout-v2.mjs",
    "grid:modules": "node scripts/check-grid-modules.mjs",
    "grid:modules:selftest": "node scripts/check-grid-modules.mjs --self-test",
    "postinstall": "patch-package",
    "editor:open": "node scripts/check-editor-open.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ag-grid-enterprise": "36.1.0",
    "ag-grid-react": "36.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5"
  }
}
