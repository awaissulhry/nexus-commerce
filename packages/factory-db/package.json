{
  "name": "@nexus/factory-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/database.ts",
    "./test-database": "./src/test-database.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:pg": "node ../../scripts/factory/run-pg-tests.mjs packages/factory-db",
    "migrate": "prisma migrate deploy",
    "migration": "tsx src/cli.ts migration",
    "policies": "tsx src/cli.ts policies",
    "check:drift": "node ../../scripts/factory/check-migrations-replay.mjs",
    "seed": "tsx src/cli.ts seed"
  },
  "dependencies": {
    "@nexus/db-kit": "*",
    "@nexus/factory-domain": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
