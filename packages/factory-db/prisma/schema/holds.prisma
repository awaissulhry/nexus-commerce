// The defect library, the disposition codes and quality holds (W2a schema wave 6/7; B-W2a-26; features QHS-001,
// QHS-005, QHS-074, MES-008; design quality.defects "Defect library" and "Disposition codes", quality.holds with its
// popups qh-place and qh-release, floor.final "Hold lot", floor.reasons "Pick the reason"). apps/factory-api's
// modules/quality/{defects,holds} write them (B-W2a-26), always through command(); the floor places a hold at the bench
// and confirms its quarantine move through floorCommand.
//
// The defect library has two levels: a category (no parent) and its defects (a parent category, never deeper). A defect
// carries its default class (CRITICAL, MAJOR, MINOR), the zone of the garment it is usually found in (the ids of
// factory-domain's garment zone map), the stages it applies to, an icon and a colour for the floor tiles and the picture
// they show. A code never changes (inspections, NCRs and reports keep it); a code in use is set inactive (retired), and
// only a code nothing names is deleted (the references refuse it otherwise). The operation screen's scrap and rework
// reasons stay production.prisma's ScrapReason (W1); the other reason lists are reasons.prisma's ReasonCode (wave 1/7).
//
// A disposition code is an outcome (use as is, rework, repair, regrade, return to the supplier, quarantine, scrap) with
// the stock move it posts and the follow-up record it opens, and when a decision with it needs a person's approval (by
// the NCR's severity, or by its value: the cost grain). ncr.prisma's disposition lines name them.
//
// A quality hold puts goods on hold: one or more records of one kind of the hold's site (lots, hides, work orders,
// bundles, garment serials, shipments, parcels), with the reason (the HOLD reason list's code), who placed it (an office
// user, a floor worker at the bench, or the system: none), the record that caused it (an inspection, an NCR, a Cr VI
// result, a certificate: type and id), the owner, the expected release, and the move to quarantine. ACTIVE → RELEASED
// (signed by someone who made none of the goods) | CLOSED (decided in its NCR: rejected, reworked, scrapped). While a
// hold is ACTIVE its goods are refused, for every login (the …_quality_plant_w2a_guards triggers): a held lot or hide is
// not issued or cut, a held bundle is not scanned, a held work order's garments, a held serial, a held parcel or
// shipment are not released, packed or shipped. A held work order's floor work waits on the work order's own ON_HOLD
// status (production.prisma, wave 5/7), which the hold's command sets beside it.
//
// W2b schema wave 11/16 (B-W2b-79): cause codes (QHS-004; design quality.defects "Cause codes"), the process a defect comes
// from, picked on inspection defects and NCRs; and the hold group (QHS-075; design quality.holds "Hold by genealogy"): one
// decision to hold what was made from a suspect record, kept as one QualityHold per kind of record and site, grouped.
//
// Who sees what (ownership/holds.json): the office reads and writes. The floor reads the defect library and the cause
// codes (the bench's and the reason tiles' pickers) and its site's holds (every floor write the hold guards check reads
// them), places a hold at the bench, confirms the quarantine move and releases with the inspector's PIN; it never sees a
// disposition code (an NCR's decision is the office's) or a hold group (the board's and the recall's, office work).
// Portal and link sessions read nothing here.

/// A stage of the factory a defect is found at, or an NCR was found at.
enum QualityStage {
  /// Incoming goods at the dock (a supplier's lot).
  INCOMING
  /// Stock on the shelf.
  STOCK
  CUTTING
  /// In-line, at an operation (sewing, assembly, finishing).
  IN_LINE
  /// The final inspection of the garments.
  FINAL
  PACKING
  /// Found by the customer (a complaint, a return).
  CUSTOMER
  AUDIT
}

/// One code of the defect library (QHS-001): a category (no parent) or a defect of a category. Never moves to another
/// category; retired (inactive), never deleted while an inspection defect or an NCR names it.
model DefectCode {
  id            String         @id @db.Uuid
  tenantId      String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The category of a defect; null: this code is a category. A category's parent is never a defect (two levels).
  parentId      String?        @db.Uuid
  /// Upper-case letters, digits, hyphens and underscores ("SEAM-OPEN"; factory-domain checks it); unique in the tenant.
  /// Never changes (inspection defects copy it).
  code          String
  labelIt       String
  labelEn       String
  /// The words in the other floor languages of the tenant's sites (Site.floorLocales): { "ro": "…" }.
  labelI18n     Json           @default("{}")
  /// The design system's tag icon (IconPicker id) and a swatch ("#RRGGBB") for the floor's tiles; null: none.
  icon          String?
  colour        String?
  /// The example picture the tiles show: a file of this code (StoredFile recordType "DefectCode"); its good and bad
  /// example photos are files of the code too. The floor sees it where the file is shared with its site's floor.
  pictureFileId String?        @db.Uuid
  /// A defect's default class (CRITICAL: a safety or legal defect, never accepted); a category has none.
  severity      DefectClass?
  /// Where on the garment it is usually found: a zone id of factory-domain's garment zone map ("SLEEVE_L"); null: any.
  zone          String?
  /// The stages it applies to (the pickers of those stages offer it); empty: every stage.
  stages        QualityStage[] @default([])
  /// An "Other" defect: the person adds a note (office) or a photo (floor).
  needsDetail   Boolean        @default(false)
  /// Pickers and tiles show the library in this order (lower first).
  sortOrder     Int            @default(0)
  /// Retired codes leave the pickers and stay on what names them.
  active        Boolean        @default(true)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById   String?        @db.Uuid

  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId.
  parent            DefectCode?        @relation("DefectCodeCategory", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  defects           DefectCode[]       @relation("DefectCodeCategory")
  picture           StoredFile?        @relation("DefectCodePicture", fields: [tenantId, pictureFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // quality.prisma, ncr.prisma: the inspection defects and the nonconformances that name it.
  inspectionDefects InspectionDefect[]
  // W2b inspection-plans.prisma (wave 10/16): the in-process checks that found it.
  inProcessChecks   InProcessCheck[]
  // W2b leather.prisma (wave 12/16): the marks of it on hides.
  hideMarks         HideMark[]
  nonconformances   Nonconformance[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from its defects, inspection defects and NCRs.
  @@unique([tenantId, id])
}

/// The process a cause belongs to (QHS-004; design quality.defects "Cause codes").
enum CauseProcess {
  MATERIAL
  SUPPLIER
  CUTTING
  SEWING
  FINISHING
  HANDLING
  DESIGN
  MEASUREMENT
}

/// One cause code (W2b, B-W2b-79; QHS-004): why a defect happened, with the process that answers for it and its words
/// in every floor language. A code never changes; a code in use is retired (inactive), only a code nothing names is
/// deleted (the references refuse the rest).
model CauseCode {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// No spaces ("STITCH-TENSION"); unique in the tenant. Never changes.
  code        String
  labelIt     String
  labelEn     String
  /// The words in the other floor languages of the tenant's sites (Site.floorLocales): { "ro": "…" }.
  labelI18n   Json         @default("{}")
  /// Never changes (reports group by it).
  process     CauseProcess
  /// Pickers show the list in this order (lower first).
  sortOrder   Int          @default(0)
  /// Retired codes leave the pickers and stay on what names them.
  active      Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  // quality.prisma, ncr.prisma: the inspection defects and the nonconformances that name it.
  inspectionDefects InspectionDefect[]
  nonconformances   Nonconformance[]

  @@unique([tenantId, code])
  // The target of the inspection defects' and NCRs' tenant-safe references.
  @@unique([tenantId, id])
}

/// What a disposition decides about the goods (QHS-005; design quality.defects "Disposition codes").
enum DispositionOutcome {
  /// Used as they are (never on a major or critical nonconformance, QHS-002).
  USE_AS_IS
  /// Made again by the factory (a rework order), then inspected again.
  REWORK
  REPAIR
  /// Kept as second quality.
  REGRADE
  /// Sent back to the supplier (a supplier claim and its return).
  RETURN_TO_SUPPLIER
  /// Moved to a quarantine place.
  QUARANTINE
  /// Scrapped (a scrap move).
  SCRAP
}

/// The record a disposition opens.
enum DispositionFollowUp {
  /// A rework order of the work order (rework.prisma, wave 5/7).
  REWORK_ORDER
  /// A repair (returns.prisma RepairOrder, or a work order of kind REPAIR).
  REPAIR_ORDER
  /// A supplier claim (claims.prisma SupplierClaim) and the goods' return.
  SUPPLIER_CLAIM
}

/// A disposition code (QHS-005): an outcome, the stock move it posts and the record it opens, and its approval rule. The
/// code, outcome, move and follow-up never change once written (decisions keep them); a code no longer used is set
/// inactive, and only a code no disposition line names is deleted.
model DispositionCode {
  id               String               @id @db.Uuid
  tenantId         String               @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// Upper-case letters, digits and underscores (factory-domain checks it); unique in the tenant.
  code             String
  labelIt          String
  labelEn          String
  labelI18n        Json                 @default("{}")
  icon             String?
  colour           String?
  outcome          DispositionOutcome
  /// The stock move a decision with it posts (the ledger's reasons: SCRAP, TRANSFER to a quarantine or second-quality
  /// place, ADJUSTMENT out for a return to the supplier); null: none (use as is, rework, repair).
  stockMoveReason  StockMoveReason?
  /// The record it opens; null: none.
  followUp         DispositionFollowUp?
  /// The garments are inspected again before they are released (rework, repair).
  reinspection     Boolean              @default(false)
  /// A decision with it needs a person's approval (four eyes: not who decided) when the NCR's severity is this class
  /// or worse; null: never by severity.
  approvalSeverity DefectClass?
  /// … or when the goods it decides are worth this much or more, in the company's currency (minor units; every company
  /// of a tenant shares it today); null: never by value.
  /// @grain cost
  approvalAmount   Int?
  sortOrder        Int                  @default(0)
  active           Boolean              @default(true)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  createdById      String?              @db.Uuid

  // ncr.prisma: the decisions made with it.
  dispositionLines NcrDispositionLine[]

  @@unique([tenantId, code])
  // The target of the disposition lines' tenant-safe reference.
  @@unique([tenantId, id])
}

/// ACTIVE → RELEASED | CLOSED; both final.
enum QualityHoldStatus {
  ACTIVE
  /// Released for use, signed by someone who made none of the goods.
  RELEASED
  /// Decided in its NCR (rejected, reworked, scrapped): the hold ends with the NCR's disposition.
  CLOSED
}

/// Where a hold stands on the hold board (W2b, B-W2b-79; QHS-077; design quality.holds "Hold board"): the next step a person
/// drags it to. Releasing and closing stay the hold's own status, never a lane.
enum HoldNextStep {
  NEW
  INVESTIGATING
  WAITING_DECISION
  READY_TO_RELEASE
}

/// The move of held stock to a quarantine place (QHS-078).
enum HoldQuarantine {
  /// Nothing to move (a work order, a serial, a shipment), or the stock stays where it is.
  NOT_NEEDED
  /// The move is asked (a floor task); the goods still lie where they were.
  ASKED
  /// The goods lie in the quarantine place (the floor confirmed the move).
  MOVED
}

/// A quality hold (QHS-074, MES-008; design quality.holds): goods of one site on hold, with why, by whom, until when
/// and the move to quarantine. ACTIVE → RELEASED | CLOSED; a released or closed hold never changes. Never deleted.
model QualityHold {
  id                     String            @id @db.Uuid
  tenantId               String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The site the goods are at, and its company.
  companyId              String            @db.Uuid
  siteId                 String            @db.Uuid
  /// W2b (schema wave 2/7; design quality.holds "Hold (HLD-0091, link)"): its number from the company's HOLD series
  /// (allocateNumber; a floor document kind, so the bench numbers the hold it places). Given once, when the hold is
  /// placed (or once later for a hold placed before the series existed, while it is ACTIVE), never changed, never blank
  /// (the …_followups_quality_money_w2b_guards trigger); null: placed before holds were numbered. B-W2b-F1: a NEW hold
  /// always has one (the …_followups_f1_w2b_guards trigger refuses an insert without it; the column stays nullable for
  /// the holds placed before).
  number                 String?
  /// What it holds: one record type (Lot, Hide, WorkOrder, Bundle, GarmentSerial, Shipment, Parcel) and one or more of
  /// its ids, distinct, every one a row of the hold's site (no foreign key: an array's elements cannot have one; the
  /// trigger checks them). Never changes: a hold of more goods is a new hold.
  subjectType            String
  subjectIds             String[]          @db.Uuid
  /// Why: a code of the HOLD reason list (reasons.prisma ReasonCode, kept as text), and words.
  reasonCode             String
  reasonNote             String?
  /// The record that caused it (Inspection, Nonconformance, LabResult, Certificate, QualityReleaseReversal, Complaint):
  /// its type and id, both or neither; neither: placed by hand.
  sourceType             String?
  sourceId               String?           @db.Uuid
  status                 QualityHoldStatus @default(ACTIVE)
  /// Who placed it: an office user or a floor worker of the site (at the bench), at most one; neither: the system (a
  /// failed inspection, a Cr VI fail, a certificate suspended or expired, a reversed release).
  placedAt               DateTime          @db.Timestamptz(3)
  placedById             String?           @db.Uuid
  placedByWorkerId       String?           @db.Uuid
  /// The office user who follows it up, and when it is expected to be released.
  ownerId                String?           @db.Uuid
  expectedReleaseOn      DateTime?         @db.Date
  /// The move to quarantine: asked, then done (with when, and the place: a QUARANTINE location of the site).
  quarantine             HoldQuarantine    @default(NOT_NEEDED)
  quarantineLocationId   String?           @db.Uuid
  quarantineMovedAt      DateTime?         @db.Timestamptz(3)
  /// The NCR that decides the goods (rejection, rework, scrap): set once, while ACTIVE; a CLOSED hold has it.
  ncrId                  String?           @db.Uuid
  /// RELEASED: when, by whom (an office user, or a floor worker with the PIN: exactly one), the conditions as checked in
  /// words, and the SHA-256 (hex) of what they signed (the e-signature); the releaser made none of the held garments.
  releasedAt             DateTime?         @db.Timestamptz(3)
  releasedById           String?           @db.Uuid
  releasedByWorkerId     String?           @db.Uuid
  releaseNote            String?
  releaseSignatureSha256 String?
  /// The releaser's signed statement that they made none of the garments: required where the floor records do not name
  /// every maker (the site records the station, MES-278), as for a final inspection.
  notMakerStatement      Boolean           @default(false)
  /// CLOSED: when, by whom, and why (the NCR's disposition).
  closedAt               DateTime?         @db.Timestamptz(3)
  closedById             String?           @db.Uuid
  closeNote              String?
  note                   String?
  /// W2b (B-W2b-79; QHS-075): the hold by genealogy it is part of, of the same company. Set when it is placed, or once
  /// later while it is ACTIVE; never changed or cleared (the …_quality_problems_w2b_guards trigger).
  groupId                String?           @db.Uuid
  /// W2b (B-W2b-79; QHS-077): its lane on the hold board, set by the office while the hold is ACTIVE (W2a's guard freezes a
  /// released or closed hold). Office only: the floor neither reads nor writes it (ownership/holds.json hides it). The
  /// default is the database's (dbgenerated, as tenantId's), so a hold placed at the bench names no lane: Prisma would
  /// send a plain @default(NEW) itself, and the floor has no grant on the column. A new hold is NEW. Written as a cast from text:
  /// Prisma reads a bare 'NEW'::"HoldNextStep" back as @default(NEW) and the replay would never match.
  nextStep               HoldNextStep      @default(dbgenerated("('NEW'::text)::\"HoldNextStep\""))
  version                Int               @default(1)
  createdAt              DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  createdById            String?           @db.Uuid

  site               Site            @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and siteId.
  placedByWorker     Worker?         @relation("QualityHoldPlacedBy", fields: [tenantId, siteId, placedByWorkerId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  releasedByWorker   Worker?         @relation("QualityHoldReleasedBy", fields: [tenantId, siteId, releasedByWorkerId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  quarantineLocation Location?       @relation(fields: [tenantId, siteId, quarantineLocationId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  ncr                Nonconformance? @relation(fields: [tenantId, siteId, ncrId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (B-W2b-79): Restrict, as above: SetNull would also clear tenantId and companyId.
  group              QualityHoldGroup? @relation(fields: [tenantId, companyId, groupId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, ncrId])
  @@index([tenantId, groupId])
  // W2b: one hold per number in the tenant (NULLs, the holds placed before numbering, do not clash).
  @@unique([tenantId, number])
  // What is on hold: the guards' and the API's lookup of the ACTIVE holds of a record.
  @@index([subjectIds(ops: ArrayOps)], type: Gin)
}

/// One hold by genealogy (W2b, B-W2b-79; QHS-075; design quality.holds "Hold by genealogy"): the suspect record it starts
/// from, why, who decided it and when, and the counts the person saw. The goods themselves are its QualityHold rows, one
/// per kind of record and site, which block and release as any hold; "Extend hold" adds rows and moves the counts. Only
/// the counts change. Never deleted. Numbers its holds, not itself.
model QualityHoldGroup {
  id          String   @id @db.Uuid
  tenantId    String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// A company, not a site: what was made from a lot can lie at several of its sites.
  companyId   String   @db.Uuid
  /// The suspect record it starts from (Lot, Hide, a protector lot): its type and id.
  sourceType  String
  sourceId    String   @db.Uuid
  /// Why: a code of the HOLD reason list (reasons.prisma ReasonCode, kept as text), and words.
  reasonCode  String
  reasonNote  String?
  /// What it reached: { "<what>": <whole number from 0> } ({ "WorkOrder": 4, "garments": 126, "shippedGarments": 18,
  /// "customers": 2 }), as the tree of factory-domain counts them; shipped goods are counted, never held here.
  counts      Json     @default("{}")
  placedAt    DateTime @db.Timestamptz(3)
  /// The office user who placed it; null: the system.
  placedById  String?  @db.Uuid
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  company Company       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  holds   QualityHold[]

  // The target of the holds' reference: a hold of the same company.
  @@unique([tenantId, companyId, id])
  // Which genealogy holds a suspect record started.
  @@index([tenantId, sourceType, sourceId])
}
