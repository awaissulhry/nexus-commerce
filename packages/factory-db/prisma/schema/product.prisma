// Product (plan A1 §2.4 B; features PRD-001, PRD-002, PRD-004, PRD-005, PRD-022, PRD-024, PRD-025, PRD-028, PRD-030,
// PRD-032, PRD-043, PRD-047, PRD-048, PRD-076, PRD-079, PRD-082, PRD-100, PRD-109, PRD-110, PRD-200, PRD-270, PRD-288,
// GAP-006): the material library with its units and colours, the colour library, size scales, styles with their
// colourways and colour x size SKU matrix, the BOM and routing of each style revision, the operation library and the
// made-to-measure templates. apps/factory-api's modules/product writes them (B-W1-09, 11, 13, 14, 17), always through
// command().
//
// Master data is tenant-wide (companyId null) or of one company (A1 §2.1, PRD-002). It carries no siteId: a site key
// would make the floor role see only its own site's rows; the site comes with the work order that makes the style, and
// a routing operation names the KIND of work centre, which the work order maps to one of its site's work centres.
//
// Units (PRD-030): a closed list (enum Uom). The fixed factors inside one dimension (1 ft² = 0.09290304 m²,
// 1 dm² = 0.01 m²) are factory-domain constants, the same for every tenant; an item's own conversions (a hide's average
// area, a roll's length) are its purchase and consumption factors.
//
// Sizes inside a style are named by their CODE (Style.sizes, Variant.size, BomLineSize.size), as the sales, stock and
// production rows of A1 do; a code of a scale never changes once used (the product module refuses it).
//
// Revisions (A1 §2.5): a style's BOM, routing and label template belong to a StyleRevision: DRAFT (edited) → RELEASED
// (frozen; work orders made from it point at it) → OBSOLETE (replaced). The hand-written …_product_guards migration's
// triggers refuse, for every login, any change to a released or obsolete revision other than RELEASED → OBSOLETE, and
// any insert, change or removal of its BOM lines, size quantities, colour grid cells and routing operations. A change
// to a released style is a new revision (the product module copies the released one into a new DRAFT). A style's
// current revision is its RELEASED one, and it has at most one (a partial unique index of …_product_guards, which
// Prisma cannot express): a release obsoletes the previous revision first, then releases the new one, in one command.
// W2b-4 (wave 25/33, instructions.prisma): a routing step's extra minutes per size and machine settings are parts of the
// revision under the same rule; a revision's effective days (effectiveFrom, effectiveTo) are fixed once released.
// W2b-4 (wave 27/33, sizes-depth.prisma): a revision's measurement spec with its values and its protector placement are
// parts of the revision under the same rule.
//
// Who sees what (ownership/product.json): the office reads and writes; the floor reads the styles, materials (never a
// cost), BOMs and routings it works from; portal and link sessions read none of it. Master data in use is archived
// (status ARCHIVED), never deleted (PRD-022; PPE Regulation 2016/425 art. 8(3): technical documentation kept 10 years).
//
// Uniqueness of a cell of two references (a BOM line's colour in one colourway) is the product module's: a unique key of
// ids alone cannot be copied by the generated isolation tests (src/isolation.pg.vitest.test.ts), as for WorkerRole.
//
// W2b-4 (wave 28/33, options.prisma): a BOM line's section, group row, sub-assembly (a revision of another style, never in
// a circle, RELEASED when its parent is released), customer-supplied material, workshop kit, source rule and option, and a
// revision's output quantity; a line's alternates are parts of the revision under the same rule.

/// A colour of the tenant's colour library (PRD-032, PRD-004): the reference our material colours and colourways use.
model Colour {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data, shared by every company of the tenant (A1 §2.1).
  companyId   String?      @db.Uuid
  /// Our colour reference, unique in the tenant ("BLK", "RED-01").
  code        String
  name        String
  /// The name per locale: { "it": "Nero", "en": "Black" }.
  nameI18n    Json?
  /// For screens and swatches: "#RRGGBB".
  hex         String?
  /// W2b-4 (schema wave 26/33, B-W2b-206; PRD-041): the colour system its reference is in (PANTONE, RAL, NCS, or OWN: our
  /// own swatch; null: not said); the reference in it ("19-4052 TCX", "RAL 9005", "S 9000-N"; 1 to 40 characters),
  /// required for PANTONE, RAL and NCS, never without a system; the family it is filed under for filters ("black",
  /// "blue"; 1 to 40 characters; null: none).
  system      ColourSystem?
  reference   String?
  family      String?
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  company     Company?     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  itemColours ItemColour[]
  colourways  Colourway[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from material colours and colourways.
  @@unique([tenantId, id])
}

/// A material, component or trim of the library (PRD-028): a leather article, a textile, a lining or membrane, thread,
/// a trim or hardware, a label, a protector, packaging, or a part we make (PRD-024). BOM lines name it; purchase orders,
/// lots and stock (W1-15) will too.
model Item {
  id                  String       @id @db.Uuid
  tenantId            String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data (A1 §2.1).
  companyId           String?      @db.Uuid
  /// Our article code, unique in the tenant.
  code                String
  name                String
  /// The name per locale: { "it": "…", "en": "…" }.
  nameI18n            Json?
  kind                ItemKind
  /// Bought, made, or either (PRD-024): MAKE needs a BOM and routing, BUY a supplier.
  sourcing            ItemSourcing @default(BUY)
  /// How its stock is traced (PRD-025): hides one by one, dye lots, or a serial per unit.
  tracking            ItemTracking @default(NONE)
  /// The stock unit (PRD-030): stock, lots and the standard cost count in it.
  baseUom             Uom
  /// The unit it is bought in, and how many base units one of it holds: 1 when it is the base unit; the fixed factor
  /// when both are of one dimension (FT2 → M2); the article's average for a unit of its own (1 HIDE = 52.5 FT2).
  purchaseUom         Uom
  purchaseFactor      Decimal      @default(1) @db.Decimal(18, 8)
  /// The unit BOM lines use (leather is bought in square feet and cut in dm²), and how many base units one of it holds.
  consumptionUom      Uom
  consumptionFactor   Decimal      @default(1) @db.Decimal(18, 8)
  /// The supplier we buy it from by default (a party with the SUPPLIER role; the product module checks the role).
  defaultSupplierId   String?      @db.Uuid
  /// That supplier's article code.
  supplierArticleCode String?
  /// The default supplier's terms (PLN-066; planning's suggestion and order-by date): calendar days from the order to
  /// the goods at the site, 0 or more; the least it sells and the steps it sells in, both above 0, in `purchaseUom`.
  /// null: none on record (planning orders by the need date and rounds only to whole units).
  leadTimeDays        Int?
  minOrderQty         Decimal?     @db.Decimal(18, 4)
  orderMultiple       Decimal?     @db.Decimal(18, 4)
  /// W2b (wave 12/16, SCM-263): a consumable counted by the pack (thread by the cone, needles by the box): how many base
  /// units one pack holds, above 0, and what the pack is, both or neither. Its minimum and maximum per site are ItemPlanning's
  /// method MIN_MAX.
  packSize            Decimal?     @db.Decimal(18, 4)
  packUom             Uom?
  /// The standard purchase price per base unit, typed by the office (GAP-006): quotes and the cost sheet use it until
  /// supplier price lists come (W2a). Never shown to the floor, a portal or a link.
  /// @grain cost
  standardCost        Decimal?     @db.Decimal(18, 6)
  /// The currency of the standard cost, ISO 4217.
  currency            String       @default("EUR")
  /// W2a (GAP-003): the SKU a FINISHED item is (exactly for that kind): one item per SKU, set when it is made and never
  /// changed; its unit is PCS. Production receipts put the work order's finished garments into stock as this item.
  variantId           String?      @db.Uuid
  /// Leather: the animal ("bovine", "goat", "kangaroo"), for the user information and the supplier documents.
  animalSpecies       String?
  /// Leather: how it was tanned; chrome tanning is why Cr VI is tested (REACH Annex XVII entry 47).
  tannage             Tannage?
  /// Leather: the tannery's selection or grade ("A", "TR1").
  grade               String?
  /// Leather: the finish (full grain, corrected grain, nubuck, aniline …).
  finish              String?
  /// Leather and textiles: the thickness range in millimetres.
  thicknessMinMm      Decimal?     @db.Decimal(6, 2)
  thicknessMaxMm      Decimal?     @db.Decimal(6, 2)
  /// Textiles: the fibre composition (Reg. (EU) 1007/2011), percentages as decimal strings (no floats):
  /// [{ "fibre": "polyamide", "percent": "100" }]. The garment label is typed from these (B-W1-19).
  composition         Json?
  /// Has non-textile parts of animal origin (leather, fur): the garment label then carries the phrase of Reg. (EU)
  /// 1007/2011 art. 12.
  animalOrigin        Boolean      @default(false)
  /// Other attributes of its kind, for screens and supplier documents: { "<name>": "<value>" }.
  attributes          Json?
  /// W2b-4 (schema wave 26/33, B-W2b-206; PRD-029): the properties of its kind, typed (decimals as strings; the
  /// …_styles_libraries_w2b_guards trigger): TEXTILE, LINING, MEMBRANE, PADDING { "weightGsm", "widthCm" (decimals above
  /// 0), "construction" }; PROTECTOR { "standard" ("EN 1621-1:2012"), "type" ("shoulder"), "level" ("1" | "2"), "size" };
  /// TRIM, HARDWARE { "material", "finish", "size", "nickelFree" (true | false) }; texts 1 to 100 characters. Other kinds
  /// have none (leather's are the columns above; anything else is an attribute). null: none.
  properties          Json?
  /// W2b-4 (PRD-035): its approval for use: PENDING (in development; the default), APPROVED, CONDITIONAL (approved on the
  /// condition in approvalNote) or BLOCKED (refused on a BOM line, and a revision whose BOM names it is not released).
  /// approvedAt: when it was decided, set exactly when not PENDING; approvedById: who decided, with every decision since
  /// W2b-4 (a material of a released BOM before it was approved by that release: its first release's time and releaser);
  /// both change only with the approval. approvalNote: why, required for CONDITIONAL and BLOCKED, up to 1000 characters.
  approval            MaterialApproval @default(PENDING)
  approvedAt          DateTime?        @db.Timestamptz(3)
  approvedById        String?          @db.Uuid
  approvalNote        String?
  /// A component that is itself PPE or part of the protection (an EN 1621 protector): a certificate covers it, and a
  /// substitute needs the notified body's consent.
  isPpeComponent      Boolean      @default(false)
  /// Every lot needs Cr VI evidence before it is released (REACH Annex XVII entry 47: leather articles in contact with
  /// the skin). What counts as evidence is a setting (B-W1-34, Q14).
  requiresCrViTest    Boolean      @default(false)
  /// The Cr VI limit a lot must stay below, mg/kg: the legal 3, or a brand's lower one. Set exactly when a test is
  /// required; never above 3 (the …_product_guards trigger).
  crViLimitMgKg       Decimal?     @db.Decimal(8, 3)
  status              MasterStatus @default(ACTIVE)
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById         String?      @db.Uuid

  company         Company?              @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  defaultSupplier Party?                @relation(fields: [tenantId, defaultSupplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2a: the SKU a FINISHED item is (Restrict, not Prisma's SetNull default for an optional relation: that would also
  // clear tenantId).
  variant         Variant?              @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  colours         ItemColour[]
  bomLines        BomLine[]
  // compliance.prisma: the certificates that cover it (a protector's EN 1621 certificate).
  coverage        CertificateCoverage[]
  // W2b-4 recall.prisma (wave 33/33): the sustainability claims about it.
  sustainabilityClaims SustainabilityClaim[] @relation("SustainabilityClaimItem")
  // W2b-4 sizes-depth.prisma (wave 27/33): the pockets of style revisions it goes in (a PROTECTOR).
  protectorPlacements ProtectorPlacement[]
  // W2b leather.prisma (wave 12/16): what each grade means for it, and its shade groups.
  gradeRules      ItemGradeRule[]
  shadeGroups     ShadeGroup[]
  // W2b-4 options.prisma (wave 28/33): the BOM lines it is an alternate on, and the option effects that add or put it in,
  // or replace or leave it out.
  bomLineAlternates   BomLineAlternate[] @relation("BomLineAlternateItem")
  optionEffects       OptionEffect[]     @relation("OptionEffectItem")
  optionEffectTargets OptionEffect[]     @relation("OptionEffectTargetItem")
  // W2b-4 samples.prisma (wave 29/33): the swatches of it sent to brands.
  sampleSwatches  SampleSwatch[]
  // W2b-4 substances.prisma (wave 31/33): its compliance profile, what suppliers declared of it, its own test plan rules.
  complianceProfiles      MaterialComplianceProfile[]
  supplierDeclarationLines SupplierDeclarationLine[]
  testPlanRules           TestPlanRule[]
  // W2b-2 cutting.prisma (wave 13/16): the cut orders that cut it, and the downgrades that keep garments as it (second quality).
  cutOrders       CutOrder[]
  secondQualityDowngrades GarmentDowngrade[] @relation("GarmentDowngradeItem")
  // supply.prisma: the purchase order lines that buy it and the planning runs' requirements of it.
  purchaseOrderLines   PurchaseOrderLine[]
  // W2b (wave 22/22): the purchase order lines whose supplier proposes it as a substitute.
  substituteProposals  PurchaseOrderLine[] @relation("PurchaseOrderLineSubstitute")
  materialRequirements MaterialRequirement[]
  // W2a cost-ledger.prisma (wave 7/7): its frozen standard costs, and the work-order cost entries that name it.
  /// @not-money the relation to its standard costs (the rows carry the grain)
  standardCosts        StandardCost[]
  /// @not-money the relation to the cost ledger (the rows carry the grain)
  costEntries          WorkOrderCostEntry[]
  // W2a reservations.prisma, stockcount.prisma, planning.prisma: its reservations, the counts of it (whole, or a line),
  // its planning parameters per site and the planning exceptions about it.
  reservations         Reservation[]
  stockCounts          StockCount[]
  stockCountLines      StockCountLine[]
  itemPlannings        ItemPlanning[]
  planningExceptions   PlanningException[]
  // W2b-5 warehouse-depth.prisma (wave 36/44): the transfer lines and warehouse tasks of it, the substitutions that use it.
  transferLines        TransferLine[]
  warehouseTasks       WarehouseTask[]
  substitutionsTo      MaterialSubstitution[] @relation("MaterialSubstitutionTo")
  // W2a ncr.prisma: the nonconformances about it (a material).
  nonconformances      Nonconformance[]
  // inventory.prisma: its receipt lines, lots, stock moves and their values.
  goodsReceiptLines    GoodsReceiptLine[]
  lots                 Lot[]
  stockMoves           StockMove[]
  stockValuations      StockValuation[]
  // W2b-5 sales-orders-depth.prisma (wave 39/44): the customers' materials of it expected for their orders.
  customerMaterials    CustomerMaterial[]
  // W2a sourcing.prisma, claims.prisma, subcontract.prisma: its approved sources, claim lines and kit lines.
  supplierItems        SupplierItem[]
  supplierClaimLines   SupplierClaimLine[]
  subcontractKitLines  SubcontractKitLine[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from BOM lines and the item's colours.
  @@unique([tenantId, id])
  // W2a: one finished-goods item per SKU.
  @@unique([tenantId, variantId])
}

enum ItemKind {
  LEATHER
  TEXTILE
  LINING
  MEMBRANE
  PADDING
  THREAD
  /// Zips, snaps, hook-and-loop, buckles.
  TRIM
  HARDWARE
  /// Impact protectors (EN 1621-1, -2) and their pockets' inserts.
  PROTECTOR
  LABEL
  PACKAGING
  /// A part we make (a pre-assembled panel): sourcing MAKE.
  COMPONENT
  /// W2a (GAP-003): a finished garment of one SKU (Item.variantId), counted in pieces: what production receipts put
  /// into finished-goods stock. Not a material: the materials library leaves it out.
  FINISHED
}

enum ItemSourcing {
  BUY
  MAKE
  MAKE_OR_BUY
}

enum ItemTracking {
  NONE
  /// By lot: dye lots, protectors, thread.
  LOT
  /// Hide by hide: each hide has its own code, area and grade (W1-15).
  HIDE
  /// One serial per unit (finished PPE garments, PPE art. 8(5)).
  SERIAL
}

enum Tannage {
  CHROME
  VEGETABLE
  CHROME_FREE
  COMBINATION
}

/// A unit of measure (PRD-030). Within a dimension the factors are fixed (factory-domain units); HIDE, SIDE, ROLL,
/// CONE and BOX hold what the item says (its purchase or consumption factor). New units are added, never renamed.
enum Uom {
  /// A piece.
  PCS
  PAIR
  SET
  M
  CM
  MM
  M2
  DM2
  /// A square foot (0.09290304 m²).
  FT2
  KG
  G
  L
  /// A whole hide or skin.
  HIDE
  /// Half a hide.
  SIDE
  ROLL
  CONE
  BOX
}

/// A material in one of its colours (PRD-032): what a BOM line resolves to, so the right colour is bought.
model ItemColour {
  id                 String       @id @db.Uuid
  tenantId           String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  itemId             String       @db.Uuid
  /// Our reference for the material in this colour, unique per material.
  code               String
  name               String
  /// The library colour it matches, when there is one.
  colourId           String?      @db.Uuid
  /// The supplier's colour code, as it goes on a purchase order.
  supplierColourCode String?
  status             MasterStatus @default(ACTIVE)
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?      @db.Uuid

  item           Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  colour         Colour?         @relation(fields: [tenantId, colourId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  bomLines       BomLine[]
  bomLineColours BomLineColour[]
  // supply.prisma: the purchase order lines and requirements in this colour.
  purchaseOrderLines   PurchaseOrderLine[]
  materialRequirements MaterialRequirement[]
  // W2a reservations.prisma, stockcount.prisma, planning.prisma: the same, of this colour.
  reservations         Reservation[]
  stockCountLines      StockCountLine[]
  itemPlannings        ItemPlanning[]
  planningExceptions   PlanningException[]
  // W2b-5 warehouse-depth.prisma (wave 36/44): the same, of this colour.
  transferLines        TransferLine[]
  warehouseTasks       WarehouseTask[]
  substitutionsTo      MaterialSubstitution[] @relation("MaterialSubstitutionTo")
  // inventory.prisma: its receipt lines, lots and stock moves.
  goodsReceiptLines    GoodsReceiptLine[]
  lots                 Lot[]
  stockMoves           StockMove[]
  // W2b-5 sales-orders-depth.prisma (wave 39/44): the customers' materials expected in this colour.
  customerMaterials    CustomerMaterial[]
  // production.prisma: the work orders' planned materials in this colour.
  workOrderMaterials   WorkOrderMaterial[]
  // W2a sourcing.prisma, claims.prisma, subcontract.prisma: its approved sources, claim lines and kit lines.
  supplierItems        SupplierItem[]
  // W2b leather.prisma (wave 12/16): the shade groups of this colour.
  shadeGroups          ShadeGroup[]
  // W2b-4 samples.prisma (wave 29/33): the swatches of this colour sent to brands.
  sampleSwatches       SampleSwatch[]
  // W2b-2 cutting.prisma (wave 13/16): the cut orders that cut the material in this colour.
  cutOrders            CutOrder[]
  // W2b-4 options.prisma (wave 28/33): the alternates and option effects in this colour.
  bomLineAlternates    BomLineAlternate[] @relation("BomLineAlternateItemColour")
  optionEffects        OptionEffect[]     @relation("OptionEffectItemColour")
  supplierClaimLines   SupplierClaimLine[]
  subcontractKitLines  SubcontractKitLine[]

  @@unique([tenantId, itemId, code])
  // The target of the references from BOM lines and grid cells: a colour of the line's own material.
  @@unique([tenantId, itemId, id])
}

/// A size scale of the library (PRD-047): EU 44-64, S-4XL, gloves 7-13, women 38-50. Reused by many styles.
model SizeScale {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data (A1 §2.1).
  companyId   String?      @db.Uuid
  code        String
  name        String
  /// W2b-4 (B-W2b-210; PRD-049): 1, or 2 for size and fit ("52 Long"): then every size of the scale is one size in one
  /// fit (code "52L", fitCode "L"), so a size is still one code everywhere. Changes only while the scale has no size.
  dimensions  Int          @default(1)
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sizes   Size[]
  // W2b-4 sizes-depth.prisma (wave 27/33): its grade rules and prepacks.
  gradeRules GradeRule[]
  prepacks   Prepack[]
  styles  Style[]
  // W2b-4 styles-depth.prisma (wave 26/33): the product types whose default scale it is.
  productTypeProfiles ProductTypeProfile[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// One size of a scale, in the scale's order.
model Size {
  id           String       @id @db.Uuid
  tenantId     String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  scaleId      String       @db.Uuid
  /// The size code, unique in the scale and never changed once used: styles, SKUs, BOM quantities, orders and work
  /// orders name the size by it.
  code         String
  /// How it is shown, when not the code ("52 (L)").
  label        String?
  /// Its place in the scale, from small to large.
  seq          Int
  /// The body measures the size is for, as the PPE label shows them (EN 17092 size pictogram) and against which a
  /// made-to-measure rider's measures are checked (PRD-288); keys are measurement point codes, values decimal strings:
  /// { "chest": { "min": "100", "max": "104", "unit": "cm" }, "height": { "min": "176", "max": "182", "unit": "cm" } }.
  bodyMeasures Json?
  /// W2b-4 (B-W2b-210; PRD-049): the fit of the size on a two-dimension scale ("S", "R", "L": 1-10 letters or digits),
  /// set exactly when its scale has two dimensions.
  fitCode      String?
  status       MasterStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?      @db.Uuid

  scale SizeScale @relation(fields: [tenantId, scaleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, scaleId, code])
}

/// A style (model) we make (PRD-001): the parent of its colourways, SKUs, revisions (BOM, routing, label), certificates
/// and orders. DRAFT → ACTIVE (it has a released revision, it can be sold) → ARCHIVED (never deleted, PRD-022).
model Style {
  id                    String      @id @db.Uuid
  tenantId              String      @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company that owns it; null: tenant-wide, made by every company (A1 §2.1, PRD-002).
  companyId             String?     @db.Uuid
  /// The style code, unique in the tenant; SKUs start with it.
  code                  String
  name                  String
  /// The name per locale.
  nameI18n              Json?
  description           String?
  productType           ProductType
  /// The season or collection ("FW27"), as the office writes it.
  season                String?
  /// The brand it is made for (private label); null: our own collection. With a brand label, the brand is the legal PPE
  /// maker (PLAN §2.8). W2b-4 (B-W2b-206): this is PRD-010's private-label customer (only its partner users see the style
  /// in the portal: the catalogue reads it since B-W2b-190); soldUnderOurName says whose name it is sold under.
  brandPartyId          String?     @db.Uuid
  /// W2b-4 (schema wave 26/33, B-W2b-206; Owner 11-09, question 3): a private-label style the brand sells under OUR name
  /// and mark (an exclusive design, not its own label): we stay the legal maker and the sender of its public DoC. false
  /// (the default): the brand sells it under its own name or mark (PPE Reg. (EU) 2016/425 art. 12: the brand is the
  /// manufacturer) and is the DoC page's sender. Never true without a brand.
  soldUnderOurName      Boolean     @default(false)
  /// W2b-4 (B-W2b-206; PRD-008): its product type (of its product type's kind of garment, of its company or tenant-wide);
  /// null: none.
  productTypeProfileId  String?     @db.Uuid
  sizeScaleId           String      @db.Uuid
  /// The size range (PRD-048): codes of the scale's sizes, in the scale's order. The SKU matrix is built from it.
  sizes                 String[]    @default([])
  /// The base (sample) size grading works from; one of `sizes`.
  baseSize              String?
  /// Its PPE classification (PRD-270; Reg. (EU) 2016/425 art. 18, Annex I): rider garments with impact protectors or
  /// abrasion protection are Category II; a climate-only garment for private use is not PPE.
  ppeCategory           PpeCategory
  /// The harmonised standard it is made to, with its edition ("EN 17092-4:2020"); null when not PPE.
  ppeStandard           String?
  /// The class it is made for (EN 17092: AAA, AA, A, B, C); the certificate that covers it says what it has.
  ppeClass              String?
  /// Made-to-measure single units may be made from it (PRD-288: inside the certified range of its basic model).
  mtmAllowed            Boolean     @default(false)
  /// How its garments are traced (Q31, quality.prisma): one batch number per work order (BATCH, the default) or also a
  /// serial per garment (SERIAL). Changes only while none of its work orders has a serial or a quality release.
  garmentTracking       GarmentTracking @default(BATCH)
  /// The measurement template a made-to-measure unit is measured with (PRD-200).
  measurementTemplateId String?     @db.Uuid
  /// W2a customs and origin data (PRD-018; exports and Intrastat, Reg. (EU) 2019/2152): the commodity code (HS 6,
  /// CN 8 or TARIC 10 digits), the country of origin (ISO 3166-1 alpha-2) and the net mass of one garment in kilograms
  /// (above 0); null: not on record.
  hsCode                String?
  originCountry         String?
  netMassKg             Decimal?    @db.Decimal(10, 3)
  /// W2b (B-W2b-03; design style identity "Customs: HS code, origin, gender"): who it is cut for, apart from the CN
  /// code (CN chapters 61/62 split men's or boys' from women's or girls'); null: not on record.
  gender                StyleGender?
  /// W2b (B-W2b-03; B-W2a-09's copy): the style it was copied from and that style's revision the copy took its parts
  /// from (the "Copied from" line); null: not a copy, or copied before W2b (the audit rows say it then). Never itself;
  /// the revision only with its style; set once, when the copy is made (or filled in later from the audit), never
  /// changed.
  copiedFromStyleId     String?     @db.Uuid
  copiedFromRevisionId  String?     @db.Uuid
  /// W2b-4 (schema wave 26/33, B-W2b-206; PRD-007): where it is in its life, beside its record state `status` (which every
  /// W1 path reads): CONCEPT → DEVELOPMENT → SAMPLING → APPROVED → IN_PRODUCTION → PHASE_OUT → DISCONTINUED, one command
  /// per move (B-W2b-221; the database keeps IN_PRODUCTION for a style with a RELEASED revision). Styles made before it:
  /// ARCHIVED → DISCONTINUED, with a released revision → IN_PRODUCTION, else DEVELOPMENT. When and by whom it last moved:
  /// both change only with it (the time is the transaction's when the writer leaves it); null: not moved since W2b-4.
  lifecycle             StyleLifecycle @default(CONCEPT)
  lifecycleChangedAt    DateTime?   @db.Timestamptz(3)
  lifecycleChangedById  String?     @db.Uuid
  /// W2b-4 (B-W2b-206; B-W2b-190's need): the style that replaces it, only while PHASE_OUT or DISCONTINUED; never itself.
  replacedById          String?     @db.Uuid
  /// W2b-5 (schema wave 34/44, B-W2b-275; the B-W2b-254 and -266 notes): the markets it is sold in, by the code of a
  /// MarketProfile of the tenant (compliance-rules.prisma; "DE", "UK"), each once, at most 60; empty (the default): every
  /// market, as before. The requirements gate and the status board read it (B-W2b-283, -288): a market it is not sold in
  /// says "Not sold there", not a gap. A code is checked against the tenant's markets when it is written (an archived or
  /// switched-off market stays named).
  marketCodes           String[]    @default([])
  status                StyleStatus @default(DRAFT)
  version               Int         @default(1)
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  createdById           String?     @db.Uuid

  company             Company?              @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  brandParty          Party?                @relation(fields: [tenantId, brandPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sizeScale           SizeScale             @relation(fields: [tenantId, sizeScaleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  measurementTemplate MeasurementTemplate?  @relation(fields: [tenantId, measurementTemplateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b: the style and revision it was copied from, and the copies made of it (Restrict, not Prisma's SetNull default
  // for an optional relation: that would also clear tenantId).
  copiedFrom          Style?                @relation("StyleCopiedFrom", fields: [tenantId, copiedFromStyleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  copiedFromRevision  StyleRevision?        @relation("StyleCopiedFromRevision", fields: [tenantId, copiedFromStyleId, copiedFromRevisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  copies              Style[]               @relation("StyleCopiedFrom")
  // W2b-4 options.prisma (wave 28/33): the option groups it offers.
  optionGroups        StyleOptionGroup[]
  // W2b-4 styles-depth.prisma (wave 26/33): the style that replaces it and those it replaces, its product type, its names
  // per language and its pictures (Restrict, not Prisma's SetNull default: that would also clear tenantId).
  replacedBy          Style?                @relation("StyleReplacedBy", fields: [tenantId, replacedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  replaces            Style[]               @relation("StyleReplacedBy")
  productTypeProfile  ProductTypeProfile?   @relation(fields: [tenantId, productTypeProfileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  texts               StyleText[]
  images              StyleImage[]
  colourways          Colourway[]
  revisions           StyleRevision[]
  // W2b-4 sizes-depth.prisma (wave 27/33): its own prepacks.
  prepacks            Prepack[]
  // compliance.prisma: what covers and documents it.
  coverage            CertificateCoverage[]
  labelTemplates      LabelTemplate[]
  complianceDocuments ComplianceDocument[]
  // sales.prisma: its quote and sales order lines.
  quoteLines          QuoteLine[]
  salesOrderLines     SalesOrderLine[]
  // W2b portal-sales.prisma (wave 21/22): the portal order request lines that ask for it.
  portalRequestLines  PortalOrderRequestLine[] @relation("PortalOrderRequestLineStyle")
  // production.prisma: the work orders that make it.
  workOrders          WorkOrder[]
  // W2b pay.prisma (schema wave 6/7): the piece-rate tables of its own.
  pieceRateTables     PieceRateTable[]
  // quality.prisma: the PPE register's entries about it.
  ppeRegisterEntries  PpeRegisterEntry[]
  // W2b-4 recall.prisma (wave 33/33): its recalls and withdrawals, the authority requests about it, its sustainability
  // claims.
  recallActions        RecallAction[]
  authorityRequests    AuthorityRequest[]    @relation("AuthorityRequestStyle")
  sustainabilityClaims SustainabilityClaim[] @relation("SustainabilityClaimStyle")
  // W2a ncr.prisma: the nonconformances about it.
  nonconformances     Nonconformance[]
  // W2b inspection-plans.prisma (wave 10/16): the AQL profiles assigned to it.
  aqlProfileAssignments AqlProfileAssignment[]
  // pricing.prisma, returns.prisma, complaints.prisma: its prices in price lists, its repairs and complaints.
  /// @not-money the relation to its price list entries
  priceListEntries    PriceListEntry[]
  repairOrders        RepairOrder[]
  complaints          Complaint[]
  // W2a compliance.prisma: the changes to its approved type under review.
  typeChangeReviews   TypeChangeReview[]
  // W2b-4 changes.prisma and samples.prisma (wave 29/33): its change requests and orders, sample rounds and swatches.
  changeRequests      ChangeRequest[]
  changeOrders        ChangeOrder[]
  sampleRounds        SampleRound[]
  sampleSwatches      SampleSwatch[]
  // W2b-4 compliance-rules.prisma (wave 30/33): its own economic operators and the gate events about it.
  economicOperatorRoles EconomicOperatorRole[]
  gateEvents          GateEvent[]
  // W2b-4 techfiles.prisma (wave 32/33): the batches its declarations went with, its technical files and production-control
  // tests.
  complianceDocumentBatches ComplianceDocumentBatch[]
  technicalFiles            TechnicalFile[]
  productionControlTests    ProductionControlTest[]
  // W2b plantcare.prisma (wave 14/16): the clicking dies that cut it.
  clickingDies        ClickingDie[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from the style's rows.
  @@unique([tenantId, id])
}

enum StyleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Who a style is cut for (W2b; customs: CN chapters 61/62, Note 9: a garment that is neither is classified as women's
/// or girls').
enum StyleGender {
  /// Men's or boys'.
  MEN
  /// Women's or girls'.
  WOMEN
  /// Cut for both (classified as women's or girls' for customs).
  UNISEX
}

/// The kind of garment: it decides the measurement template and, with the protection, the PPE classification.
enum ProductType {
  JACKET
  TROUSERS
  /// A one-piece or two-piece race suit.
  SUIT
  GLOVES
  VEST
  OTHER
}

/// PPE category (Reg. (EU) 2016/425 Annex I).
enum PpeCategory {
  NOT_PPE
  CATEGORY_I
  CATEGORY_II
  CATEGORY_III
}

/// A colour variant of a style (PRD-004): main leather colour, contrast panels, stitching and logos. Orders, BOM colours
/// and stock are per colourway.
model Colourway {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId     String       @db.Uuid
  /// The colourway code, unique in the style; SKUs carry it.
  code        String
  name        String
  /// The library colour of its main material.
  colourId    String?      @db.Uuid
  /// Its contrast panels, stitching and logos, as the office writes them; its pictures are its files.
  description String?
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  style          Style           @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  colour         Colour?         @relation(fields: [tenantId, colourId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  variants       Variant[]
  bomLines       BomLine[]
  bomLineColours BomLineColour[]
  // W2b-4 styles-depth.prisma (wave 26/33): its pictures.
  images         StyleImage[]
  // W2b-4 sizes-depth.prisma (wave 27/33): the prepack lines of this colourway.
  prepackLines   PrepackLine[]
  // sales.prisma: its quote and sales order lines.
  quoteLines      QuoteLine[]
  salesOrderLines SalesOrderLine[]
  // W2b portal-sales.prisma (wave 21/22): the portal order request lines that ask for it.
  portalRequestLines PortalOrderRequestLine[] @relation("PortalOrderRequestLineColourway")
  // production.prisma: the work order cells made in it.
  workOrderSizes  WorkOrderSize[]
  // W2a ncr.prisma: the nonconformances about it.
  nonconformances Nonconformance[]
  // pricing.prisma, returns.prisma: its own prices in price lists, its repairs.
  /// @not-money the relation to its price list entries
  priceListEntries PriceListEntry[]
  repairOrders     RepairOrder[]

  @@unique([tenantId, styleId, code])
  // The target of the references from the style's SKUs, BOM lines and grid cells: a colourway of the same style.
  @@unique([tenantId, styleId, id])
}

/// One cell of the colour x size SKU matrix (PRD-005): a colourway in a size of the style's range. A cell switched off
/// is ARCHIVED (never deleted once used).
model Variant {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId     String       @db.Uuid
  colourwayId String       @db.Uuid
  /// The size code: one of the style's sizes.
  size        String
  /// The SKU, unique in the tenant (built from the style, colourway and size codes).
  sku         String
  /// The barcode (GTIN-13 / EAN), unique in the tenant when set.
  gtin        String?
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  colourway Colourway @relation(fields: [tenantId, styleId, colourwayId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2a: its finished-goods item (one at most).
  items     Item[]
  // W2b-2 cutting.prisma (wave 13/16): the garments kept as this SKU in second quality.
  garmentDowngrades GarmentDowngrade[]

  @@unique([tenantId, sku])
  @@unique([tenantId, gtin])
  @@unique([tenantId, styleId, colourwayId, size])
  // W2a: the target of the finished-goods item's tenant-safe reference.
  @@unique([tenantId, id])
}

/// One revision of a style's specification: its BOM, routing and garment label (A1 §2.5). DRAFT while edited;
/// RELEASED is frozen for every login (the …_product_guards triggers), so a work order made from it always reads the
/// same specification; OBSOLETE when a newer revision is released (or a draft is abandoned).
model StyleRevision {
  id                  String              @id @db.Uuid
  tenantId            String              @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId             String              @db.Uuid
  /// 1, 2, 3 … per style.
  revision            Int
  status              StyleRevisionStatus @default(DRAFT)
  /// What changed against the previous revision.
  changeNote          String?
  /// The share of a hide's area the cutting plan expects to use for this style, percent (PRD-082); cutting compares the
  /// real yield with it.
  plannedHideYieldPct Decimal?            @db.Decimal(7, 4)
  /// The garment label template revision its units carry (PRD-331; ACTIVE when the revision is released).
  labelTemplateId     String?             @db.Uuid
  /// W2b-4 (B-W2b-211; PRD-099): what its BOM makes: outputQuantity (1 to 1000) units of outputUom (PCS, PAIR or SET):
  /// every line's quantity is per that output (sleeves and gloves cut in pairs: 1 PAIR). 1 PCS: one garment (every revision
  /// before W2b-4). Frozen with the revision once released.
  outputQuantity      Int                 @default(1)
  outputUom           Uom                 @default(PCS)
  /// When and by whom it was released; set exactly from RELEASED on.
  releasedAt          DateTime?           @db.Timestamptz(3)
  releasedById        String?             @db.Uuid
  /// W2b (B-W2b-205; PRD-124): the days its routing applies to new work orders (a work order made before keeps its frozen
  /// copy). effectiveFrom may be planned on a DRAFT; a release that names none takes the release's day (Europe/Rome);
  /// fixed once released. effectiveTo, the first day it no longer applies (the next revision's effectiveFrom), is set once,
  /// when or after a released revision goes OBSOLETE. Null on revisions released before W2b-4 (read releasedAt).
  effectiveFrom       DateTime?           @db.Date
  effectiveTo         DateTime?           @db.Date
  /// W2b-4 (schema wave 29/33, B-W2b-212; PRD-191): what of the style it is released for: colourways of the style and sizes
  /// of its range, each once; empty: every colourway (every size). Free while DRAFT; on a RELEASED revision they only widen
  /// (more colourways or sizes, or empty for all; all never narrows again); fixed once OBSOLETE.
  releasedColourwayIds String[]           @default([]) @db.Uuid
  releasedSizes        String[]           @default([])
  /// W2b-4 (B-W2b-212; PRD-232): the completeness score at release, 0 to 100 (B-W2b-231's gate); null while DRAFT and on
  /// revisions released before W2b-4. Given at or after the release, once.
  completenessPct      Decimal?           @db.Decimal(5, 2)
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  createdById         String?             @db.Uuid

  style          Style              @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // compliance.prisma.
  labelTemplate  LabelTemplate?     @relation(fields: [tenantId, labelTemplateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  bomLines       BomLine[]
  bomLineColours BomLineColour[]
  // W2b-4 options.prisma (wave 28/33): the BOM lines of other styles that use it as a sub-assembly.
  subAssemblyLines BomLine[]        @relation("BomLineSubAssembly")
  routing        RoutingOperation[]
  // W2b-4 styles-depth.prisma (wave 26/33): its pictures and its pattern, marker and CAD files.
  images         StyleImage[]
  files          StyleRevisionFile[]
  // W2b-4 sizes-depth.prisma (wave 27/33): its measurement specs and protector placement (parts of the revision).
  measurementSpecs    MeasurementSpec[]
  protectorPlacements ProtectorPlacement[]
  // sales.prisma: the quote lines costed from it and the sales order lines made to it.
  quoteLines      QuoteLine[]
  salesOrderLines SalesOrderLine[]
  // production.prisma: the work orders released with it as their frozen specification.
  workOrders      WorkOrder[]
  // W2b-2 cutting.prisma (wave 13/16): its pattern pieces (frozen with it).
  patternPieces   PatternPiece[]
  // quality.prisma: the PPE register entries about garments made to it.
  ppeRegisterEntries PpeRegisterEntry[]
  // W2a compliance.prisma: the type-change reviews of this revision, and those that compare a revision with it.
  typeChangeReviews         TypeChangeReview[] @relation("TypeChangeReviewRevision")
  comparedTypeChangeReviews TypeChangeReview[] @relation("TypeChangeReviewComparedRevision")
  // W2b: the styles copied from this revision.
  copies                    Style[]            @relation("StyleCopiedFromRevision")
  // W2b-4 instructions.prisma (wave 25/33): the work instructions written for this revision only.
  workInstructions          WorkInstruction[]
  // W2b-4 changes.prisma and samples.prisma (wave 29/33): the change requests about it, the change orders from and to it,
  // the sample rounds made from it.
  changeRequests            ChangeRequest[]
  changeOrdersFrom          ChangeOrder[]      @relation("ChangeOrderFromRevision")
  changeOrdersTo            ChangeOrder[]      @relation("ChangeOrderToRevision")
  sampleRounds              SampleRound[]

  @@unique([tenantId, styleId, revision])
  // The target of the references from the revision's parts: a revision of the same style.
  @@unique([tenantId, styleId, id])
}

enum StyleRevisionStatus {
  DRAFT
  RELEASED
  OBSOLETE
}

/// One line of a style revision's BOM (PRD-076, PRD-100): a material for every SKU of the style, or for one colourway
/// only. The quantity is per garment in `uom`; with sizeDependent the per-size quantities are BomLineSize rows
/// (PRD-079, PRD-082: leather area per size); with colourDependent the material colour per colourway is a BomLineColour
/// row (PRD-043), else itemColourId is the one colour for every colourway.
model BomLine {
  id              String   @id @db.Uuid
  tenantId        String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId         String   @db.Uuid
  revisionId      String   @db.Uuid
  /// Its place in the BOM, unique per revision.
  seq             Int
  itemId          String   @db.Uuid
  /// Where it goes: front panel, sleeve, lining, armour pocket.
  placement       String?
  /// Per garment, in `uom`: for every size, or the base size's when sizeDependent (the size rows then hold each size's).
  qty             Decimal  @db.Decimal(18, 4)
  /// Usually the item's consumption unit (leather: DM2 or FT2).
  uom             Uom
  /// Added on top of the quantity for waste and, on leather, the hide's yield; percent.
  wastagePct      Decimal  @default(0) @db.Decimal(7, 4)
  sizeDependent   Boolean  @default(false)
  colourDependent Boolean  @default(false)
  /// The material's colour for every colourway, when not colour-dependent and the material comes in colours.
  itemColourId    String?  @db.Uuid
  /// Only in this colourway; null: in every colourway (PRD-100).
  colourwayId     String?  @db.Uuid
  /// Bought from this supplier when it is not the item's default.
  supplierId      String?  @db.Uuid
  /// W2b-4 (B-W2b-211; PRD-077): the section of the BOM it is filed under; null: not filed (lines before W2b-4).
  section         BomSection?
  /// W2b-4 (PRD-077): the line of the same revision it is grouped under (a group row with its parts: a protector with its
  /// pocket and hook-and-loop), never itself or a line grouped under it; null: not grouped. Grouping moves no quantity: a
  /// line's quantity is always per output unit of the revision.
  parentLineId    String?  @db.Uuid
  /// W2b-4 (PRD-078, PRD-106): a sub-assembly: a revision of another style made as a part of this one (a removable liner,
  /// an armour insert, a hump), its BOM and routing its own; both or neither. The line's material is then the COMPONENT we
  /// make (sourcing MAKE or MAKE_OR_BUY) counted in PCS, PAIR or SET; the revision is DRAFT or RELEASED when named and
  /// RELEASED when this revision is released (no draft part under a released parent); a style is never inside its own
  /// sub-assemblies (no circle, at most 10 levels).
  subAssemblyStyleId    String? @db.Uuid
  subAssemblyRevisionId String? @db.Uuid
  /// W2b-4 (PRD-084): the customer sends this material (cut-make-trim with the brand's leather): a party with the CUSTOMER
  /// or BRAND role; no cost, no purchase (never with supplierId); null: we buy it.
  customerSuppliedByPartyId String? @db.Uuid
  /// W2b-4 (PRD-108): the line goes in the kit a workshop receives for a subcontracted job.
  issueToSubcontract Boolean @default(false)
  /// W2b-4 (PRD-088): the rule that made the line, "<source>:<key>": "branding:polybag" (a packaging rule of B-W2b-206's
  /// BrandingSet), "compliance:<requirement key>" (a label or packaging requirement); null: typed by a person.
  sourceKey       String?
  /// W2b-4 (PRD-081): the line is in the garment only when this option value is chosen (a value of a group the style
  /// offers, ACTIVE when newly named); null: always.
  optionValueId   String?  @db.Uuid
  /// W2b-2 (B-W2b-74): the routing step of the same revision that uses the line (RoutingOperation.seq), so a material flag
  /// and a scan's components can be per operation (B-W2b-88); null: not tied to one step (what every line was before).
  routingSeq      Int?
  /// W2b-4 (B-W2b-210; PRD-204): a made-to-measure unit's quantity follows one of its measures: a point of the style's
  /// measurement template and the share of the quantity that follows it (above 0, at most 10): the unit's quantity = the
  /// base size's × (1 + mtmScaleFactor × (the unit's measure ÷ the base size's measure − 1)). Both or neither; null: the
  /// unit takes its nearest size's quantity.
  mtmScalePointId String?  @db.Uuid
  mtmScaleFactor  Decimal? @db.Decimal(7, 4)
  note            String?
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?  @db.Uuid

  revision   StyleRevision   @relation(fields: [tenantId, styleId, revisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-2: a renumbered step of a draft revision takes its lines along (Cascade); a step in use is not removed.
  routingStep RoutingOperation? @relation(fields: [tenantId, revisionId, routingSeq], references: [tenantId, revisionId, seq], onDelete: Restrict, onUpdate: Cascade)
  item       Item            @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  itemColour ItemColour?     @relation(fields: [tenantId, itemId, itemColourId], references: [tenantId, itemId, id], onDelete: Restrict, onUpdate: Restrict)
  colourway  Colourway?      @relation(fields: [tenantId, styleId, colourwayId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  supplier   Party?          @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-4 options.prisma (wave 28/33): its group row and the lines grouped under it, its sub-assembly (a revision of another
  // style), the customer who sends the material, its option value (Restrict, not Prisma's SetNull default: that would also
  // clear tenantId and revisionId), its alternates.
  parentLine          BomLine?           @relation("BomLineGroup", fields: [tenantId, revisionId, parentLineId], references: [tenantId, revisionId, id], onDelete: Restrict, onUpdate: Restrict)
  groupedLines        BomLine[]          @relation("BomLineGroup")
  subAssemblyRevision StyleRevision?     @relation("BomLineSubAssembly", fields: [tenantId, subAssemblyStyleId, subAssemblyRevisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  customerSuppliedBy  Party?             @relation("BomLineCustomerSupplied", fields: [tenantId, customerSuppliedByPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  optionValue         OptionValue?       @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  alternates          BomLineAlternate[]
  sizes      BomLineSize[]
  colours    BomLineColour[]
  // W2b-4: the made-to-measure point its quantity follows (Restrict, not Prisma's SetNull default: that would also clear
  // tenantId).
  mtmScalePoint MeasurementPoint? @relation(fields: [tenantId, mtmScalePointId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // production.prisma: the work orders' planned materials of the line.
  workOrderMaterials WorkOrderMaterial[]
  // W2b-5 warehouse-depth.prisma (wave 36/44): the substitutes used for its material on work orders.
  materialSubstitutions MaterialSubstitution[]
  // W2b-5 sales-orders-depth.prisma (wave 39/44): the customers' materials expected for orders of the line (customer-supplied).
  customerMaterials  CustomerMaterial[]
  // W2b-2 cutting.prisma (wave 13/16): the pattern pieces cut from the line.
  patternPieces      PatternPiece[]

  @@unique([tenantId, revisionId, seq])
  // The target of the size rows' reference: a line of the same revision.
  @@unique([tenantId, revisionId, id])
  // W2b-4: the lines grouped under a line, and the lines that use a revision as a sub-assembly (the circle and release rules
  // and the references' checks read them).
  @@index([tenantId, revisionId, parentLineId])
  @@index([tenantId, subAssemblyStyleId, subAssemblyRevisionId])
  // The target of the grid cells' reference: a line of the same revision, and of the material whose colour they name.
  @@unique([tenantId, revisionId, id, itemId])
}

/// A size-dependent BOM line's quantity in one size (PRD-079), in the line's unit. A size of the range without a row
/// does not use the line.
model BomLineSize {
  id          String   @id @db.Uuid
  tenantId    String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  revisionId  String   @db.Uuid
  bomLineId   String   @db.Uuid
  /// The size code: one of the style's sizes.
  size        String
  qty         Decimal  @db.Decimal(18, 4)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  bomLine BomLine @relation(fields: [tenantId, revisionId, bomLineId], references: [tenantId, revisionId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, bomLineId, size])
}

/// One cell of the colourway BOM colour grid (PRD-043): the material colour a colour-dependent line uses in one
/// colourway. One per line and colourway (the product module keeps it so); a colourway without one does not use the
/// line.
model BomLineColour {
  id           String   @id @db.Uuid
  tenantId     String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId      String   @db.Uuid
  revisionId   String   @db.Uuid
  bomLineId    String   @db.Uuid
  /// The line's material (its colour must be one of the material's).
  itemId       String   @db.Uuid
  colourwayId  String   @db.Uuid
  itemColourId String   @db.Uuid
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?  @db.Uuid

  bomLine    BomLine       @relation(fields: [tenantId, revisionId, bomLineId, itemId], references: [tenantId, revisionId, id, itemId], onDelete: Restrict, onUpdate: Restrict)
  // So the colourway is one of the revision's own style.
  revision   StyleRevision @relation(fields: [tenantId, styleId, revisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  colourway  Colourway     @relation(fields: [tenantId, styleId, colourwayId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  itemColour ItemColour    @relation(fields: [tenantId, itemId, itemColourId], references: [tenantId, itemId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, bomLineId])
}

/// An operation of the library (PRD-109): what is done, at which kind of work centre, on which machine, with which
/// skill and its standard minutes (SMV). Its photos and videos are its files. Routings copy it.
model Operation {
  id              String         @id @db.Uuid
  tenantId        String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data (A1 §2.1).
  companyId       String?        @db.Uuid
  code            String
  name            String
  /// The name per locale, the floor languages included.
  nameI18n        Json?
  /// The department: the kind of work centre it runs at.
  workCentreKind  WorkCentreKind
  /// Flat-bed, post-bed, twin-needle, skiving, press, laser …
  machineType     String?
  skill           String?
  /// Standard minutes per garment.
  standardMinutes Decimal        @db.Decimal(10, 3)
  /// W2b (B-W2b-205; PRD-111): how the SMV is built: basic minutes per garment and the personal, fatigue and delay
  /// allowances in percent, so standardMinutes = basicMinutes × (1 + (personalPct + fatiguePct + delayPct) / 100), to the
  /// thousandth. All four or none (none: an SMV typed as in W1). Once the operation has an APPROVED OperationTimeVersion,
  /// the five numbers change only to those of an approved version (PRD-113: a second person approves an SMV change); the
  /// …_routings_instructions_w2b_guards trigger holds both rules.
  basicMinutes    Decimal?       @db.Decimal(10, 3)
  personalPct     Decimal?       @db.Decimal(7, 4)
  fatiguePct      Decimal?       @db.Decimal(7, 4)
  delayPct        Decimal?       @db.Decimal(7, 4)
  /// How it is done, for the traveller and the floor screen.
  instructions    String?
  status          MasterStatus   @default(ACTIVE)
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?        @db.Uuid

  company Company?           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  routing RoutingOperation[]
  // W2b-4 instructions.prisma (wave 25/33): its SMV versions, machine settings and work instructions.
  timeVersions     OperationTimeVersion[]
  machineSettings  OperationMachineSetting[]
  workInstructions WorkInstruction[]
  // W2b skills.prisma (wave 4/7): the skills about it.
  skills  Skill[]
  // W2b pay.prisma (schema wave 6/7): the piece rates that pay it.
  pieceRateEntries PieceRateEntry[]
  // W2b-4 options.prisma (wave 28/33): the option effects that add it or add minutes at it.
  optionEffects    OptionEffect[]
  // W2b-2 production.prisma (B-W2b-74): the unplanned operations made from it.
  unplannedOperations WorkOrderOperation[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// One step of a style revision's routing (PRD-110), in order: an operation of the library, copied with its name, kind
/// of work centre and standard minutes (which the revision may change), so a later library edit leaves released
/// routings as they are. The floor scans these operations; the work order maps each to a work centre of its site.
model RoutingOperation {
  id              String         @id @db.Uuid
  tenantId        String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId         String         @db.Uuid
  revisionId      String         @db.Uuid
  /// Its place in the routing, unique per revision.
  seq             Int
  operationId     String         @db.Uuid
  /// The library operation's code and name, as copied.
  code            String
  name            String
  nameI18n        Json?
  workCentreKind  WorkCentreKind
  /// Standard minutes per garment.
  standardMinutes Decimal        @db.Decimal(10, 3)
  /// W2b (B-W2b-205; PRD-111): the basic minutes and allowances the SMV was built from, frozen with the revision as the
  /// SMV is (Operation's rule: all four or none, standardMinutes = basicMinutes × (1 + allowances / 100)).
  basicMinutes    Decimal?       @db.Decimal(10, 3)
  personalPct     Decimal?       @db.Decimal(7, 4)
  fatiguePct      Decimal?       @db.Decimal(7, 4)
  delayPct        Decimal?       @db.Decimal(7, 4)
  /// W2b (PRD-113): the APPROVED OperationTimeVersion of its own operation the minutes were copied from (its five numbers
  /// equal the version's when it is named); null: minutes typed for this routing, or a W1 copy.
  timeVersionId   String?        @db.Uuid
  /// W2b (PRD-126): the minutes beside the run (standardMinutes per garment), per work order, for planning: set-up before
  /// its first piece, waiting after the step before the next one starts, moving the work to the next step. Null: none said.
  setupMinutes    Decimal?       @db.Decimal(10, 3)
  waitMinutes     Decimal?       @db.Decimal(10, 3)
  moveMinutes     Decimal?       @db.Decimal(10, 3)
  /// W2b (PRD-128): the step only for some cells: size codes of the style's range, colourways of the style, option values
  /// (B-W2b-211's OptionValue, no reference until that wave merges). Empty: every size, every colourway, whatever option.
  appliesToSizes          String[] @default([])
  appliesToColourwayIds   String[] @default([]) @db.Uuid
  appliesToOptionValueIds String[] @default([]) @db.Uuid
  /// W2b (PRD-119): the quality checkpoint at this step, an inspection plan of the style's company (not an incoming or a
  /// return plan); the in-process rule of B-W2b-101 reads it. Null: no checkpoint.
  inspectionPlanId String?       @db.Uuid
  /// Every bundle is scanned at it (floor scans, B-W1-42).
  scanRequired    Boolean        @default(true)
  /// W2b-2 (B-W2b-74; MES-025): steps of the routing with the same number run side by side and count as one step; null:
  /// in sequence. From 1. Its work orders' operations keep a copy.
  parallelGroup   Int?
  instructions    String?
  /// W2a subcontracted operation (PRD-120): the workshop that does it (a party with the SUBCONTRACTOR role; the product
  /// module checks the role), its fee per piece in euros (a subcontract order copies it in its own currency) and the
  /// days the pieces travel there and back; null: done in-house. The fee and the days go with the workshop: neither
  /// without it.
  supplierId      String?        @db.Uuid
  /// @grain cost
  pricePerPiece   Decimal?       @db.Decimal(18, 6)
  transitDays     Int?
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?        @db.Uuid

  revision  StyleRevision @relation(fields: [tenantId, styleId, revisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  operation Operation     @relation(fields: [tenantId, operationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2a: the workshop of a subcontracted step. Restrict, not Prisma's SetNull default: that would also clear tenantId.
  supplier  Party?        @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // production.prisma: the work order operations made from the step.
  workOrderOperations WorkOrderOperation[]
  // W2b-2 (B-W2b-74): the BOM lines it uses.
  bomLines            BomLine[]
  // W2b-4 instructions.prisma (wave 25/33): the approved minutes it copied, its checkpoint, its extra minutes per size and
  // its machine settings (both frozen with the revision).
  timeVersion     OperationTimeVersion?      @relation(fields: [tenantId, operationId, timeVersionId], references: [tenantId, operationId, id], onDelete: Restrict, onUpdate: Restrict)
  inspectionPlan  InspectionPlan?            @relation(fields: [tenantId, inspectionPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sizeTimes       RoutingOperationSizeTime[]
  machineSettings OperationMachineSetting[]  @relation("RoutingOperationMachineSetting")

  @@unique([tenantId, revisionId, seq])
  // W2b-4: the target of its size times' and machine settings' reference: a step of the same revision.
  @@unique([tenantId, revisionId, id])
}

/// Which body measures to take for a made-to-measure garment of one type (PRD-200; about 23 for a race suit). A
/// measurement profile (parties.prisma) names it by its code (garmentType).
model MeasurementTemplate {
  id           String       @id @db.Uuid
  tenantId     String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data (A1 §2.1).
  companyId    String?      @db.Uuid
  /// The garment type, unique in the tenant ("JACKET"): a measurement profile's garmentType.
  code         String
  name         String
  nameI18n     Json?
  productType  ProductType
  /// How to measure, before the points.
  instructions String?
  /// W2b-4 (B-W2b-210; PRD-202): which measures pick a rider's base size from the style's size scale (each size's body
  /// measures): {"points": ["chest", "height"], "tie": "LARGER"}: 1 to 10 codes of this template's points, in priority
  /// order, and between two sizes the larger (default) or the smaller. Null: no base size is suggested.
  baseSizeRule Json?
  /// W2b-4 (B-W2b-210; Owner 11-09, GATE-MTM): the made-to-measure rules of the template (its MeasurementRule rows, the
  /// base size rule, its points' alteration limits) are checked only while on. Built off.
  rulesOn      Boolean      @default(false)
  status       MasterStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?      @db.Uuid

  company Company?           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  points  MeasurementPoint[]
  // W2b-4 sizes-depth.prisma (wave 27/33): its plausibility rules.
  rules   MeasurementRule[]
  styles  Style[]
  // W2b-4 styles-depth.prisma (wave 26/33): the product types whose default template it is.
  productTypeProfiles ProductTypeProfile[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// One point of measure of a template, with its unit and plausible range; its how-to pictures are its files.
model MeasurementPoint {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  templateId  String       @db.Uuid
  /// Its key in a measurement profile and in a size's body measures ("chest"), unique in the template.
  code        String
  name        String
  nameI18n    Json?
  /// Its place in the template.
  seq         Int
  uom         Uom          @default(CM)
  /// The plausible range: a value outside it is asked again.
  minValue    Decimal?     @db.Decimal(8, 2)
  maxValue    Decimal?     @db.Decimal(8, 2)
  required    Boolean      @default(true)
  /// How to measure it.
  howTo       String?
  /// W2b-4 (B-W2b-210; PRD-069, B-W2b-171): the library's BODY point of measure it is (of its unit): its body zone, picture
  /// and words; null: a point of this template only.
  pointOfMeasureId String?  @db.Uuid
  /// W2b-4 (B-W2b-97, PRD-203): the tolerance, plus and minus, a made-to-measure garment is inspected with at this point;
  /// and how far a rider's measure may be under or over the base size's before a pattern maker must review the unit
  /// (outside the certified range). In its unit, 0 or more; null: not set.
  tolerance        Decimal? @db.Decimal(8, 2)
  alterationMinus  Decimal? @db.Decimal(8, 2)
  alterationPlus   Decimal? @db.Decimal(8, 2)
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  template MeasurementTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-4 sizes-depth.prisma (wave 27/33): its library point (Restrict, not Prisma's SetNull default: that would also clear
  // tenantId), the rules that check it or compare with it, the BOM lines whose made-to-measure quantity follows it.
  pointOfMeasure  PointOfMeasure?   @relation(fields: [tenantId, pointOfMeasureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  rules           MeasurementRule[] @relation("MeasurementRulePoint")
  comparedInRules MeasurementRule[] @relation("MeasurementRuleOtherPoint")
  scaledBomLines  BomLine[]

  @@unique([tenantId, templateId, code])
  // W2b-4: the targets of the rules' references (a point of the same template) and of the BOM lines' reference.
  @@unique([tenantId, templateId, id])
  @@unique([tenantId, id])
}
