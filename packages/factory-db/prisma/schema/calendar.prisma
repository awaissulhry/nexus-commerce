// Business calendars and shift patterns (W2a schema wave 1/7; B-W2a-08; features PLT-103, PLN-001, PLN-002; design
// planning.settings "Calendars & shifts" with its popups day and closure; people.shifts reads the same patterns in W2b).
// One service (B-W2a-08) counts working time from these rows for the planning board, capacity, invoice deadlines and the
// MRP order-by date, so every module counts a working day the same way:
//
//   WorkCalendar  the calendar of one company, site, line, work centre (a workshop) or supplier: its working week and
//                 the shift pattern of a normal working day. A line's day is read line → site → company: the most
//                 specific calendar that says something about the day wins, and a calendar without a pattern takes the
//                 one of the calendar above it. A supplier's calendar stands alone (its closed days: August, Christmas).
//                 One ACTIVE calendar per owner (partial unique indexes of …_platform_w2a_guards).
//   CalendarDay   a dated exception of one calendar: a public HOLIDAY, a CLOSURE (an August shutdown, a line closed) or
//                 a WORKING day outside the normal week or with another pattern (an extra Saturday, an extra shift, a
//                 short day). One row per calendar and date.
//   ShiftPattern  a named week of shifts ("One shift", "Two shifts", "Saturday morning"), tenant-wide or one company's.
//   ShiftSegment  one stretch of a pattern's weekday: a SHIFT (working time) or a BREAK inside one.
//
// No person is named here: who works which shift is People (W2b), never a planning figure (Statuto dei Lavoratori
// art. 4). The hand-written migration …_platform_w2a_guards holds the rules Prisma does not model.

/// The calendar of one company, site, line, work centre or supplier (CalendarScope says which; exactly that owner's
/// columns are set, and they never change). Archived, never deleted: an owner gets a new calendar by archiving the old.
model WorkCalendar {
  id              String        @id @db.Uuid
  tenantId        String        @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  scope           CalendarScope
  /// COMPANY: the owner. SITE, LINE, WORK_CENTRE: the owner's company. SUPPLIER: the supplier's company (null for a
  /// tenant-wide supplier).
  companyId       String?       @db.Uuid
  /// SITE: the owner; LINE and WORK_CENTRE: the owner's site.
  siteId          String?       @db.Uuid
  lineId          String?       @db.Uuid
  workCentreId    String?       @db.Uuid
  /// SUPPLIER: the supplier or subcontractor (a Party; the API checks its role).
  partyId         String?       @db.Uuid
  name            String
  /// W2b (B-W2b-03; B-W2a-08's gap): a supplier's own time zone abroad (IANA: "Asia/Karachi"), only on a SUPPLIER
  /// calendar; null: the company's (Europe/Rome). Our calendars keep their company's and site's zone.
  timeZone        String?
  /// The ISO weekdays (1 Monday … 7 Sunday) that work in a normal week, ascending, at least one.
  workingWeekdays Int[]         @default([1, 2, 3, 4, 5])
  /// The pattern of a normal working day (not on a SUPPLIER calendar); null: the one of the calendar above it, else
  /// the planning default (one shift).
  shiftPatternId  String?       @db.Uuid
  status          MasterStatus  @default(ACTIVE)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?       @db.Uuid

  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and the other keys.
  company      Company?      @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  site         Site?         @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  line         Line?         @relation(fields: [tenantId, siteId, lineId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  workCentre   WorkCentre?   @relation(fields: [tenantId, siteId, workCentreId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  party        Party?        @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  shiftPattern ShiftPattern? @relation(fields: [tenantId, shiftPatternId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  days         CalendarDay[]

  // The target of the days' tenant-safe reference.
  @@unique([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, siteId])
  @@index([tenantId, partyId])
}

/// Whose calendar it is.
enum CalendarScope {
  COMPANY
  SITE
  LINE
  /// A workshop (reparto): a work centre of a site.
  WORK_CENTRE
  SUPPLIER
}

/// One dated exception of a calendar. Removed when the exception is taken back (the API audits it).
model CalendarDay {
  id             String          @id @db.Uuid
  tenantId       String          @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  calendarId     String          @db.Uuid
  date           DateTime        @db.Date
  kind           CalendarDayKind
  /// What the day is, as the calendar shows it ("Ferragosto", "August shutdown", "Extra Saturday").
  name           String
  /// WORKING: that day's pattern (an extra shift, a short day, a Saturday morning); null: the calendar's. HOLIDAY and
  /// CLOSURE days carry none, nor does a supplier's day.
  shiftPatternId String?         @db.Uuid
  note           String?
  /// A public holiday from a seeded list (`IT`: Italy's national holidays); null: set by a person.
  holidaySet     String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(3)
  createdById    String?         @db.Uuid

  calendar     WorkCalendar  @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId.
  shiftPattern ShiftPattern? @relation(fields: [tenantId, shiftPatternId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, calendarId, date])
  // Every calendar's exceptions over a period (the board's lanes, the MRP's order-by date).
  @@index([tenantId, date])
}

enum CalendarDayKind {
  /// A public holiday: nobody works.
  HOLIDAY
  /// The owner is closed that day (an August shutdown, Christmas, a line closed for a move).
  CLOSURE
  /// The owner works that day outside its normal week, or with another pattern.
  WORKING
}

/// A named week of shifts. Archived, never deleted (calendars and days name it).
model ShiftPattern {
  id          String         @id @db.Uuid
  tenantId    String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company that uses it; null: tenant-wide, for every company's calendars. Never changes.
  companyId   String?        @db.Uuid
  /// Short code, unique in the tenant ("1T", "2T", "SAT-AM"). Never changes.
  code        String
  name        String
  /// One line beside the name in pickers ("06:00-14:00 and 14:00-22:00, Monday to Friday").
  description String?
  status      MasterStatus   @default(ACTIVE)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?        @db.Uuid

  company      Company?       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  segments     ShiftSegment[]
  calendars    WorkCalendar[]
  calendarDays CalendarDay[]
  // W2b people.prisma (wave 4/7): the people who normally work it.
  employees    Employee[]

  @@unique([tenantId, code])
  // The target of the calendars', days' and segments' tenant-safe references.
  @@unique([tenantId, id])
}

/// One stretch of a pattern's weekday, in minutes from that weekday's midnight in the site's time zone: 360-840 is
/// 06:00-14:00; a SHIFT starts in its day and a night shift runs past 1440 (22:00-06:00 is 1320-1800), at most 24 hours
/// long. A BREAK lies inside a SHIFT of the same weekday, so one in a night shift may start past 1440 (checked at
/// commit: a pattern is saved in one command). A day's working time is its shifts less its breaks.
model ShiftSegment {
  id          String           @id @db.Uuid
  tenantId    String           @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  patternId   String           @db.Uuid
  /// ISO weekday: 1 Monday … 7 Sunday.
  weekday     Int
  kind        ShiftSegmentKind
  /// The shift's name ("Morning", "A"), or the break's ("Lunch").
  label       String?
  startMinute Int
  endMinute   Int
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?          @db.Uuid

  pattern ShiftPattern @relation(fields: [tenantId, patternId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, patternId, weekday])
}

enum ShiftSegmentKind {
  /// Working time.
  SHIFT
  /// A break inside a shift: not working time.
  BREAK
}
