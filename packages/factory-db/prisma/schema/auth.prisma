// Office sign-in (plan A1 §2.3, §3.10; features PLT-014, PLT-015, PLT-016, PLT-047, PLT-048, PLT-070): the people of a
// tenant, their sessions, their invitations and their password resets. apps/factory-api/src/platform/auth reads and
// writes them; every change goes through command() with its audit row.
//
// Every model sits behind the tenant wall. The person is a row of ONE tenant (email unique in the tenant), not a global
// identity: the walls of A1 §2.2 let factory_platform read only Tenant, so sign-in finds the tenant first (its slug in
// the sign-in request; its id in every cookie and link) and looks the person up inside it, as factory_runtime.
//
// Secrets are never stored: passwords as scrypt hashes, session, invitation and reset tokens as SHA-256 of the token,
// recovery codes as HMACs, the TOTP secret encrypted (AES-256-GCM). The logger redacts these columns by name.
//
// W2b schema wave 17/22 (B-W2b-152; PLT-006, PLT-021, PLT-022, PLT-050; Owner answer C3): portal users join this table.
// A partner user is a User with audience PARTNER and ONE party (partyId, its partner kind, an optional end of access):
// one person table, never a second one. A partner signs in by an e-mail code only (portal-auth.prisma PortalSignInCode),
// so a partner user never has a password (the …_portal_identity_w2b_guards triggers). Sessions and invitations carry
// the audience too: a partner session is bound to the party of its person (idle 30 minutes, absolute 12 hours, A1
// §3.10), and an office person previewing a partner's portal holds a partner session of that party marked as a preview
// (read-only, every preview audited by the API). factory_partner_runtime reads the User and Session rows of its own party
// only, never a password, TOTP or recovery column (ownership/auth.json); everything else here stays the office's.

/// A person who signs in to the Office of one tenant (what they may do: their role assignments, roles.prisma; floor
/// workers join this table in their steps), or, with audience PARTNER (W2b-3), a person of one partner organisation who
/// signs in to its portal. Never deleted: a leaver is DEACTIVATED and keeps their name on history.
model User {
  id                   String     @id @db.Uuid
  tenantId             String     @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The sign-in name: trimmed and lower case (normalizeEmail), unique in the tenant.
  email                String
  displayName          String
  locale               String     @default("it")
  status               UserStatus @default(INVITED)
  /// Two-factor is required for this person, whatever their roles (a role can require it too: Role.requireMfa). Until
  /// it is set up and proved on a session, the session holds no permission.
  requireMfa           Boolean    @default(false)
  /// scrypt, `$scrypt$ln=…,r=…,p=…$salt$hash` (factory-domain auth/password). Null: no password (invited, deactivated).
  passwordHash         String?
  passwordChangedAt    DateTime?  @db.Timestamptz(3)
  /// An administrator asked for a new password: the next sign-in ends in a reset, not a session (PLT-070).
  mustChangePassword   Boolean    @default(false)
  /// Wrong passwords and codes in a row, and the lock they set (factory-domain auth/lockout).
  failedAttempts       Int        @default(0)
  lockedUntil          DateTime?  @db.Timestamptz(3)
  lastSignInAt         DateTime?  @db.Timestamptz(3)
  /// The confirmed TOTP secret, encrypted; null without two-factor.
  totpSecretEnc        String?
  totpConfirmedAt      DateTime?  @db.Timestamptz(3)
  /// A secret being set up, encrypted, until a code confirms it.
  totpPendingSecretEnc String?
  /// The time step of the last accepted code: a code of this step or an earlier one is refused (replay).
  totpLastStep         Int?
  /// HMAC-SHA-256 of each unused recovery code; a code leaves the list when it is used.
  recoveryCodeHashes   String[]   @default([])
  /// W2b (B-W2b-152): who the person signs in as. OFFICE: the Office (a password, roles of the OFFICE audience). PARTNER:
  /// the portal of one party (an e-mail code only, never a password; roles of the PARTNER audience bound to that party).
  /// Never changes: a person of a partner and an office person are two accounts.
  audience             UserAudience @default(OFFICE)
  /// The partner organisation of a PARTNER user, set exactly then; never changes once set. Personal data (whose person
  /// they are; purpose: the portal account).
  partyId              String?      @db.Uuid
  /// Which portal a PARTNER user sees (PLT-021), set exactly then and fitting the party's roles: CUSTOMER (a customer or
  /// a brand), SUPPLIER, SUBCONTRACTOR, GUEST (an outside adviser: a CONSULTANT party, B-W2b-75; time-boxed).
  partnerKind          PartnerKind?
  /// PLT-022: the end of a PARTNER user's access (the API ends it by itself; "access ends soon" 7 days before); null: no
  /// end. Only on a partner user (an office person's access ends with their role assignments' validTo); a GUEST always
  /// has one. Personal data (purpose: the portal account).
  accessUntil          DateTime?    @db.Timestamptz(3)
  version              Int        @default(1)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?    @db.Uuid

  // A suspended tenant's people cannot sign in, and their sessions stop (sessions/authenticator.ts).
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (B-W2b-152): the party of a partner user (Restrict, not Prisma's SetNull default for an optional relation: that
  // would also clear tenantId).
  party             Party?            @relation("UserParty", fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sessions          Session[]         @relation("SessionUser")
  // W2b: the partner portals this office person previewed (Session.previewById).
  previewSessions   Session[]         @relation("SessionPreviewBy")
  // W2b portal-auth.prisma: the sign-in and step-up codes sent to this partner user.
  portalSignInCodes PortalSignInCode[]
  // W2b privacy.prisma: the partner user's acknowledgements of the portal terms.
  partnerNoticeAcks PartnerNoticeAck[]
  invitations       Invitation[]      @relation("InvitedUser")
  sentInvitations   Invitation[]      @relation("InvitedBy")
  passwordResets    PasswordReset[]
  // roles.prisma: the roles the person holds, with their scopes.
  roleAssignments   RoleAssignment[]
  // floor-auth.prisma: the floor worker records linked to this person.
  workers           Worker[]
  // W2b people.prisma (wave 4/7): the person's employee record, if any.
  employee          Employee?
  // privacy.prisma: the person's acknowledgements of their company's staff notice.
  staffNoticeAcks   StaffNoticeAck[]
  // insights.prisma: Today's alerts assigned to the person, and the person's arrangement of Today (one: its id is theirs).
  attentionAssigned AttentionAction[] @relation("AttentionAssignee")
  todayLayouts      TodayLayout[]
  // W2b insights.prisma: the reports they ran ("last run by me").
  reportRuns        ReportRun[]
  // collab.prisma: the person's notifications, the records they follow, their @mentions, the tasks assigned to them.
  notifications       Notification[]
  followedRecords     RecordFollower[]
  mentions            MessageMention[]
  assignedTasks       Task[]
  // views.prisma: their saved views, their exports and the reports sent to them.
  savedViews          SavedView[]
  exportJobs          ExportJob[]
  reportSubscriptions ReportSubscription[]
  // alerts.prisma: the alerts assigned to them.
  assignedAlerts      Alert[]
  // W2b-5 approvals.prisma (wave 35/44): the approval rules and the requests that name them as the approver.
  approvalRules       ApprovalRule[] @relation("ApprovalRuleApproverUser")
  approvalTasks       ApprovalTask[] @relation("ApprovalTaskApproverUser")
  // W2b links-depth.prisma (wave 19/22): as a partner user, the approval requests they answered in the portal.
  approvalAnswers     ApprovalRequest[] @relation("ApprovalRequestAnsweredBy")
  // W2b portal-frame.prisma (wave 20/22): as a partner user, the tasks they did in the portal and their e-mail settings.
  partnerTasksDone    PartnerTask[]     @relation("PartnerTaskDoneBy")
  partnerEmailPreferences PartnerEmailPreference[]
  // W2b portal follow-ups (schema wave 23): as a partner user, the open requests handed to them, the purchase orders they
  // confirmed or answered with changes in the portal, the delivery addresses they asked for, the documents they uploaded
  // and the profile changes they asked.
  partnerTasksAssigned    PartnerTask[]          @relation("PartnerTaskAssignee")
  portalConfirmedOrders   PurchaseOrder[]        @relation("PurchaseOrderConfirmedByUser")
  portalProposedOrders    PurchaseOrder[]        @relation("PurchaseOrderProposedByUser")
  requestedAddresses      PartyAddress[]         @relation("PartyAddressRequestedBy")
  supplierDocumentUploads SupplierDocumentUpload[]
  partyChangeRequests     PartyChangeRequest[]

  @@unique([tenantId, email])
  // The target of the tenant-safe references from the auth rows.
  @@unique([tenantId, id])
  // W2b: a party's people (the partner policy reads by it).
  @@index([tenantId, partyId])
}

/// W2b (B-W2b-152): who a person, a session or an invitation is for.
enum UserAudience {
  /// The Office of the tenant.
  OFFICE
  /// The portal of one partner organisation (a party).
  PARTNER
}

/// W2b (B-W2b-152; PLT-021): which portal a partner user sees.
enum PartnerKind {
  /// A customer or a brand: orders, tracking, documents, returns.
  CUSTOMER
  /// A supplier: purchase orders without prices, ship notices, documents we ask for (Owner answer C2).
  SUPPLIER
  /// A workshop (terzista): its subcontract jobs, without prices.
  SUBCONTRACTOR
  /// An outside adviser with a time-boxed guest login (the accountant: files only; PLT-022, B-W2b-201).
  GUEST
}

/// The life of a user (apps/factory-api platform/auth/users: the machine and its commands).
enum UserStatus {
  /// Invited, no password yet; signs in after accepting the invitation.
  INVITED
  ACTIVE
  /// Cannot sign in; every session ended. Reactivation gives the access back.
  SUSPENDED
  /// Left: cannot sign in, credentials cleared, kept for the history. Can only be invited again.
  DEACTIVATED
}

/// One signed-in browser (a `__Host-` cookie holds the token). Valid until revoked, 8 hours without use or 7 days
/// after sign-in, whichever comes first; the user must still be ACTIVE. W2b (B-W2b-152): a PARTNER session is the portal
/// session of one party: its person's party, or, for an office preview, the party previewed; 30 minutes without use and
/// 12 hours after sign-in at most (A1 §3.10; the guards hold both).
model Session {
  id                String            @id @db.Uuid
  tenantId          String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId            String            @db.Uuid
  /// SHA-256 (hex) of the cookie value; the value is never stored.
  tokenHash         String            @unique
  /// The company the session starts in (the tenant's only active company at sign-in, else none); the
  /// x-factory-company header picks one per request.
  companyId         String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime          @db.Timestamptz(3)
  /// Slides forward with use (at most once a minute), never past the absolute expiry.
  idleExpiresAt     DateTime          @db.Timestamptz(3)
  absoluteExpiresAt DateTime          @db.Timestamptz(3)
  /// When the second factor was proved on this session (at sign-in or when two-factor was set up).
  mfaAt             DateTime?         @db.Timestamptz(3)
  /// The last step-up (a fresh code) on this session; risky actions need a recent one.
  stepUpAt          DateTime?         @db.Timestamptz(3)
  /// HMAC of the shortened client address (/24, /64), never the address.
  ipHash            String?
  userAgent         String?
  revokedAt         DateTime?         @db.Timestamptz(3)
  revokedReason     SessionEndReason?
  /// W2b (B-W2b-152): OFFICE (the Office cookie) or PARTNER (a portal session of one party). Never changes.
  audience          UserAudience      @default(OFFICE)
  /// The party of a PARTNER session, set exactly then and never changed: the person's own party, or the party an office
  /// person previews. factory_partner_runtime reads a session only in the scope of this party.
  partyId           String?           @db.Uuid
  /// An office preview of a partner's portal (B-W2b-162; design portal.frame notices "previewing this portal as …"):
  /// read-only for the API, every preview in the audit log. Set exactly on a preview, equal to partyId; the session's
  /// person is then an office person, and previewById names them (equal to userId). Never changes.
  previewOfPartyId  String?           @db.Uuid
  previewById       String?           @db.Uuid

  user    User     @relation("SessionUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId.
  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b: the party of a partner session, the party an office preview shows, the office person previewing.
  party            Party? @relation("SessionParty", fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  previewOfParty   Party? @relation("SessionPreviewOfParty", fields: [tenantId, previewOfPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  previewBy        User?  @relation("SessionPreviewBy", fields: [tenantId, previewById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  // W2b: a party's sessions (the partner policy reads by it).
  @@index([tenantId, partyId])
}

/// Why a session ended before its time.
enum SessionEndReason {
  SIGNED_OUT
  SUSPENDED
  DEACTIVATED
  /// A new password was set, or an administrator required one.
  PASSWORD_CHANGED
}

/// An invitation to join the tenant's Office by email (PLT-015): a single-use link that expires. The invited user row
/// exists from the start (INVITED); accepting sets the password and activates it. W2b (B-W2b-152; PLT-006, SAL-059): an
/// invitation of the PARTNER audience asks a partner person to the portal of their party, by the office or by the
/// partner's own admin, with the partner roles it gives and an optional end of access; no password is ever set.
model Invitation {
  id          String    @id @db.Uuid
  tenantId    String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId      String    @db.Uuid
  /// The address it was sent to.
  email       String
  /// SHA-256 (hex) of the link's token.
  tokenHash   String    @unique
  /// Who invited; null for the first owner, invited at tenant set-up.
  invitedById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  /// W2b (B-W2b-152): the invited person's audience (the guards hold it equal to the user's). Never changes.
  audience        UserAudience @default(OFFICE)
  /// The invited person's party, set exactly on a PARTNER invitation (equal to the user's). Never changes.
  partyId         String?      @db.Uuid
  /// The keys of the partner roles (Role.key, audience PARTNER) the acceptance gives, each once; at least one on a PARTNER
  /// invitation, none on an office one. The API keeps them within the party's PortalSettings (allowed roles, max users).
  /// Changed only while the invitation is open.
  partnerRoleKeys String[]     @default([])
  /// The end of access the acceptance gives the partner person (PLT-022); null: none. Only on a PARTNER invitation, after
  /// it was made. Changed only while the invitation is open.
  accessUntil     DateTime?    @db.Timestamptz(3)

  user      User  @relation("InvitedUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy User? @relation("InvitedBy", fields: [tenantId, invitedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b: the party a partner invitation is for.
  party     Party? @relation("InvitationParty", fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, partyId])
}

/// A single-use link to set a new password (PLT-070), asked for by the person or required by an administrator.
model PasswordReset {
  id        String            @id @db.Uuid
  tenantId  String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId    String            @db.Uuid
  /// SHA-256 (hex) of the link's token.
  tokenHash String            @unique
  kind      PasswordResetKind
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
}

enum PasswordResetKind {
  /// The person asked for a link (forgot the password).
  REQUESTED
  /// A sign-in found that an administrator required a new password; the link comes with that answer.
  REQUIRED
}
