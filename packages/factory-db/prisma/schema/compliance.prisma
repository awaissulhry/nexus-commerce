// Compliance (plan A1 §2.4 B; PLAN §2.8 "PPE"; features QHS-103, PRD-270, PRD-288, PRD-331): the PPE paperwork of the
// styles under Regulation (EU) 2016/425 — the EU type-examination certificates (EN 17092, EN 1621, EN 13594 …) with
// what they cover, the garment label templates, and the Declarations of Conformity and user information. apps/factory-api's
// modules/compliance writes them (B-W1-12, 19, 20), always through command().
//
// Who is the maker (PLAN §2.8): with a brand label the brand is the legal PPE maker (the certificate holder, the name on
// the label and the DoC); otherwise our company. Both cases use the same rows.
//
// Kept and frozen (Reg. 2016/425 art. 8(3): technical documentation and the DoC kept 10 years): no role deletes a row of
// this file. A certificate, a label template or a compliance document is typed in as DRAFT and edited freely; once
// registered (VALID), activated (ACTIVE) or issued (ISSUED) only its status moves (the …_product_guards triggers, for
// every login, the owner included): a new or extended certificate, a changed label, a new DoC is a new row. Their
// files (the certificate PDF, the signed DoC, the leaflet) are StoredFile rows of the record (recordType "Certificate" or
// "ComplianceDocument", kind CERTIFICATE or DOCUMENT).
//
// Who sees what (ownership/compliance.json): the office reads and writes; the floor reads the certificates, their
// coverage and the label templates (garment labels are printed at the final operation behind the certificate gate,
// B-W1-44); portal and link sessions read none of it (the DoC reaches a customer as a file through a link, B-W1-49).

/// An EU type-examination certificate (QHS-103; Reg. 2016/425 Annex V, module B) or a protector's or material's
/// certificate, from a notified body. Its validity dates are required and span at most five years. DRAFT while typed in;
/// VALID ⇄ SUSPENDED; WITHDRAWN and EXPIRED are final. A VALID certificate covering the style, colourway and size is the
/// gate for labels, release and shipping (A1 §2.5).
model Certificate {
  id                 String            @id @db.Uuid
  tenantId           String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company that holds it (the manufacturer it names); null when a brand holds it (holderPartyId) for every
  /// company of the tenant that makes for that brand.
  companyId          String?           @db.Uuid
  /// The brand that holds it (PLAN §2.8: with a brand label the brand is the legal maker); null: the company holds it.
  holderPartyId      String?           @db.Uuid
  /// The harmonised standard with its edition ("EN 17092-4:2020", "EN 1621-1:2012").
  standard           String
  /// The class or level it grants (EN 17092: AAA, AA, A, B, C; EN 1621: 1 or 2).
  ppeClass           String?
  /// The certificate's number as the notified body wrote it.
  number             String
  notifiedBodyName   String
  /// The notified body's four-digit identification number (NANDO).
  notifiedBodyNumber String
  /// The model or type designation the certificate names, as written on it.
  modelReference     String?
  /// The first and last day it is valid (required; at most five years apart).
  validFrom          DateTime          @db.Date
  validTo            DateTime          @db.Date
  status             CertificateStatus @default(DRAFT)
  /// Why it was suspended or withdrawn, as the notified body wrote it.
  statusReason       String?
  statusChangedAt    DateTime?         @db.Timestamptz(3)
  note               String?
  /// W2a (QHS-105, B-W2a-66): the certificate that renews it (the notified body's new one for the same holder, valid
  /// from a later day); set once, when the renewal arrives, never changed after (the …_supply_w2a_guards trigger). A
  /// certificate renews at most one.
  successorId        String?           @db.Uuid
  /// W2b-4 (schema wave 30/33, B-W2b-216; PRD-286, PRD-287, PRD-290): the notified body from the directory (its number
  /// is the typed `notifiedBodyNumber`, which W1 keeps with the typed name); the performance levels the certificate grants
  /// beyond its class, one level per property ({ "level": "2", "knuckle": "KP" } for EN 13594, { "shoulder": "2" } for
  /// EN 1621-1); and, for an own-brand certificate a brand holds for a private-label style, the factory's base certificate
  /// it rests on (held by a company, with no base of its own). Free while DRAFT; once registered each may be filled in
  /// once (from null) and never changes after (the …_compliance_rules_w2b_guards trigger).
  notifiedBodyId     String?           @db.Uuid
  performanceLevels  Json?
  baseCertificateId  String?           @db.Uuid
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?           @db.Uuid

  company             Company?              @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  holderParty         Party?                @relation(fields: [tenantId, holderPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  coverage            CertificateCoverage[]
  complianceDocuments ComplianceDocument[]
  // W2b-4 techfiles.prisma (wave 32/33): the technical files that support it.
  technicalFiles      TechnicalFile[]
  // W2a: the renewal (successor) and the certificate it renews; the changes to its approved type under review.
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId.
  successor           Certificate?          @relation("CertificateRenewal", fields: [tenantId, successorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  renews              Certificate?          @relation("CertificateRenewal")
  typeChangeReviews   TypeChangeReview[]
  // W2b inspection-plans.prisma (wave 10/16): the incoming component checks made against it.
  incomingComponentResults IncomingComponentResult[]
  // W2b-4 samples.prisma (wave 29/33): the certification sample rounds that led to it.
  sampleRounds        SampleRound[]
  // W2b (schema wave 2/7): its renewals' application log, and the renewals it is the new certificate of.
  renewalLog          CertificateRenewal[]  @relation("CertificateRenewalOf")
  renewalLogAsNew     CertificateRenewal[]  @relation("CertificateRenewalNew")
  // W2b-4 compliance-rules.prisma (wave 30/33): its notified body from the directory; an own-brand certificate's base
  // certificate and the own-brand certificates resting on this one. Restrict, not Prisma's SetNull default for an
  // optional relation: that would also clear tenantId.
  notifiedBody         NotifiedBody?        @relation(fields: [tenantId, notifiedBodyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  baseCertificate      Certificate?         @relation("CertificateOwnBrandBase", fields: [tenantId, baseCertificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  ownBrandCertificates Certificate[]        @relation("CertificateOwnBrandBase")

  // One row per certificate of a notified body.
  @@unique([tenantId, notifiedBodyNumber, number])
  // W2a: a certificate is renewed by at most one (a NULL successor repeats freely).
  @@unique([tenantId, successorId])
  // The target of the tenant-safe references from its coverage and the documents that cite it.
  @@unique([tenantId, id])
}

enum CertificateStatus {
  /// Being typed in; covers nothing yet.
  DRAFT
  VALID
  /// The notified body suspended it; it covers nothing until VALID again.
  SUSPENDED
  WITHDRAWN
  /// Past its validTo (the scheduler moves it).
  EXPIRED
}

/// What a certificate covers (QHS-103, PRD-288): one style (in some of its colourways and sizes, or all), or one item (a
/// protector, a material it was tested with). Exactly one of styleId and itemId (the …_product_guards trigger). One row
/// per certificate and style or item (the compliance module keeps it so); an end of coverage is ARCHIVED.
model CertificateCoverage {
  id                  String       @id @db.Uuid
  tenantId            String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  certificateId       String       @db.Uuid
  styleId             String?      @db.Uuid
  itemId              String?      @db.Uuid
  /// The style's colourways it covers; empty: all of them.
  colourwayIds        String[]     @default([]) @db.Uuid
  /// The style's size codes it covers; empty: its whole range.
  sizes               String[]     @default([])
  /// Made-to-measure single units built on the covered style are covered while the rider's measures fall inside the
  /// body measures of the covered sizes (PRD-288; Reg. 2016/425 Annex III).
  allowsMadeToMeasure Boolean      @default(false)
  /// W2b-4 (schema wave 30/33, B-W2b-216; QHS-106): a bought-in part's coverage (an item's only): the supplier it buys the
  /// certified part from (a party with the SUPPLIER role) and that supplier's article code as the certificate names it.
  /// The supplier is named once (it may be filled in on an older coverage) and never changes after; the article code only
  /// with a supplier.
  supplierPartyId     String?      @db.Uuid
  supplierArticleCode String?
  note                String?
  status              MasterStatus @default(ACTIVE)
  version             Int          @default(1)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById         String?      @db.Uuid

  certificate Certificate @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // product.prisma.
  style       Style?      @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  item        Item?       @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-4 (wave 30/33): a bought-in part's supplier (parties.prisma). Restrict, not Prisma's SetNull default for an
  // optional relation: that would also clear tenantId.
  supplierParty Party?    @relation("CertificateCoverageSupplier", fields: [tenantId, supplierPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, certificateId])
  // The gate asks: which certificates cover this style (or item)?
  @@index([tenantId, styleId])
  @@index([tenantId, itemId])
}

/// A garment label template (PRD-331; Reg. 2016/425 art. 8(5)(6), art. 17; Reg. (EU) 1007/2011): the sewn-in label's
/// layout and fixed content, per style or shared by several. Revised, never edited once ACTIVE: a style revision points
/// at the template revision its units carry. DRAFT → ACTIVE → RETIRED.
model LabelTemplate {
  id                 String              @id @db.Uuid
  tenantId           String              @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data (A1 §2.1).
  companyId          String?             @db.Uuid
  code               String
  /// 1, 2, 3 … per code.
  revision           Int
  name               String
  /// The style it is for; null: shared by several styles.
  styleId            String?             @db.Uuid
  status             LabelTemplateStatus @default(DRAFT)
  /// The languages it prints, ISO 639-1, in order.
  languages          String[]            @default([])
  /// The legal maker it names (art. 8(6): name, trade name or mark, postal address): a brand party with a brand label,
  /// else our company (makerPartyId null); the name and address as printed.
  makerPartyId       String?             @db.Uuid
  makerName          String
  makerAddress       String
  /// The importer, when the maker is outside the EU (art. 10(3)).
  importerName       String?
  importerAddress    String?
  /// The fibre composition per part (Reg. 1007/2011), percentages as decimal strings:
  /// [{ "part": "lining", "fibres": [{ "fibre": "polyester", "percent": "100" }] }].
  composition        Json?
  /// Prints "Contains non-textile parts of animal origin" (Reg. 1007/2011 art. 12) in its languages.
  animalOriginPhrase Boolean             @default(false)
  /// Care symbols (ISO 3758) and their text: [{ "symbol": "wash-not", "text": { "en": "Do not wash" } }].
  care               Json?
  /// What the builder places where (B-W1-19): CE mark, model, batch or serial, size with its body measures, the EN 17092
  /// pictogram with the class, the standard; the printed values come from the style, size, certificate and unit.
  layout             Json
  widthMm            Decimal             @db.Decimal(6, 2)
  heightMm           Decimal             @db.Decimal(6, 2)
  /// W2b-4 (schema wave 32/33, B-W2b-218): what the label is (PRD-336): W1's PPE garment label, a glove marking (EN 13594),
  /// a fibre and care label (Reg. (EU) 1007/2011) or a packaging label. Like the other columns, fixed once out of DRAFT
  /// (…_techfiles_labels_w2b_guards).
  kind               LabelTemplateKind   @default(PPE_GARMENT)
  /// The GPSR contact it prints on a consumer product that is not PPE (PRD-346; Reg. (EU) 2023/988 art. 9(6)): the maker's
  /// postal and electronic address as printed; null: none.
  gpsrContact        String?
  /// Where its QR code points (PRD-349): nowhere, the public DoC page of the garment's batch, or of its style (B-W2b-166).
  qrTarget           LabelQrTarget       @default(NONE)
  /// The origin claim it prints, as the key of its phrase ("claim.made-in-italy"; B-W2b-208's need, checked by B-W2b-253);
  /// null: none.
  originClaimKey     String?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?             @db.Uuid

  company        Company?        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // product.prisma.
  style          Style?          @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  makerParty     Party?          @relation(fields: [tenantId, makerPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  styleRevisions StyleRevision[]
  // W2b-4 styles-depth.prisma (wave 26/33): the product types whose default label template it is.
  productTypeProfiles ProductTypeProfile[]
  // production.prisma: the work orders released with it.
  workOrders     WorkOrder[]
  // W2b-4 techfiles.prisma (wave 32/33): its artwork versions.
  artworkVersions LabelArtworkVersion[]

  @@unique([tenantId, code, revision])
  // The target of the style revisions' reference.
  @@unique([tenantId, id])
}

enum LabelTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// W2b-4 (schema wave 32/33): what a label template is (PRD-336).
enum LabelTemplateKind {
  /// The sewn-in label of a PPE garment (W1's, art. 17).
  PPE_GARMENT
  /// The marking of a glove (EN 13594).
  GLOVE_MARKING
  /// A fibre composition and care label (Reg. (EU) 1007/2011; ISO 3758).
  FIBRE_CARE
  /// A packaging label.
  PACKAGING
}

/// W2b-4 (schema wave 32/33): where a label's QR code points (PRD-349; B-W2b-166's public DoC addresses).
enum LabelQrTarget {
  /// No QR code.
  NONE
  /// The public DoC page of the garment's batch (its work order's code).
  BATCH_DOC
  /// The public DoC page of the style (its current declaration).
  STYLE_DOC
}

/// A Declaration of Conformity (Reg. 2016/425 art. 15, Annex IX) or the user information leaflet (Annex II 1.4) of a
/// style, in one language, by revision. Its data is what Annex IX asks; its signed PDF or leaflet is its file. DRAFT →
/// ISSUED (frozen) → SUPERSEDED by a newer revision, or WITHDRAWN. The DoC goes with the goods (art. 8(8), B-W1-49).
model ComplianceDocument {
  id                    String                   @id @db.Uuid
  tenantId              String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide (A1 §2.1).
  companyId             String?                  @db.Uuid
  styleId               String                   @db.Uuid
  kind                  ComplianceDocumentKind
  /// ISO 639-1.
  language              String
  /// 1, 2, 3 … per style, kind and language.
  revision              Int
  /// The reference printed on it (the DoC number).
  number                String?
  status                ComplianceDocumentStatus @default(DRAFT)
  /// The EU type-examination certificate it cites, with its notified body (Annex IX 7).
  certificateId         String?                  @db.Uuid
  /// The maker (Annex IX 2): a brand party with a brand label, else our company; the name and address as printed.
  makerPartyId          String?                  @db.Uuid
  makerName             String
  makerAddress          String
  /// The PPE it covers: product, type, batch or serial range (Annex IX 1 and 4).
  productIdentification String?
  /// The harmonised standards it declares, with their editions (Annex IX 6).
  standards             String[]                 @default([])
  /// Signed for and on behalf of (Annex IX 8): who, their function, where and on which day.
  signedByName          String?
  signedByFunction      String?
  signedPlace           String?
  signedOn              DateTime?                @db.Date
  /// When it was issued; set exactly from ISSUED on.
  issuedAt              DateTime?                @db.Timestamptz(3)
  /// W2b-4 (schema wave 32/33, B-W2b-218; GATE-PPE-TEXTS, Owner answers 11-09): SIGNED (W1's: the data typed in and the
  /// signed PDF or leaflet as its file, the live route) or GENERATED (made from the records by B-W2b-257 / B-W2b-258). A
  /// generated document stays a DRAFT (or is withdrawn) until a PPE consultant has checked the generated texts: the database
  /// refuses it any other status. W2b-5 (schema wave 34/44, B-W2b-275): that yes is a PpeTextApproval (ppe-texts.prisma); a
  /// generated document is made a DRAFT and leaves DRAFT (to be issued) only while a live approval of its template
  /// (content.template or sections.template = `<templateKey>.<templateVersion>`) covers its language and its company. Fixed
  /// when made. Every column below is fixed once out of DRAFT, like W1's (…_techfiles_labels_w2b_guards).
  origin                ComplianceDocumentOrigin @default(SIGNED)
  /// A DoC's Annex IX points with their words and where each value came from (PRD-292): { "points": [{ "point": "1",
  /// "text": "…", "source": { "kind": "CERTIFICATE", "recordType": "Certificate", "recordId": "…" } }] } (kind TYPED: typed
  /// by a person). A DECLARATION_OF_CONFORMITY only; required when GENERATED.
  content               Json?
  /// The user information's sections (Annex II 1.4; PRD-350, PRD-353, PRD-354), each with where it came from, the protector
  /// positions and the compatible spare protectors: { "sections": [{ "key": "storage", "text": "…", "source": { … } }],
  /// "protectorPositions": [{ "zone": "shoulder", … }], "spareProtectors": [{ "name": "…", … }] }. A USER_INFORMATION only;
  /// required when GENERATED.
  sections              Json?
  /// The document it translates (PRD-293, PRD-351): an original (not itself a translation) of the same style and kind in
  /// another language; null: an original.
  translationOfId       String?                  @db.Uuid
  /// A translation's state, exactly with translationOfId: DRAFT → IN_TRANSLATION → CHECKED; CHECKED by a person other than
  /// its author (translationCheckedAt and translationCheckedById, set exactly while CHECKED), and a translation is issued
  /// only CHECKED. Its words change only with the check undone.
  translationStatus     ComplianceTranslationStatus?
  translationCheckedAt  DateTime?                @db.Timestamptz(3)
  translationCheckedById String?                 @db.Uuid
  /// The market whose language pack it is (MarketProfile.code: "DE", "CH"; PRD-351); null: every market of its language.
  marketCode            String?
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  createdById           String?                  @db.Uuid

  company     Company?     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // product.prisma.
  style       Style        @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  certificate Certificate? @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  makerParty  Party?       @relation(fields: [tenantId, makerPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-4 (schema wave 32/33): the original it translates (of the same style) and its translations; the batches and shipments
  // that went with it (techfiles.prisma). Restrict, not Prisma's SetNull default for an optional relation: that would also
  // clear tenantId and styleId.
  translationOf ComplianceDocument?       @relation("ComplianceDocumentTranslation", fields: [tenantId, styleId, translationOfId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  translations  ComplianceDocument[]      @relation("ComplianceDocumentTranslation")
  batches       ComplianceDocumentBatch[]

  // W2b-4 (schema wave 32/33): the origin is part of the key, so one GENERATED draft sits beside the SIGNED document of the
  // same style revision, kind and language (GATE-PPE-TEXTS: the signed one stays the live route).
  @@unique([tenantId, styleId, kind, language, revision, origin])
  // W2b-4: the target of a translation's and a batch record's style-safe reference.
  @@unique([tenantId, styleId, id])
}

/// W2b-4 (schema wave 32/33): who made a compliance document.
enum ComplianceDocumentOrigin {
  /// Typed in, with the signed PDF or leaflet uploaded as its file (W1).
  SIGNED
  /// Generated from the records (B-W2b-257, B-W2b-258): a draft until GATE-PPE-TEXTS.
  GENERATED
}

/// W2b-4 (schema wave 32/33): a translation's state (PRD-293).
enum ComplianceTranslationStatus {
  DRAFT
  IN_TRANSLATION
  CHECKED
}

enum ComplianceDocumentKind {
  /// The EU Declaration of Conformity (Annex IX).
  DECLARATION_OF_CONFORMITY
  /// The manufacturer's information leaflet (Annex II 1.4).
  USER_INFORMATION
}

enum ComplianceDocumentStatus {
  DRAFT
  ISSUED
  SUPERSEDED
  WITHDRAWN
}

/// A change to the approved type of a certified style (PRD-285; Reg. (EU) 2016/425 Annex V 7.2): a new revision of the
/// style changes something the certificate's type examination covered (the outer leather, its thickness, a protector
/// model, seams, the lining). The maker tells the notified body, which approves it as an addition to the certificate or
/// asks for a new examination; or compliance decides, with its reason, that the change needs no notification. Until the
/// review is APPROVED or NOT_NEEDED the revision's garments do not print their class label (B-W2a-66). Kept and never
/// deleted (Reg. 2016/425 art. 8(3)); the notified body's answer is its file (StoredFile recordType "TypeChangeReview").
model TypeChangeReview {
  id                 String                 @id @db.Uuid
  tenantId           String                 @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  styleId            String                 @db.Uuid
  /// The style's revision that changes (usually its DRAFT; once released, frozen like any revision).
  revisionId         String                 @db.Uuid
  /// The certificate whose approved type it may change: one that covers the style.
  certificateId      String                 @db.Uuid
  /// The certified revision it is compared with (the one the type examination saw), when known; not `revisionId`.
  comparedRevisionId String?                @db.Uuid
  /// What changed against the certified revision, found when the review was opened; changes only while OPEN:
  /// [{ "kind": "OUTER_LEATHER" | "THICKNESS" | "PROTECTOR" | "SEAMS" | "LINING" | "OTHER", "what": "Outer leather",
  ///    "before": "SEED-LEA-100 1.1-1.3 mm", "after": "SEED-LEA-110 1.0-1.2 mm", "bomLineId": "…" }].
  changes            Json                   @default("[]")
  status             TypeChangeReviewStatus @default(OPEN)
  /// When the notified body was told: set in the move to NOTIFIED, kept after.
  notifiedAt         DateTime?              @db.Timestamptz(3)
  /// The notified body's answer: when it came and its reference (the addition's number); set exactly in APPROVED and
  /// REFUSED.
  answeredAt         DateTime?              @db.Date
  answerReference    String?
  /// The final decision (APPROVED, REFUSED, NOT_NEEDED): when, by whom and why (required for NOT_NEEDED).
  decidedAt          DateTime?              @db.Timestamptz(3)
  decidedById        String?                @db.Uuid
  decisionNote       String?
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?                @db.Uuid

  // product.prisma: the style and its two revisions (the same style's).
  style            Style          @relation(fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  revision         StyleRevision  @relation("TypeChangeReviewRevision", fields: [tenantId, styleId, revisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and styleId.
  comparedRevision StyleRevision? @relation("TypeChangeReviewComparedRevision", fields: [tenantId, styleId, comparedRevisionId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  certificate      Certificate    @relation(fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // A revision's reviews, and a certificate's.
  @@index([tenantId, revisionId])
  @@index([tenantId, certificateId])
}

/// OPEN → NOTIFIED | NOT_NEEDED; NOTIFIED → APPROVED | REFUSED. APPROVED, REFUSED and NOT_NEEDED are final.
enum TypeChangeReviewStatus {
  /// Found; compliance decides whether the notified body must be told.
  OPEN
  /// The notified body was told; its answer is awaited.
  NOTIFIED
  /// The notified body approved it: an addition to the certificate.
  APPROVED
  /// The notified body did not: the changed revision needs a new type examination.
  REFUSED
  /// Compliance decided the change does not affect the approved type (with its reason).
  NOT_NEEDED
}

/// STARTED → APPLIED | RENEWED | CANCELLED; APPLIED → RENEWED | CANCELLED. RENEWED and CANCELLED are final.
enum CertificateRenewalStatus {
  /// The renewal is started: the task with its checklist is made.
  STARTED
  /// The application reached the notified body.
  APPLIED
  /// The new certificate is linked (Certificate.successorId).
  RENEWED
  /// Given up (the style is no longer made, another body certifies it …).
  CANCELLED
}

/// W2b (schema wave 2/7, B-W2b-02; QHS-105, PRD-283; B-W2a-66's gap "a renewal has no table"; design
/// compliance.certificates › Renewals "Validity and renewal"): the application log of one renewal of a certificate,
/// queryable instead of the certificate's audit rows: started (the window it was started in, the task carrying its
/// checklist), applied (the day the application reached the notified body, its reference, in the window or late), renewed
/// (the new certificate, which Certificate.successorId names too) or cancelled. Its steps' times are set once; a renewed or
/// cancelled renewal never changes; never deleted. One open renewal per certificate is the API's rule (the certificate's
/// version), not a key.
model CertificateRenewal {
  id                   String                   @id @db.Uuid
  tenantId             String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  certificateId        String                   @db.Uuid
  status               CertificateRenewalStatus @default(STARTED)
  /// The renewal window when it was started (12 to 6 months before the certificate's end, PRD-283): its first and last
  /// day (first ≤ last).
  windowOpensOn        DateTime                 @db.Date
  windowClosesOn       DateTime                 @db.Date
  /// The platform task that carries its checklist (collab.prisma Task on the certificate; no reference: a task has no
  /// tenant-safe target), named once, and the language its steps were written in (two letters).
  taskId               String?                  @db.Uuid
  language             String                   @default("it")
  startedAt            DateTime                 @db.Timestamptz(3)
  startedById          String?                  @db.Uuid
  /// Applied: the day the application reached the notified body (never after the day it was recorded), its reference and
  /// a note, whether that day was inside the window, and when and by whom it was recorded. Set together, once, when it
  /// becomes APPLIED; kept after.
  appliedOn            DateTime?                @db.Date
  applicationReference String?
  applicationNote      String?
  appliedInWindow      Boolean?
  appliedAt            DateTime?                @db.Timestamptz(3)
  appliedById          String?                  @db.Uuid
  /// RENEWED: the new certificate (another one of the tenant), when and by whom it was linked.
  newCertificateId     String?                  @db.Uuid
  renewedAt            DateTime?                @db.Timestamptz(3)
  renewedById          String?                  @db.Uuid
  /// CANCELLED: when, by whom and why.
  cancelledAt          DateTime?                @db.Timestamptz(3)
  cancelledById        String?                  @db.Uuid
  cancelReason         String?
  note                 String?
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?                  @db.Uuid

  certificate    Certificate  @relation("CertificateRenewalOf", fields: [tenantId, certificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId.
  newCertificate Certificate? @relation("CertificateRenewalNew", fields: [tenantId, newCertificateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // A certificate's renewals, newest first; the open ones.
  @@index([tenantId, certificateId, status])
  @@index([tenantId, newCertificateId])
}
