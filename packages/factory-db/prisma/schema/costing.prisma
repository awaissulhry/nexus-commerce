// Costing (plan §2.4 B-W1-16, A1 §2.6; features FIN-001, FIN-004, FIN-005, PRD-125): what the style cost sheet prices a
// routing's standard minutes with, and its overhead rule. The sheet itself is computed when it is asked for, from a
// revision's BOM and routing (apps/factory-api's modules/costing, factory-domain costing): nothing here stores a cost
// sheet (a quote keeps its own snapshot, QuoteLine.costSnapshot). apps/factory-api's modules/costing writes these rows,
// always through command().
//
// Tenant-wide (companyId null) or one company's: a company's own row wins for that company's sheets (A1 §2.1).
//
// Who sees what (ownership/costing.json): the office reads and writes; the floor, portal and link sessions read none of
// it (a cost per minute is a cost: A1 §2.6; and no floor or portal screen needs it). Rates are archived, never deleted.

/// The cost of one standard minute at a kind of work centre (FIN-004, FIN-005, PRD-125): labour = minutes × cost per
/// minute ÷ (planned efficiency ÷ 100). A new rate is a new row from a day (validFrom); the sheet uses the newest ACTIVE
/// one in force, the company's own before the tenant-wide one. The hand-written …_costing_guards migration keeps one
/// tenant-wide rate per kind and day (a partial unique index Prisma cannot express) and the figures in range.
model LabourRate {
  id                   String         @id @db.Uuid
  tenantId             String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide, for every company of the tenant (A1 §2.1).
  companyId            String?        @db.Uuid
  /// The department: the kind of work centre a routing step names.
  workCentreKind       WorkCentreKind
  /// The cost of one standard minute, in `currency`; 0 or more. Never shown to the floor, a portal or a link.
  /// @grain cost
  costPerMinute        Decimal        @db.Decimal(18, 6)
  /// ISO 4217; the cost sheet is in its company's currency, and a rate in another one is listed as missing.
  currency             String         @default("EUR")
  /// The share of the standard minutes the work centre is planned to achieve, percent: above 0, at most 200.
  plannedEfficiencyPct Decimal        @default(100) @db.Decimal(7, 4)
  /// The first day (Europe/Rome) the rate is in force.
  validFrom            DateTime       @db.Date
  /// Where the figure comes from (a payroll month, an accountant's sheet), as the office writes it.
  note                 String?
  /// owb-pd2w (order workflow build, S4 schema wave "routes"; build brief owb-pd-server 2.1, 2.5): the department the rate is
  /// for; when set, it wins over its kind's rate for a route step in that department (the cost sheet's LABOUR line). A
  /// department of the tenant, of the rate's company or the whole factory (a tenant-wide rate: one of the whole factory), of
  /// the rate's kind of work centre; never changes (…_product_routes_guards: LabourRate_department_check). Null: the kind's
  /// rate (every rate before the wave). One rate per company (or the whole factory), kind, department and day: the unique key
  /// below and the partial uniques of …_costing_guards and …_product_routes_guards.
  departmentId         String?        @db.Uuid
  status               MasterStatus   @default(ACTIVE)
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?        @db.Uuid

  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // owb-pd2w: its department (product.prisma; Restrict, not Prisma's SetNull default for an optional relation: that would also
  // clear tenantId).
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // One company rate per kind, department and day. owb-pd2w: the department joined the key (two departments of one kind, as
  // Pattern and Cutting, have their own rates on the same day); a NULL department does not count in it, so a company's kind
  // rate per day is the partial unique LabourRate_one_company_rate_per_kind_and_day and a tenant-wide one
  // LabourRate_one_tenant_rate_per_kind_and_day / …_per_department_and_day (…_costing_guards, …_product_routes_guards).
  @@unique([tenantId, companyId, workCentreKind, departmentId, validFrom])
  // The sheet's read: the rates of a kind for a company and the tenant-wide ones.
  @@index([tenantId, workCentreKind, validFrom])
}

/// The costing settings of a company, or the tenant-wide ones (FIN-001; the design's "overhead rule from Finance
/// settings"): the overhead percentage the cost sheet adds on material + labour.
/// W2a adds the costing method (standard, moving average or FIFO; c.c. art. 2426) and its lock. The row's id is the company's id, or
/// the tenant's own id for the tenant-wide row, so there is at most one of each (as ShippingSettings is keyed by its
/// site). No row: the sheet has no overhead line.
model CostingSettings {
  /// The company's id; the tenant's id for the tenant-wide row (companyId null).
  id          String   @id @db.Uuid
  tenantId    String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// null: the tenant-wide settings.
  companyId   String?  @db.Uuid
  /// Percent on material + labour, 0 to 100.
  overheadPct Decimal  @default(0) @db.Decimal(7, 4)
  /// W2a (FIN-033, c.c. art. 2426; design finance.settings "Costing"): the costing method, the accountant's choice
  /// (GATE-ACCOUNTANT); UNDECIDED until it is given (cost-ledger.prisma CostingMethod). Locked once a value relies on it.
  /// @not-money which method values stock and work orders, not an amount
  costingMethod    CostingMethod @default(UNDECIDED)
  /// Set once, together, when the method is first used (a work-order cost entry or a stock value relied on): from then
  /// on the method never changes (the …_money_w2a_guards trigger; the screen holds it "with that reason").
  methodLockedAt   DateTime?     @db.Timestamptz(3)
  methodLockedById String?       @db.Uuid
  /// W2b (schema wave 2/7; B-W2a-21's follow-up "a costing method that is not tied to the overhead row"): true on a
  /// company's row made to hold its costing method only: its overhead is the tenant-wide row's (overheadPct stays 0 and
  /// is not read). false: the row's own overhead (every row before W2b). The tenant-wide row is always false.
  overheadFromTenant Boolean   @default(false)
  /// W2b-6 (schema wave 55/57, B-W2b-378; FIN-006; GATE-PIECE-PAY): labour on the cost sheet uses the piece rate per
  /// operation instead of minutes × the rate. OFF by default; switched on only on a company's own row, and only while a site
  /// of the company has piece pay ON (pay.prisma PiecePaySwitch), with when and by whom (both exactly while on). Off is
  /// always allowed. A PIECE_RATE cost sheet line needs it on (cost-sheets.prisma).
  pieceRateLabour     Boolean   @default(false)
  pieceRateLabourAt   DateTime? @db.Timestamptz(3)
  pieceRateLabourById String?   @db.Uuid
  /// owb-pd2w (order workflow build, S4 "cost Keep"; S4 settle 9, plan § 5 I, R59; build brief owb-pd-server 3.2): "one
  /// person may keep a cost". ON: Keep makes and approves a cost version in ONE command by the same person, with a reason
  /// (CostSheet.keptAloneReason; the API logs it); OFF (the default): Keep sends it for approval (four eyes, as before). Read
  /// on the company's own row only (the cost-sheet guard, redefined in …_product_routes_guards); switched on only there
  /// (CostingSettings_one_keeper_check). The default is the database's (dbgenerated, as Operation.departmentDefault's), so a
  /// Prisma insert leaves the column out.
  oneKeeperAllowed    Boolean   @default(dbgenerated("('false'::text)::boolean"))
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  company Company? @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, companyId])
}

// ── B-OM-019 (order money tab, schema wave "order money 1/1"; lead L2: ADD lines only) ──
//   OrderCostLine  a cost of a sales order typed by hand, one the cost ledger does not know (a freight estimate before the
//                  carrier's charge, a sales commission, bank charges, another): the margin's "now" and "so far" count it
//                  beside the computed cost (apps/factory-api's costing/margins). Append-only but for its removal (the remove
//                  columns, set once, with their reason): never deleted, never changed; never written once the order is
//                  CLOSED or CANCELLED; in the order's currency (…_order_money_guards). Office only (no partner or floor
//                  grant): a cost. The amount and both reasons are the cost grain.

/// A cost of a sales order typed by hand (lead L2: added, never replacing a computed part): kind, amount, why, who; removed once.
model OrderCostLine {
  id           String            @id @db.Uuid
  tenantId     String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's company and customer: the order's own (the foreign key).
  companyId    String            @db.Uuid
  partyId      String            @db.Uuid
  salesOrderId String            @db.Uuid
  kind         OrderCostLineKind
  /// Minor units of `currency`, above 0.
  /// @grain cost
  amount       Int
  /// ISO 4217: the order's currency (the guard).
  currency     String
  /// Why, 3 to 500 trimmed characters (it may name a cost).
  /// @grain cost
  reason       String
  /// The office person who typed it.
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  /// Removed: when, by whom and why (all three, once; null while it counts).
  removedAt    DateTime?         @db.Timestamptz(3)
  removedById  String?           @db.Uuid
  /// @grain cost
  removeReason String?

  // The order's own company and customer.
  order SalesOrder @relation("OrderCostLineOrder", fields: [tenantId, companyId, partyId, salesOrderId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  // An order's lines (its margin).
  @@index([tenantId, salesOrderId])
}

/// What a hand cost line is (shown in words: "Freight estimate", "Commission", "Bank charges", "Other").
enum OrderCostLineKind {
  /// Freight we expect to pay before the carrier's charge is on a shipment.
  FREIGHT_ESTIMATE
  /// A sales agent's or a partner's commission on the order.
  COMMISSION
  /// Bank charges on the order's payments.
  BANK_CHARGES
  /// Another cost of the order, said in its reason.
  OTHER
}
// ── end B-OM-019 ──
