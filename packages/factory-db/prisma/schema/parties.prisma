// Parties (plan A1 §2.4 A; features SAL-001, SAL-003, SAL-004, SAL-005, SAL-006, SCM-001, SAL-285): the customers,
// brands, suppliers, subcontractors, carriers and labour consultants of the tenant. ONE record per business partner, whatever it does for
// us: its roles say so (the old app's PartyKind became a list of roles: one company can be customer AND supplier).
// apps/factory-api's modules/parties writes them (B-W1-07; the measurement profiles B-W1-18), always through command().
//
// Who sees what (plan A1 §2.2): the office reads and writes; a portal or one-off link session
// (factory_partner_runtime) reads only its OWN party (Party by its id, every other table by partyId), never an internal
// note or who in the office wrote a row; the floor reads none of it. Master data in use is archived (status
// ARCHIVED), never deleted: no role deletes a row of this file. ViesCheck is the art. 41 DL 331/1993 proof and is
// append-only (the hand-written …_parties_guards migration's triggers hold it for every login). A measurement profile
// is never edited in place: a change is a new revision (W2b, wave 21/22: the office's update grant moves only when its
// photos are deleted, and a MEASUREMENTS link session inserts the revision the rider sent; the …_portal_sales_w2b_guards
// triggers hold both). W2b schema wave 23: a portal session also inserts a delivery address of its own party that waits for
// the office's check (PartyAddress.approvalStatus WAITING; the …_portal_followups_w2b_guards triggers).
//
// The partyId columns of the W0 modules (OneOffLink, LinkEvidence, Thread, Message, StoredFile, OutboxEvent,
// AuditLog, IdempotencyReceipt) stay plain ids: the ledgers keep the scope a row was written in, and the others' seeds
// and tests still plant made-up parties. A later step can add their tenant-safe references to Party.

/// A business partner of the tenant: a company or a person we sell to, buy from, send work to or ship with.
model Party {
  id           String      @id @db.Uuid
  tenantId     String      @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company it belongs to; null: tenant-wide master data, shared by every company of the tenant (A1 §2.1).
  companyId    String?     @db.Uuid
  /// Short code, unique in the tenant: lists, imports, the portal address /p/<code>.
  code         String
  /// ORGANISATION (a company, team or body) or PERSON (a private rider: the legal name is a person's name, personal
  /// data).
  kind         PartyKind
  /// The registered name, as on its invoices (FatturaPA Denominazione, or Nome + Cognome for a person).
  legalName    String
  tradeName    String?
  /// What it is for us; one or more. Never empty (the parties module checks it).
  roles        PartyRole[] @default([])
  status       PartyStatus @default(ACTIVE)
  /// Where it is established, ISO 3166-1 alpha-2. Its tax country is on its tax identity.
  country      String      @default("IT")
  /// The currency of its documents, ISO 4217.
  currency     String      @default("EUR")
  /// The language of its documents and mail, ISO 639-1.
  language     String      @default("it")
  /// Payment terms as printed on its quotes, orders and purchase orders (free text; terms with rules are W2a).
  paymentTerms String?
  /// As a supplier, its usual lead time: calendar days from the order to the goods at our site, 0 or more (PLN-066).
  /// Planning uses it when the item names none, or the item is bought from it instead of the item's default supplier.
  leadTimeDays Int?
  /// The commercial terms its new quotes and orders start with (SAL-012; design customer.tax.terms): its payment terms
  /// from the library (FIN-075) and its price list (SAL-165; a discount group is a GROUP list), null: none of its own.
  paymentTermsId       String?            @db.Uuid
  /// @not-money a reference: the price list it is priced from (its prices are PriceListEntry rows)
  priceListId          String?            @db.Uuid
  /// The deposit asked at acceptance, percent of the gross total, above 0 and at most 100; null: the sales settings'.
  defaultDepositPct    Decimal?           @db.Decimal(7, 4)
  /// When its goods are invoiced: per shipment, or once a month for the month's DDTs (FIN-059: one deferred invoice,
  /// TD24, by the 15th of the next month, DPR 633/1972 art. 21 c.4 lett. a).
  invoiceTiming        PartyInvoiceTiming @default(PER_SHIPMENT)
  /// The Incoterms 2020 rule agreed for its sales (EXW, FCA, DAP, DDP …: three capitals), when one is.
  incoterm             String?
  /// The carrier its goods go with by default (the carrier's code, as on a shipment).
  preferredCarrierCode String?
  /// The smallest order it is offered, net, in its currency (minor units), 0 or more; null: none.
  /// @grain price
  minimumOrderAmount   Int?
  /// W2b (schema wave 23, B-W2b-189's gap): its website, as printed on its profile (an http or https address, up to 200
  /// characters); null: none known.
  website              String?
  /// W2b-5 (schema wave 37/44, SAL-021): a rider (a PERSON party) under the team or dealer it rides for (an ORGANISATION
  /// party with the CUSTOMER or BRAND role, not archived, of the rider's company or tenant-wide); null: on its own.
  teamPartyId          String?            @db.Uuid
  /// For the office only: the partner role can neither read nor write it.
  /// @internal
  internalNote String?
  version      Int         @default(1)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?     @db.Uuid

  company             Company?             @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b-5 sales-intake (wave 37/44): the team or dealer a rider rides for, and a team's riders (Restrict, not Prisma's
  // SetNull default for an optional relation: that would also clear tenantId).
  team                Party?               @relation("PartyTeam", fields: [tenantId, teamPartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  riders              Party[]              @relation("PartyTeam")
  addresses           PartyAddress[]
  contacts            PartyContact[]
  taxIdentities       PartyTaxIdentity[]
  measurementProfiles MeasurementProfile[]
  // W2b people.prisma (wave 4/7): as an agency, the agency workers it employs.
  agencyEmployees     Employee[]           @relation("EmployeeAgency")
  // W2b people.prisma: the companies whose labour consultant it is.
  consultantSettings  PeopleSettings[]     @relation("PeopleSettingsConsultant")
  // W2b-4 changes.prisma and samples.prisma (wave 29/33): the change requests it asked, the sample rounds made for it, the
  // swatches and sample shipments sent to it, the gates of its orders.
  styleChangeRequests ChangeRequest[]
  sampleRounds        SampleRound[]
  sampleSwatches      SampleSwatch[]
  sampleShipments     SampleShipment[]
  orderGates          OrderGate[]
  // W2b auth.prisma, portal-auth.prisma, privacy.prisma (wave 17/22): its partner users, their portal sessions and the
  // office previews of its portal, their invitations, its portal settings, its people's acknowledgements of the terms.
  portalUsers         User[]               @relation("UserParty")
  portalSessions      Session[]            @relation("SessionParty")
  portalPreviews      Session[]            @relation("SessionPreviewOfParty")
  portalInvitations   Invitation[]         @relation("InvitationParty")
  portalSettings      PortalSettings[]
  partnerNoticeAcks   PartnerNoticeAck[]
  // product.prisma: the items it supplies by default, the styles made for it as a brand, the BOM lines bought from it.
  suppliedItems       Item[]
  brandStyles         Style[]
  // W2b-4 options.prisma (wave 28/33): the BOM lines whose material it sends us (customer-supplied).
  customerSuppliedBomLines BomLine[] @relation("BomLineCustomerSupplied")
  // W2b-5 inventory.prisma, sales-orders-depth.prisma (wave 39/44): the lots of its own material we hold (customer-owned
  // stock), its credit checks.
  ownedLots           Lot[]                @relation("LotOwner")
  creditChecks        CreditCheck[]
  bomLines            BomLine[]
  // W2b-4 styles-depth.prisma (wave 26/33): as a private-label brand, its branding sets.
  brandingSets        BrandingSet[]
  // W2b-4 compliance-rules.prisma (wave 30/33): the economic operator roles it holds and, as a brand, those set for its
  // styles; compliance.prisma: as a supplier, the certified parts it sells us.
  economicOperatorRoles       EconomicOperatorRole[] @relation("EconomicOperatorParty")
  brandEconomicOperatorRoles  EconomicOperatorRole[] @relation("EconomicOperatorBrand")
  suppliedCertificateCoverage CertificateCoverage[]  @relation("CertificateCoverageSupplier")
  // compliance.prisma: as a brand, the certificates it holds and the labels and documents that name it as the maker.
  certificatesHeld    Certificate[]
  labelTemplates      LabelTemplate[]
  complianceDocuments ComplianceDocument[]
  // W2b-4 techfiles.prisma (wave 32/33): as a customer, the evidence packs built for it.
  evidencePacks       EvidencePack[]       @relation("EvidencePackRecipient")
  // email-in.prisma: the mail received from this party's contacts (or its company domain).
  inboundEmails       InboundEmail[]
  // W2b links-depth.prisma (wave 19/22): the records shared with it, the approvals asked of it.
  recordShares        RecordShare[]
  approvalRequests    ApprovalRequest[]
  // W2b portal-frame.prisma (wave 20/22): what we asked of it (its tasks).
  partnerTasks        PartnerTask[]
  // W2b-4 substances.prisma (wave 31/33): the declarations asked of it as a supplier; as a brand, the rules of its RSL.
  supplierDeclarationRequests SupplierDeclarationRequest[]
  substanceRules              SubstanceRule[]
  // sales.prisma: its quotes, sales orders and deposit requests.
  quotes              Quote[]
  salesOrders         SalesOrder[]
  depositRequests     DepositRequest[]
  // W2b portal-sales.prisma (wave 21/22): its order requests from the portal, its card and SEPA payment intents.
  portalOrderRequests PortalOrderRequest[]
  paymentIntents      PaymentIntent[]
  // supply.prisma: as a supplier, its purchase orders and the requirements it is suggested for.
  purchaseOrders       PurchaseOrder[]
  // W2b-5 supply.prisma, buying-depth.prisma (wave 40/44): the purchase orders delivered to it as a third party (a workshop,
  // a customer), and its delivery tolerances as a supplier.
  shipToPurchaseOrders PurchaseOrder[]     @relation("PurchaseOrderShipToParty")
  deliveryTolerances   DeliveryTolerance[] @relation("DeliveryToleranceSupplier")
  materialRequirements MaterialRequirement[] @relation("MaterialRequirementSupplier")
  // W2a supply.prisma, planning.prisma: the firm planned orders that buy from it, the item parameters that prefer it.
  firmRequirements     MaterialRequirement[] @relation("MaterialRequirementFirmSupplier")
  itemPlannings        ItemPlanning[]        @relation("ItemPlanningSupplier")
  // inventory.prisma: as a supplier, the goods received from it and its lots.
  goodsReceipts        GoodsReceipt[]
  lots                 Lot[]
  // quality.prisma: the PPE register's entries it reported.
  ppeRegisterEntries   PpeRegisterEntry[]
  // W2b-4 recall.prisma (wave 33/33): as a customer or distributor, its progress in recalls and the notices it was sent.
  recallProgress       RecallProgress[]    @relation("RecallProgressParty")
  distributorNotices   DistributorNotice[] @relation("DistributorNoticeParty")
  // W2b capa.prisma, ncr.prisma (wave 11/16): the 8Ds written for it and the concessions it was asked.
  capas                Capa[]
  ncrConcessions       NcrConcession[]
  // W2a ncr.prisma, plant.prisma: as a supplier, the nonconformances about its goods and the machines it sold.
  nonconformances      Nonconformance[]
  machines             Machine[]
  // W2b plantcare.prisma (wave 14/16): as an outside body, the check plans and results it does; as a supplier, its dies.
  machineCheckPlans    MachineCheckPlan[]   @relation("MachineCheckPlanOutsideBody")
  machineCheckResults  MachineCheckResult[] @relation("MachineCheckResultOutsideBody")
  clickingDies         ClickingDie[]        @relation("ClickingDieSupplier")
  // money.prisma: the invoices it is the buyer of and the payments it made.
  invoices             Invoice[]
  payments             Payment[]
  // W2a receivables.prisma, payables.prisma (wave 7/7): the refunds paid to it, the reminders it was sent, and as a
  // supplier or subcontractor the invoices it sent.
  refunds              Refund[]
  paymentReminders     PaymentReminder[]
  supplierInvoices     SupplierInvoice[]
  // W2b payables.prisma (schema wave 2/7): the files of several invoices it sent.
  supplierInvoiceFiles SupplierInvoiceFile[]
  // W2b safety.prisma (wave 15/16): the safety roles it holds as an outside contact, the training sessions it gave as the
  // provider, the PPE items it supplies.
  safetyAppointments       SafetyAppointment[] @relation("SafetyAppointmentOutsideParty")
  trainingSessionsProvided TrainingSession[]   @relation("TrainingSessionProvider")
  ppeItemsSupplied         PpeItem[]           @relation("PpeItemSupplier")
  // W2b health.prisma (wave 16/16): the chemicals it supplies.
  chemicalsSupplied        Chemical[]          @relation("ChemicalSupplier")
  // pricing.prisma: its default payment terms and price list (Restrict, not Prisma's SetNull default for an optional
  // relation: that would also clear tenantId).
  termsOfPayment       PaymentTerms?        @relation(fields: [tenantId, paymentTermsId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  /// @not-money the relation to its default price list
  priceList            PriceList?           @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b pricing.prisma: the price lists it was given, each from a day (the Customers tab's "From").
  /// @not-money the relation to its dated price list assignments
  priceListAssignments PartyPriceListAssignment[]
  // returns.prisma, complaints.prisma: its returns, repairs and complaints.
  returnAuthorisations ReturnAuthorisation[]
  repairOrders         RepairOrder[]
  complaints           Complaint[]

  // W2b-5 sales-intake.prisma (wave 37/44): its inquiries, its requirements, holds and terms per company.
  inquiries            Inquiry[]
  customerRequirements CustomerRequirement[]
  holds                PartyHold[]
  companyTerms         PartyCompanyTerms[]

  // calendar.prisma: as a supplier or subcontractor, its calendar (its closed days).
  workCalendars       WorkCalendar[]
  // W2a: as a supplier, its approved sources, the discrepancies of its deliveries and the claims to it; as a
  // workshop, the routing steps it does, its stock locations and its subcontract orders.
  supplierItems           SupplierItem[]
  receiptDiscrepancies    ReceiptDiscrepancy[]
  supplierClaims          SupplierClaim[]
  subcontractedOperations RoutingOperation[]
  subcontractorLocations  Location[]
  // W2b-5 planning-depth.prisma (wave 41/44): as a workshop, the planned subcontract orders for it and its weekly capacity.
  plannedWorkOrders       PlannedWorkOrder[]      @relation("PlannedWorkOrderWorkshop")
  subcontractorCapacities SubcontractorCapacity[] @relation("SubcontractorCapacityWorkshop")
  // W2b inspection-plans.prisma (wave 10/16): as a customer, the AQL profiles assigned to it.
  aqlProfileAssignments   AqlProfileAssignment[]
  subcontractOrders       SubcontractOrder[]
  // W2b portal-supply.prisma (wave 22/22): its answers to the supplier questionnaire.
  questionnaireResponses  SupplierQuestionnaireResponse[]
  // W2b portal-followups.prisma (schema wave 23): the documents it uploaded and the profile changes it asked for.
  supplierDocumentUploads SupplierDocumentUpload[]
  changeRequests          PartyChangeRequest[]
  // W2a schedule.prisma: as a workshop, its slots on the planning board.
  scheduleSlots           ScheduleSlot[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from the party's rows.
  @@unique([tenantId, id])
  // W2b-5 (wave 37/44): a team's riders.
  @@index([tenantId, teamPartyId])
}

enum PartyKind {
  ORGANISATION
  PERSON
}

/// What a party is for us (several at once).
enum PartyRole {
  /// We sell to it: quotes, orders, invoices.
  CUSTOMER
  /// A brand we make for (private label): with a brand label it is the legal PPE maker (PLAN §2.8).
  BRAND
  /// We buy from it: purchase orders.
  SUPPLIER
  /// We send work to it (W2 subcontract orders).
  SUBCONTRACTOR
  /// It carries our goods.
  CARRIER
  /// Our labour consultant: the payroll files go to it (people.prisma PeopleSettings). Neither a customer nor a supplier.
  CONSULTANT
}

/// PROSPECT → ACTIVE ⇄ BLOCKED; ARCHIVED when no longer used (never deleted).
enum PartyStatus {
  PROSPECT
  ACTIVE
  BLOCKED
  ARCHIVED
}

/// When a customer's goods are invoiced (its commercial terms).
enum PartyInvoiceTiming {
  /// Each shipment once it left (with its DDT, or an immediate invoice travelling with the goods).
  PER_SHIPMENT
  /// Once a month, one deferred invoice (TD24) for the month's DDTs.
  MONTHLY
}

/// An address of a party: its registered office, where its invoices go, where goods are delivered or collected. Many
/// per party; one address can serve several uses.
model PartyAddress {
  id              String             @id @db.Uuid
  tenantId        String             @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  partyId         String             @db.Uuid
  /// What the address is used for; one or more. The registered office is FatturaPA's Sede of the party.
  kinds           PartyAddressKind[] @default([])
  /// The name on the address (a warehouse, a workshop, the recipient); null: the party's legal name.
  name            String?
  line1           String
  line2           String?
  postalCode      String
  city            String
  /// The province (Italian two-letter sigla) or region, when the country uses one.
  province        String?
  /// ISO 3166-1 alpha-2.
  country         String
  /// Who to ask for at the address (carrier labels, DDTs). Personal data.
  contactName     String?
  phone           String?
  /// For the carrier or the warehouse: opening hours, dock, access.
  deliveryNotes   String?
  /// The party's default invoice address (an address with BILL_TO). At most one per party: the parties module clears
  /// the old default in the same command and moves the party's version, so two changes cannot both win.
  isDefaultBillTo Boolean            @default(false)
  /// The party's default delivery address (an address with SHIP_TO); at most one per party, as above.
  isDefaultShipTo Boolean            @default(false)
  status          MasterStatus       @default(ACTIVE)
  /// W2b (schema wave 23, B-W2b-157/-190's need; design neworder "Add a new address (waits for our approval)",
  /// portal.customer.account › Delivery addresses): a delivery address a partner user added waits for the office's check.
  /// Null: an address of the office's own, never checked. WAITING → APPROVED | REFUSED, once, by an office user, with when
  /// (and why, refused). A WAITING address is a SHIP_TO address of its party, ACTIVE or archived (taken back), never a
  /// default; a REFUSED one is archived for good. Neither is used for an order: a quote version or a shipment never names
  /// one (a portal order or change request may: the office decides both). A partner session inserts only a WAITING
  /// SHIP_TO address of its own party, asked by one of its active people (the …_portal_followups_w2b_guards triggers).
  approvalStatus    PartyAddressApproval?
  /// Who asked (a partner user of the party: the "added by" the portal shows) and when. Set with WAITING, never changed.
  requestedAt       DateTime?          @db.Timestamptz(3)
  requestedByUserId String?            @db.Uuid
  /// The office's decision: when and by whom (the partner never reads the id), and why it was refused (the customer reads it).
  decidedAt         DateTime?          @db.Timestamptz(3)
  decidedById       String?            @db.Uuid
  refuseReason      String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?            @db.Uuid

  party Party @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (schema wave 23): the partner user who asked for it (Restrict, not Prisma's SetNull default: that would also clear
  // tenantId).
  requestedBy User? @relation("PartyAddressRequestedBy", fields: [tenantId, requestedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // sales.prisma: the quote versions it is the bill-to or ship-to address of.
  quoteVersionsBillTo QuoteVersion[] @relation("QuoteVersionBillTo")
  quoteVersionsShipTo QuoteVersion[] @relation("QuoteVersionShipTo")
  // shipping.prisma: the shipments sent to it.
  shipments           Shipment[]
  // W2b-4 samples.prisma (wave 29/33): the sample shipments sent to it.
  sampleShipments     SampleShipment[]
  // W2b-5 supply.prisma (wave 40/44): the purchase orders delivered to it (a third party's address).
  purchaseOrdersShipTo PurchaseOrder[] @relation("PurchaseOrderShipToAddress")
  // W2b portal-sales.prisma (wave 21/22): the portal order requests and the change requests that ask to deliver there.
  portalOrderRequestsShipTo PortalOrderRequest[] @relation("PortalOrderRequestShipTo")
  orderChangeRequestsShipTo OrderChangeRequest[] @relation("OrderChangeRequestShipTo")

  @@unique([tenantId, partyId, id])
}

/// The office's check of a delivery address a partner user added (W2b schema wave 23): WAITING → APPROVED | REFUSED, once.
enum PartyAddressApproval {
  /// Added in the portal: not used for an order until the office approves it.
  WAITING
  APPROVED
  /// Not accepted (with the reason the customer reads): archived for good.
  REFUSED
}

enum PartyAddressKind {
  /// The registered office (sede legale).
  REGISTERED
  /// Invoices and deposit requests go here.
  BILL_TO
  /// Goods are delivered here (DDT destination, carrier label).
  SHIP_TO
  /// Goods are collected here (a supplier's or subcontractor's ship-from).
  PICKUP
}

/// A person at a party, with what they deal with. Personal data. One person who works for two parties is two contacts.
model PartyContact {
  id          String             @id @db.Uuid
  tenantId    String             @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  partyId     String             @db.Uuid
  /// The person's full name.
  name        String
  /// Trimmed, lower case; the documents and links of their roles go to it, and inbound mail from it matches the party.
  email       String?
  phone       String?
  /// What they deal with; none is a plain contact.
  roles       PartyContactRole[] @default([])
  /// The language they read, ISO 639-1; null: the party's language.
  language    String?
  status      MasterStatus       @default(ACTIVE)
  /// W2b-5 (schema wave 37/44, SAL-022; design customer.contacts.grid "Consent and lawful basis"): why we keep the person's
  /// data (GDPR art. 6(1)); null: not recorded yet. CONSENT needs when and how it was given (consentAt, consentSource: up
  /// to 500 characters, both or neither, not in the future); objectedAt: when the person objected (art. 21) or withdrew
  /// their consent (art. 7(3)), not in the future.
  lawfulBasis    ContactLawfulBasis?
  consentAt      DateTime?          @db.Timestamptz(3)
  consentSource  String?
  objectedAt     DateTime?          @db.Timestamptz(3)
  /// W2b-5 (SAL-022; GDPR art. 17): the erasure, when and by whom (an office user), both or neither, set once, never
  /// cleared. An erased contact is ARCHIVED with its personal fields blanked for good (name '', no e-mail, no phone): the row
  /// stays for the quotes, invoices and DDTs that name it (they keep their own copies), and refuses new personal data.
  erasedAt       DateTime?          @db.Timestamptz(3)
  erasedById     String?            @db.Uuid
  version     Int                @default(1)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?            @db.Uuid

  party               Party                @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  measurementProfiles MeasurementProfile[]
  // W2b-5 sales-intake.prisma (wave 37/44): the inquiries they made.
  inquiries           Inquiry[]
  // email-in.prisma: the mail received from this contact.
  inboundEmails       InboundEmail[]
  // sales.prisma: the quotes sent to them.
  quotes              Quote[]
  // supply.prisma: the purchase orders sent to them.
  purchaseOrders      PurchaseOrder[]
  // W2b safety.prisma (wave 15/16): the safety roles they hold as an outside contact (a consultant RSPP, the doctor).
  safetyAppointments  SafetyAppointment[]
  // returns.prisma, complaints.prisma: the returns they asked for and the complaints they made.
  returnAuthorisations ReturnAuthorisation[]
  complaints          Complaint[]
  // W2b ncr.prisma (wave 11/16): the concessions they were asked.
  ncrConcessions      NcrConcession[]
  // W2b links.prisma, links-depth.prisma (wave 19/22): the links sent to them, the records shared with them, the
  // approvals asked of them.
  oneOffLinks         OneOffLink[]
  recordShares        RecordShare[]
  approvalRequests    ApprovalRequest[]

  // The target of the measurement profiles' reference: a rider is a contact of the profile's own party.
  @@unique([tenantId, partyId, id])
  // Inbound mail: the sender's address → its contact and party.
  @@index([tenantId, email])
}

enum PartyContactRole {
  /// Quotes, order confirmations and their links (a customer's buyer); purchase orders (a supplier's order desk).
  ORDERS
  /// Invoices, deposit requests and payments.
  INVOICES
  /// Certificates, test reports, complaints.
  QUALITY
  /// Tech packs and samples.
  DESIGN
  /// The owner or decision maker.
  OWNER
  /// Wears a made-to-measure garment: the person of a measurement profile.
  RIDER
}

/// A party's tax identity from a date (SAL-005): what an e-invoice to it needs (D.Lgs. 127/2015: the VAT number or
/// codice fiscale, and the SDI recipient code or a PEC address) and its tax mode. A change from a date is a new row;
/// the identity at a date is the row with the newest validFrom on or before it. Issued documents keep their own copy.
model PartyTaxIdentity {
  id               String       @id @db.Uuid
  tenantId         String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  partyId          String       @db.Uuid
  /// The country of tax residence, ISO 3166-1 alpha-2.
  country          String
  /// Which VAT rules apply to it (the FatturaPA builder and the VAT treatment read it).
  taxMode          PartyTaxMode
  /// The VAT number with its VAT prefix (IT…, DE…; EL… for Greece). Null: none (a consumer).
  vatNumber        String?
  /// Codice fiscale: a person's 16 characters or a company's 11 digits. Personal data for a person.
  fiscalCode       String?
  /// Codice destinatario: 7 characters ("0000000" when invoices go to the PEC, or for a consumer without one).
  sdiRecipientCode String?
  /// The PEC address SDI delivers to when there is no recipient code.
  pec              String?
  /// The first day this identity applies.
  validFrom        DateTime     @db.Date
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById      String?      @db.Uuid

  party      Party       @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  viesChecks ViesCheck[]
  // sales.prisma: the quote versions priced with it.
  quoteVersions QuoteVersion[]

  @@unique([tenantId, partyId, validFrom])
  // The target of the VIES checks' reference: a check names its identity's party.
  @@unique([tenantId, partyId, id])
  // Imports and the duplicate warning find a party by its VAT number.
  @@index([tenantId, vatNumber])
}

/// The tax mode of a party (SAL-005).
enum PartyTaxMode {
  /// An Italian business: e-invoice through SDI.
  IT_B2B
  /// An Italian consumer: e-invoice through SDI with the codice fiscale.
  IT_B2C
  /// A business in another EU state: zero-rated intra-EU supply, only with a valid VIES check (art. 41 DL 331/1993).
  EU_B2B
  /// A consumer in another EU state.
  EU_B2C
  /// Outside the EU.
  EXTRA_EU
}

/// One VIES check of a party's VAT number (SAL-006), kept as the proof that the number was valid when a sale was
/// zero-rated (art. 41 DL 331/1993: a valid number is a substantive condition). Written by the parties module (on
/// request, and by the scheduled re-check) in the command of the check; never changed or removed.
/// @append-only
model ViesCheck {
  id                 String          @id @db.Uuid
  tenantId           String          @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The checked identity's party.
  partyId            String          @db.Uuid
  /// The tax identity whose VAT number was checked.
  taxIdentityId      String          @db.Uuid
  /// The company whose VAT number identified the request (VIES gives a consultation number only to an identified
  /// requester); null: an anonymous check.
  companyId          String?         @db.Uuid
  /// The member-state code sent (EL for Greece, XI for Northern Ireland).
  countryCode        String
  /// The number sent, without the member-state code.
  vatNumber          String
  /// The requester's VAT number as sent, with its prefix; null for an anonymous check.
  requesterVatNumber String?
  /// When the request was sent (server time).
  requestedAt        DateTime        @db.Timestamptz(3)
  result             ViesCheckResult
  /// VIES's requestIdentifier: the consultation number, the proof. Null when VIES gave none.
  consultationNumber String?
  /// The name and address as VIES returned them (null when the member state does not give them).
  traderName         String?
  traderAddress      String?
  /// Why the check gave no answer (VIES's fault, e.g. MS_UNAVAILABLE, or the network's); only for ERROR.
  errorCode          String?
  /// SHA-256 (hex) of the raw response body as received; null when none came.
  responseSha256     String?
  /// The request whose command wrote it; its audit rows share it.
  requestId          String
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  /// The office user who asked; null for the scheduled re-check.
  createdById        String?         @db.Uuid

  taxIdentity PartyTaxIdentity @relation(fields: [tenantId, partyId, taxIdentityId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  company     Company?         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // The checks of an identity, newest first (the proof for a sale, the re-check).
  @@index([tenantId, taxIdentityId, requestedAt])
}

enum ViesCheckResult {
  VALID
  INVALID
  /// VIES or the network gave no answer: neither proof nor refusal.
  ERROR
}

/// A rider's body measurements for one garment type (SAL-285), for a made-to-measure unit. Personal data: the rider is
/// told how it is used (GDPR art. 13) before the measurements are recorded. Never edited in place: a change is a new
/// revision that supersedes the previous one; work orders keep the revision they were made from.
model MeasurementProfile {
  id               String   @id @db.Uuid
  tenantId         String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The customer: a private rider (a PERSON party) or the team, dealer or brand that ordered for the rider.
  partyId          String   @db.Uuid
  /// The rider as a contact of the party (role RIDER), when known.
  contactId        String?  @db.Uuid
  /// The rider's name as recorded.
  riderName        String
  /// The garment type the measurements are for: the code of its measurement template (PRD-200).
  garmentType      String
  /// 1, 2, 3 … for the rider and garment type.
  revision         Int
  /// The revision this one replaces (of the same party); null for the first.
  supersedesId     String?  @db.Uuid
  /// The measurements by point of measure, each with its unit, values as decimal strings (no floats):
  /// { "<point code>": { "value": "61.5", "unit": "cm" } }.
  measurements     Json
  /// The standard size it is closest to, when known.
  baseSize         String?
  /// Fit preferences, posture and asymmetry, for the pattern maker; the rider may read them.
  fitNotes         String?
  /// For the office only: the partner role can neither read nor write it.
  /// @internal
  internalNote     String?
  /// When the rider was measured, and by whom (the fitter, the dealer, the rider), as written.
  takenAt          DateTime @db.Timestamptz(3)
  takenBy          String
  /// The privacy notice the rider was given (GDPR art. 13): its reference (the privacy pack keeps the notices) and
  /// when it was given.
  privacyNoticeRef String
  privacyNoticeAt  DateTime @db.Timestamptz(3)
  /// W2b (wave 21/22; SAL-096, SAL-286; design links.measure): a revision the rider sent through a MEASUREMENTS link
  /// (B-W2b-171): the link (of the same party) and when; both or neither. A link session (the partner role) adds a
  /// revision only this way, while the link opens, and names the privacy notice version it showed before the first field
  /// (a published notice of the link's company for people outside it, GDPR art. 13), its privacyNoticeAt no later than
  /// the send.
  submittedViaLinkId String?   @db.Uuid
  submittedAt        DateTime? @db.Timestamptz(3)
  noticeVersionId    String?   @db.Uuid
  /// W2b (wave 21/22; SAL-286): front, side and back in a base layer, for the pattern maker: PHOTO files of category
  /// BODY_PHOTO, three different files. Personal data: the office reads them on the record only.
  photoFrontFileId   String?   @db.Uuid
  photoSideFileId    String?   @db.Uuid
  photoBackFileId    String?   @db.Uuid
  /// W2b (wave 21/22; Owner question 3, recommended 90 days after the garment ships): from when the photos are deleted
  /// (the purge job deletes the photo files, the numbers stay). Set by the office or the system once known (the garment
  /// shipped, the rider asked), moved, never cleared; only on a revision with a photo. The one column of a profile that
  /// changes after it is written.
  photosDeleteAfter  DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  /// The office user who recorded it.
  createdById      String?  @db.Uuid

  party        Party                @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (wave 21/22): the MEASUREMENTS link it came through, the notice shown, its three photos. Restrict, not Prisma's
  // SetNull default for an optional relation: that would also clear tenantId and partyId.
  submittedVia OneOffLink?          @relation("MeasurementProfileSubmittedVia", fields: [tenantId, partyId, submittedViaLinkId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  noticeVersion PrivacyNotice?      @relation("MeasurementProfileNotice", fields: [tenantId, noticeVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photoFront   StoredFile?          @relation("MeasurementProfilePhotoFront", fields: [tenantId, photoFrontFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photoSide    StoredFile?          @relation("MeasurementProfilePhotoSide", fields: [tenantId, photoSideFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  photoBack    StoredFile?          @relation("MeasurementProfilePhotoBack", fields: [tenantId, photoBackFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  contact      PartyContact?        @relation(fields: [tenantId, partyId, contactId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  supersedes   MeasurementProfile?  @relation("MeasurementProfileRevisions", fields: [tenantId, partyId, supersedesId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy MeasurementProfile[] @relation("MeasurementProfileRevisions")
  // sales.prisma: the made-to-measure quote and order lines made to this revision.
  quoteLines      QuoteLine[]
  salesOrderLines SalesOrderLine[]
  // production.prisma: the made-to-measure work order cells made to this revision.
  workOrderSizes  WorkOrderSize[]

  @@unique([tenantId, partyId, riderName, garmentType, revision])
  // The target of the revisions' reference: a revision supersedes one of its own party.
  @@unique([tenantId, partyId, id])
  // W2b (wave 21/22): the photo purge job.
  @@index([tenantId, photosDeleteAfter])
}
