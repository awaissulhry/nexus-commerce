// Files on R2 (plan A1 §3.6, §2.3, §4 "FileStore"; PLAN §2.8; features COL-045, COL-050, PLT-011): every file the
// factory keeps — tech packs, photos, certificates, documents, the fiscal archive — lives in object storage (Cloudflare
// R2, EU jurisdiction; a local folder for local and test), never in the database. This table is the record of each one:
// which record it belongs to, what it is, where it is stored, who may see it and how long it must be kept.
// apps/factory-api/src/platform/files runs the flow: request an upload (type and size checked per kind) → a presigned
// PUT → confirm (the store's HEAD: size, type and SHA-256) → AVAILABLE; a download is a short presigned GET after the
// audience check; a delete is refused while the file is retained or on legal hold.
//
// Who sees a file (COL-050): `visibility` lists the audiences. The office always does (OFFICE is always in it); FLOOR
// shares it with the floor devices of ONE site (`floorSiteId`), PARTNER with ONE party's portal and LINK with that
// party's one-off links (`partyId`). The policies compare key columns only, so `floorSiteId` and `partyId` are set
// exactly when the file is shared that way (the guard trigger of …_files_guards keeps them consistent): the floor role
// reads only files shared with its site's floor, the partner role only files shared with its party.
//
// The fiscal archive (PLAN §2.8: invoices, DDTs, signed quote versions; c.c. art. 2220, 10 years): FISCAL_ARCHIVE files
// are stored under `legal/` (the locked bucket), carry a retention date at least ten years ahead, and like every file
// never change their content; nothing deletes them before that date or while on legal hold (the domain checks it, the
// trigger refuses it for every login, the locked bucket refuses it at R2).

/// One file in object storage, kept for one record (COL-045). Content columns (name, type, size, SHA-256, store and key)
/// never change after the row is written; a new version is a new file. Rows are never deleted: a deleted file keeps its
/// row in status DELETED (its object is removed from the store).
model StoredFile {
  id               String         @id @db.Uuid
  tenantId         String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company whose staff see it. Null: tenant-wide master data (a style's tech pack shared by every company).
  companyId        String?        @db.Uuid
  /// The record it belongs to: its model name (`Quote`, `Style`, `Company`) and id.
  recordType       String
  recordId         String         @db.Uuid
  kind             FileKind
  /// W2b (B-W2b-01; the B-W2a-31, -44, -48 notes): what the file is evidence of, when a screen must tell it apart from the
  /// record's other files: the supplier's DDT photographed at the dock, the proof of delivery, the CMR, the carrier's
  /// invoice (intra-EU transport evidence), a claim's photo. Null: an ordinary file of its kind. A tag: it may be set or
  /// corrected later (the API's command audits it); the content never changes.
  category         FileCategory?
  /// The name it was uploaded with (path and control characters removed); the download's file name.
  originalName     String
  /// The MIME type announced at upload and confirmed by the store; one of the kind's allowed types.
  contentType      String
  sizeBytes        Int
  /// SHA-256 of the content, lower-case hex, announced at upload and confirmed by the store's checksum.
  sha256           String
  /// The R2 account (IntegrationAccount, provider R2) whose store holds the object; FAKE: the local folder.
  storeAccountId   String         @db.Uuid
  /// Where the object is in that store: `t/<tenantId>/c/<companyId>/<yyyy>/<random uuid>` (`…/tenant/…` without a
  /// company), under `legal/` for the fiscal archive. Never a URL, never guessable, never listed publicly.
  storageKey       String
  status           FileStatus     @default(PENDING_UPLOAD)
  /// Who may see it: OFFICE always; FLOOR, PARTNER and LINK when shared (COL-050).
  visibility       FileAudience[] @default([OFFICE])
  /// The site whose floor devices see it: set exactly when visibility has FLOOR (the floor role's policy key).
  floorSiteId      String?        @db.Uuid
  /// The party it is shared with: set exactly when visibility has PARTNER or LINK (the partner role's policy key).
  /// The parties module adds its reference.
  partyId          String?        @db.Uuid
  /// Kept at least until then: nobody deletes it before (FISCAL_ARCHIVE: at least ten years). Only ever moves later.
  retainUntil      DateTime?      @db.Timestamptz(3)
  /// Held for a legal matter: nobody deletes it while set. Hidden from the floor and partner roles.
  /// W2b (wave 14/16): the default is the database's, so a Prisma insert leaves the column out: the floor adds its photos
  /// and voice notes of a job (QHS-189) without a grant on it. A cast from text, so Prisma reads it back as it is written.
  legalHold        Boolean        @default(dbgenerated("('false'::text)::boolean"))
  /// Why a confirmed upload did not match what was announced (QUARANTINED): size_mismatch, type_mismatch,
  /// checksum_mismatch.
  quarantineReason String?
  /// The virus scan (PLT-245, B-W2a-42): NOT_SCANNED without a scanner (and every file stored before it), else
  /// PENDING while the scanner checks it (an upload waits QUARANTINED, reason `scan_pending`), then CLEAN (it may be
  /// AVAILABLE), INFECTED or FAILED (it stays or becomes QUARANTINED). A rescan (new signatures) moves CLEAN or FAILED
  /// back to PENDING; INFECTED is final.
  scanStatus       FileScanStatus @default(NOT_SCANNED)
  /// The verdict's time and the scanner that gave it ("ClamAV 1.4.1/27450"): set exactly with a verdict. Hidden from
  /// the floor and partner roles.
  scannedAt        DateTime?      @db.Timestamptz(3)
  scanEngine       String?
  /// INFECTED: what it found (the signature's name); FAILED: why it could not scan. Hidden from the floor and partner
  /// roles.
  scanFinding      String?
  /// When the upload was confirmed (AVAILABLE).
  availableAt      DateTime?      @db.Timestamptz(3)
  /// When it was deleted (DELETED).
  deletedAt        DateTime?      @db.Timestamptz(3)
  /// W2b (wave 18/22; COL-046, PRD-227, PLT-216): versions. A new version is a new row, so a new object in the store:
  /// nothing stored is ever overwritten. `seriesId` names the series' first version (null on the first version itself,
  /// and on every file that never had another one); `versionNo` counts from 1 (the first) and each next version takes
  /// the series' highest number plus one, never reused. A version is of the first one's record, company and kind; a
  /// fiscal archive file has none. Both are written once, with the row (files-depth.prisma has the rest of the files
  /// depth).
  seriesId         String?        @db.Uuid
  versionNo        Int            @default(1)
  /// When a later version of its series became available: no longer the current version, and read-only from then on
  /// (its tags fixed, never shared more widely; it may still be deleted, rescanned, retained and given its thumbnail).
  /// Set once, never cleared.
  supersededAt     DateTime?      @db.Timestamptz(3)
  /// W2b (wave 18/22): a copy names the file it was copied from (a style's DoC on a shipment, an inspection report shared
  /// on a shipment, a version restored as a new one): the same bytes (SHA-256, size and type as its source's), so a copy is
  /// matched to its version by this column, not by its SHA-256. Written once, with the row; null for a file that is not a
  /// copy (and for copies stored before wave 18).
  sourceFileId     String?        @db.Uuid
  /// W2b (wave 18/22; COL-049): the day the document stops being valid (a certificate, a declaration, a supplier's
  /// document); null: it does not expire. A tag, set or corrected while the file is the current version (the API audits
  /// it). `expiryRemindedAt`: when the last expiry reminder for this date went out (30 days before, then 7); it only moves
  /// later, and a new date starts without one. Hidden from the floor and partner roles.
  expiresOn        DateTime?      @db.Date
  expiryRemindedAt DateTime?      @db.Timestamptz(3)
  /// W2b (wave 18/22; COL-058): the thumbnail, a second object in the same store (`thumbnailKey`, never under `legal/`),
  /// made after the scan with the EXIF and location data stripped (`exifStrippedAt`: when): what a portal or a link is
  /// shown of a photo. Both set together, once, while the file is AVAILABLE; never changed.
  thumbnailKey     String?
  exifStrippedAt   DateTime?      @db.Timestamptz(3)
  /// W2b-6 (schema wave 45/57, B-W2b-363; SAL-291, SAL-297; Owner answer 3 of W2b-3): the delete date of a made-to-measure
  /// photo (category MTM_PHOTO or FITTING_PHOTO, the only files that take one): from then on the purge deletes it (status
  /// DELETED, its object removed), 90 days after the garment ships by default. Set by the office or the system once known,
  /// moved earlier or later (the rider asked), never cleared; not before retainUntil; fixed once the file is DELETED (a
  /// superseded version still takes it). Hidden from the floor and partner roles.
  deleteAfter      DateTime?      @db.Timestamptz(3)
  /// W2b-6 (B-W2b-363; SCM-020, B-W2b-315, -334): what a supplier's document is (a DURC, an LWG audit, an ISO 9001
  /// certificate, a REACH declaration …): a code of the SUPPLIER_DOCUMENT_TYPE reason list (reasons.prisma ReasonCode, kept
  /// as text), only on a file of a vault category (SUPPLIER_CERTIFICATE, TEST_REPORT, DECLARATION); an ACTIVE code when
  /// named. A tag like the category: set or corrected while the file is the current version. Null: not said (the category
  /// only). Hidden from the floor.
  documentTypeCode String?
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  /// Who asked for the upload (a user, or the system for a generated document).
  createdById      String?        @db.Uuid

  company      Company?           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // A floor-visible file belongs to a company, and its site is one of that company's sites.
  floorSite    Site?              @relation(fields: [tenantId, companyId, floorSiteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  storeAccount IntegrationAccount @relation(fields: [tenantId, storeAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (wave 18/22): the first version of its series (on a later version) and the later versions (on a first one); the
  // file it was copied from and the copies made of it. Restrict, not Prisma's SetNull default for an optional relation:
  // that would also clear tenantId.
  series        StoredFile?  @relation("StoredFileSeries", fields: [tenantId, seriesId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  laterVersions StoredFile[] @relation("StoredFileSeries")
  sourceFile    StoredFile?  @relation("StoredFileCopy", fields: [tenantId, sourceFileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  copies        StoredFile[] @relation("StoredFileCopy")
  // W2b files-depth.prisma (wave 18/22): its multipart upload sessions, the markups made on it, the markup it was made by.
  uploadSessions FileUploadSession[]
  markups        FileMarkup[]        @relation("FileMarkupFile")
  markupResultOf FileMarkup?         @relation("FileMarkupResult")
  // imports.prisma: the import job whose sheet this file is.
  importJobs   ImportJob[]
  // W2b leather.prisma (wave 12/16): the hide marks made on it (a photo), the shade group whose master swatch it shows.
  hideMarkPhotos   HideMark[]   @relation("HideMarkPhoto")
  shadeGroupSwatches ShadeGroup[] @relation("ShadeGroupSwatch")
  // W2b-2 cutting.prisma, production.prisma (wave 13/16): the cut orders whose marker plot it is, the cut log entries whose hide
  // photo it is.
  cutOrderMarkers  CutOrder[]   @relation("CutOrderMarkerFile")
  cutLogPhotos     CutLog[]     @relation("CutLogPhoto")
  // W2b-4 sizes-depth.prisma (wave 27/33): the point of measure whose how-to picture it is.
  pointOfMeasurePictures PointOfMeasure[] @relation("PointOfMeasurePicture")
  // W2b-4 techfiles.prisma (wave 32/33): the technical file evidence it is, the lab report of a production-control test, an
  // evidence pack's PDF or ZIP, a label artwork's proof.
  technicalFileItems     TechnicalFileItem[]     @relation("TechnicalFileItemFile")
  productionControlTests ProductionControlTest[] @relation("ProductionControlTestReport")
  evidencePackFiles      EvidencePack[]          @relation("EvidencePackFile")
  evidencePackZips       EvidencePack[]          @relation("EvidencePackZip")
  labelArtworkVersions   LabelArtworkVersion[]   @relation("LabelArtworkVersionFile")
  // print.prisma: the print jobs that printed this file.
  printJobs    PrintJob[]
  // W2b-6 shipping.prisma, carriers.prisma (wave 48/57): the shipments whose collection it signs, the day sheets it closes.
  shipmentCollectionSignatures Shipment[]         @relation("ShipmentCollectionSignature")
  dispatchManifests            DispatchManifest[] @relation("DispatchManifestFile")
  // W2b-6 shipping.prisma, customs.prisma (wave 51/57): the shipments whose proof of delivery it is, the return labels and
  // the proofs of exit it is.
  shipmentPods                 Shipment[]           @relation("ShipmentPodFile")
  returnLabelFiles             ReturnLabel[]        @relation("ReturnLabelFile")
  customsExitProofs            CustomsDeclaration[] @relation("CustomsDeclarationExitFile")
  // W2b-5 suppliers-depth.prisma (wave 42/44): the subcontract agreements whose signed terms it is.
  subcontractAgreementTerms SubcontractAgreement[] @relation("SubcontractAgreementTerms")
  // W2b-4 recall.prisma (wave 33/33): the authority notices it is the sent copy of.
  authorityNotices AuthorityNotice[] @relation("AuthorityNoticeFile")
  // W2b-5 ppe-texts.prisma (wave 34/44): the PPE text approvals it is the consultant's evidence of.
  ppeTextApprovals PpeTextApproval[] @relation("PpeTextApprovalEvidence")
  // money.prisma: the invoices whose XML or PDF copy it is, and the SDI sends that sent it.
  invoiceXmlOf   Invoice[]       @relation("InvoiceXml")
  invoicePdfOf   Invoice[]       @relation("InvoicePdf")
  sdiSubmissions SdiSubmission[]
  // W2b-6 tax.prisma (wave 49/57): the declarations of intent whose check receipt it is, our own copies of SDI sends whose
  // XML it is.
  declarationOfIntentReceipts DeclarationOfIntent[] @relation("DeclarationOfIntentReceipt")
  sdiArchiveCopyXmlOf         SdiArchiveCopy[]      @relation("SdiArchiveCopyXml")
  // W2a payables.prisma, accounting.prisma (wave 7/7): the supplier invoices whose XML or PDF it is, the accounting
  // export file it is.
  supplierInvoiceXmlOf  SupplierInvoice[]      @relation("SupplierInvoiceXml")
  supplierInvoicePdfOf  SupplierInvoice[]      @relation("SupplierInvoicePdf")
  // W2b payables.prisma (schema wave 2/7): the XML of a file of several supplier invoices, of an SDI inbox item.
  supplierInvoiceFileXmlOf SupplierInvoiceFile[] @relation("SupplierInvoiceFileXml")
  sdiInboxItemXmlOf        SdiInboxItem[]        @relation("SdiInboxItemXml")
  accountingExportFiles AccountingExportFile[] @relation("AccountingExportFile")
  // W2b-6 bank.prisma (schema wave 50/57): the bank statement, Ri.Ba. file or customer's statement it is.
  bankStatements           BankStatement[]            @relation("BankStatementFile")
  ribaBatchFiles           RibaBatch[]                @relation("RibaBatchFile")
  customerStatementFigures CustomerStatementFigures[] @relation("CustomerStatementFiguresFile")
  // W2b pay.prisma (wave 6/7): the rate sheets, signed rate receipts, worker statements and payroll export files it is.
  ratePublicationSheets     RatePublication[]     @relation("RatePublicationSheet")
  rateAcknowledgementPapers RateAcknowledgement[] @relation("RateAcknowledgementPaper")
  // W2b-4 instructions.prisma (wave 25/33): the instruction steps whose photo or video it is.
  workInstructionMedia      WorkInstructionMedia[]
  workerStatementFiles      WorkerStatement[]     @relation("WorkerStatementFile")
  payrollExportFiles        PayrollExportFile[]   @relation("PayrollExportFile")
  // quality.prisma: the lab results it is the report of, the lot documents it is.
  labResults     LabResult[]
  lotDocuments   LotDocument[]
  // W2a holds.prisma: the defect codes whose picture it is.
  defectCodePictures DefectCode[] @relation("DefectCodePicture")
  // W2b ncr.prisma (wave 11/16): the concession whose written answer it is.
  ncrConcessionAnswers NcrConcession[] @relation("NcrConcessionAnswer")
  // W2b links-depth.prisma (wave 19/22): the links that share it in their set, the approval answers whose markup it is.
  linkFiles            LinkFile[]        @relation("LinkFileFile")
  approvalMarkups      ApprovalRequest[] @relation("ApprovalRequestMarkup")
  // W2b portal-followups.prisma (schema wave 23): the supplier uploads it is the file of, the document they replace, or
  // the document in force an accepted one became.
  supplierUploads        SupplierDocumentUpload[] @relation("SupplierDocumentUploadFile")
  supplierUploadReplaced SupplierDocumentUpload[] @relation("SupplierDocumentUploadReplaces")
  supplierUploadAccepted SupplierDocumentUpload[] @relation("SupplierDocumentUploadDocument")
  // W2b time.prisma (wave 5/7): the attendance month close whose LUL calendar it is.
  attendanceLulOf AttendanceMonthClose[] @relation("AttendanceMonthCloseLul")
  // W2b safety.prisma (wave 15/16): the risk assessment versions whose frozen PDF it is.
  riskAssessmentVersions RiskAssessmentVersion[] @relation("RiskAssessmentVersionFile")
  // W2b health.prisma (wave 16/16): the safety data sheets whose PDF it is.
  safetyDataSheets       SafetyDataSheet[]       @relation("SafetyDataSheetFile")
  // W2a stockcount.prisma: the year-end count whose signed valued list it is.
  stockCountValuedLists StockCount[] @relation("StockCountValuedList")
  // W2b portal-auth.prisma (wave 17/22): the company brandings whose light or dark logo it is.
  brandingLogos         CompanyBranding[] @relation("CompanyBrandingLogo")
  brandingDarkLogos     CompanyBranding[] @relation("CompanyBrandingLogoDark")
  // W2b-4 styles-depth.prisma (wave 26/33): the style pictures and the revision pattern, marker and CAD files it is.
  styleImages           StyleImage[]        @relation("StyleImageFile")
  styleRevisionFiles    StyleRevisionFile[] @relation("StyleRevisionFileFile")
  // W2b-5 sales-intake.prisma (wave 37/44): the customer requirements whose document (a routing guide) it is.
  customerRequirements   CustomerRequirement[] @relation("CustomerRequirementFile")
  // W2b-4 substances.prisma (wave 31/33): the declaration requests whose answer (by link or by hand) it is.
  supplierDeclarationAnswers SupplierDeclarationRequest[] @relation("SupplierDeclarationRequestAnswerFile")
  // privacy.prisma: the notice language and the DPIA whose PDF it is.
  privacyNoticeTexts PrivacyNoticeText[] @relation("PrivacyNoticeTextFile")
  privacyDpias       PrivacyDpia[]       @relation("PrivacyDpiaFile")
  // W2b-6 privacy-ops.prisma (schema wave 53/57): the access requests whose package it is.
  dataRequestPackages DataRequest[] @relation("DataRequestPackage")
  // views.prisma, ops.prisma: the export whose file it is, the restore drill it is the evidence of.
  exportJobs         ExportJob[]
  restoreDrills      RestoreDrill[]
  // W2a sourcing.prisma: the purchase order revisions whose PDF it is.
  purchaseOrderRevisions PurchaseOrderRevision[] @relation("PurchaseOrderRevisionDocument")
  // W2b gendocs.prisma (B-W2b-01): the generated document versions it is the file of.
  generatedDocuments     GeneratedDocument[]
  // W2b-5 warehouse-depth.prisma (wave 36/44): the transfers whose DDT PDF it is.
  transferDdts           TransferOrder[]     @relation("TransferOrderDdtFile")
  // W2b parties.prisma (wave 21/22): the measurement revisions whose front, side or back photo it is.
  measurementPhotosFront MeasurementProfile[] @relation("MeasurementProfilePhotoFront")
  measurementPhotosSide  MeasurementProfile[] @relation("MeasurementProfilePhotoSide")
  measurementPhotosBack  MeasurementProfile[] @relation("MeasurementProfilePhotoBack")

  @@unique([tenantId, storageKey])
  // The target of the tenant-safe references from other rows (a company's logo, a document's PDF).
  @@unique([tenantId, id])
  // A record's files (the record's file panel).
  @@index([tenantId, recordType, recordId])
  @@index([tenantId, floorSiteId])
  @@index([tenantId, partyId])
  // W2b (wave 18/22): a thumbnail object belongs to one file; the copies of a file ("which records use it"); the files that
  // expire soon (the reminders). A series' versions: the partial unique index "StoredFile_one_number_per_version" of
  // …_files_depth_w2b_guards (tenantId, seriesId, versionNo).
  @@unique([tenantId, thumbnailKey])
  @@index([tenantId, sourceFileId])
  @@index([tenantId, expiresOn])
  // W2b-6 (wave 45/57): the made-to-measure photo purge (the files whose delete date passed).
  @@index([tenantId, deleteAfter])
}

/// What a file is; each kind has its allowed content types and its size limit (platform/files/rules.ts). Additive.
enum FileKind {
  /// Anything attached to a record: PDFs, pictures, office documents, CSV.
  ATTACHMENT
  /// A document made or kept for the record: PDF, office documents, CSV.
  DOCUMENT
  /// A picture (the floor's defect photo, a sample).
  PHOTO
  /// A certificate or test report: PDF, JPEG, PNG.
  CERTIFICATE
  /// A fiscal document kept ten years (invoice XML and PDF, DDT, signed quote): stored under `legal/`, immutable.
  FISCAL_ARCHIVE
  /// W2b (wave 14/16; QHS-189): a voice note (a maintenance job's or request's, recorded on the floor or a phone).
  AUDIO
}

/// What a file is evidence of (W2b, B-W2b-01). Additive.
enum FileCategory {
  /// The supplier's transport document as it came with the goods, photographed at the dock (a goods receipt's file).
  DDT_PHOTO
  /// Proof of delivery signed by the recipient (a shipment's file).
  POD
  /// The international consignment note (CMR) of a road transport (a shipment's file).
  CMR
  /// The carrier's invoice for the transport (a shipment's file): evidence of the transport and of its cost.
  CARRIER_INVOICE
  /// A photo of goods claimed from a supplier (a supplier claim's or a discrepancy's file).
  CLAIM_PHOTO
  /// W2b (wave 14/16; QHS-165, art. 71 c.4): a machine's EU declaration of conformity (CE), its user manual (a machine's
  /// files), and the report of a statutory or periodic check (a MachineCheckResult's file; QHS-205).
  MACHINE_CE
  MANUAL
  CHECK_REPORT
  /// W2b (wave 14/16; QHS-189): a photo of a maintenance job before and after the work (a job's or request's file).
  BEFORE_WORK
  AFTER_WORK
  /// Another kind of evidence, said in the file's name.
  OTHER
  /// W2b (wave 18/22; COL-048, COL-049, SCM-020, SCM-096): what partners send and what a required-document rule asks for:
  /// a supplier's certificate (LWG audit, ISO 9001, an insurance), a test report (Cr VI, REACH tests), a declaration
  /// (REACH, conformity, a signed code of conduct), a body photo for measurements (BODY_PHOTO: front, side, back), a
  /// supplier questionnaire's attachment, a proof to approve (artwork, a design proof) and a sample's photo.
  SUPPLIER_CERTIFICATE
  TEST_REPORT
  DECLARATION
  BODY_PHOTO
  QUESTIONNAIRE
  PROOF
  SAMPLE_PHOTO
  /// W2b-5 (schema wave 38/44, B-W2b-280; SAL-140): the customer's logo or artwork for a configured quote or order line (a
  /// QuoteLine's or SalesOrderLine's file), for cutting or printing.
  ARTWORK
  /// W2b-5 (schema wave 43/44, B-W2b-291; SAL-385): a photo of a garment's damage at a repair's intake (a repair order's
  /// file; the claim link and the portal ask at least two).
  DAMAGE_PHOTO
  /// W2b-6 (schema wave 45/57, B-W2b-363; SAL-291, SAL-297): the rider's photos the office takes: a photo of a measurement
  /// profile revision (MTM_PHOTO, a MeasurementProfile's file) and of a fitting (FITTING_PHOTO, a FittingResult's file).
  /// PHOTO files, the office's only (never shared with a floor, a portal or a link), each with its delete date
  /// (deleteAfter). Personal data.
  MTM_PHOTO
  FITTING_PHOTO
}

/// Where a file is: PENDING_UPLOAD (row written, the upload not confirmed) → AVAILABLE (confirmed) or QUARANTINED (it
/// did not match what was announced); any of them → DELETED (final; its object removed from the store).
enum FileStatus {
  PENDING_UPLOAD
  AVAILABLE
  QUARANTINED
  DELETED
}

/// The virus scan of a file (PLT-245): NOT_SCANNED → PENDING → CLEAN | INFECTED | FAILED; CLEAN | FAILED → PENDING
/// (a rescan). INFECTED is final.
enum FileScanStatus {
  /// No scanner was on when it was stored (or a document the system made).
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
  /// The scanner could not read it (an encrypted archive, a time-out).
  FAILED
}

/// Who may see a file (COL-050).
enum FileAudience {
  /// The office staff (always).
  OFFICE
  /// The floor devices of one site.
  FLOOR
  /// One party's portal users.
  PARTNER
  /// One party's one-off links (with the link's record).
  LINK
}
