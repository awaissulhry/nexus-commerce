// Subcontracting (W2a schema wave 3/7; plan W2A §5; features SCM-138, SCM-140, SCM-141, SCM-142, PRD-120): work sent to
// an outside workshop (a terzista: CMT sewing, embroidery, armour pockets, finishing) for one work order: the
// operations it does with the pieces and the fee per piece, the kit of our material sent with a DDT for work on our
// behalf (conto lavorazione), and what comes back. apps/factory-api's modules/purchasing/subcontracting writes them
// (B-W2a-25), always through command().
//
// A subcontract order (SC-… from the company's SUBCONTRACT series) belongs to one work order of the site that owns
// the stock, names the workshop (a party with the SUBCONTRACTOR role; the module checks the role) and the workshop's
// stock location there (inventory.prisma Location kind SUBCONTRACTOR, owned by that party: our material at the
// workshop stays ours and in our books). DRAFT while prepared → ISSUED (the job sheet sent; the kit to send) →
// AT_WORKSHOP (the kit went out) → PARTLY_RECEIVED → RECEIVED (goods back) → CLOSED; DRAFT or ISSUED → CANCELLED while
// nothing is at the workshop. Its terms and operations change only while DRAFT (an ISSUED order goes back to DRAFT to
// be changed); the counts of pieces sent and back move as the work goes out and comes back.
//
// The kit: each line is one component to send (PLANNED, from the work order's materials), and once sent the TRANSFER
// move that put it into the workshop's location (same item, colour, lot, hide and quantity) and the DDT it travelled
// with (shipping.prisma Ddt, B-W2a-17). The material balance (sent = in the goods + returned + scrap + loss) is W2b.
//
// Money (A1 §2.6): the fee per piece and the order's amount are costs (`@grain cost`), office only.
//
// Who sees what (ownership/subcontract.json): the office reads and writes; the floor and portal or link sessions read
// none of it (the floor moves the kit through the stock ledger; the workshop portal, W2b wave 22/22 below, reads and
// answers its own orders and kit lines). Nobody deletes an order (it
// is cancelled); the office deletes the operations of a DRAFT order and the kit lines still PLANNED.
//
// Every child row carries its order's siteId (and work order or workshop) in its reference, so it can never belong to
// another site's order. Uniqueness made only of references (one operation row per work order operation) is the
// module's: a unique key of ids alone cannot be copied by the generated isolation tests.
//
// W2b (schema wave 1/7, B-W2b-01; the B-W2a-25 and -76 notes): what went out and what came back are rows instead of the
// commands' audit rows. SubcontractBundle: each bundle of cut pieces that went out with the kit (one row per bundle and
// order: the module's). SubcontractReceipt: one visit of goods back (when, the workshop's DDT, the TRANSFER moves of the
// material returned) with its SubcontractReceiptLine rows per operation and bundle (good, defective, scrapped there, the
// reason); receipts are append-only. A receipt line may report the outside operation on the bundle's way through the
// work order (production.prisma OperationScan.subcontractReceiptLineId). Office only, like the rest of this file: the
// floor's kit task (B-W2a-76) writes through the tenant's system caller.
//
// W2b (schema wave 22/22, B-W2b-158; the workshop portal and its JOB_ACCEPT link, SCM-154, SCM-155): the workshop answers
// the job on the order (accepted, with another due-back date it proposes, or declined; the office answers a proposed
// date) and checks the kit it received line by line. A portal or link session (factory_partner_runtime) reads its OWN
// party's orders and kit lines, never a fee, amount or internal note, and writes only those answers (the
// …_portal_supply_w2b_guards triggers); its progress reports and return notices are portal-supply.prisma's.

/// An order to an outside workshop for operations of one work order (SCM-138).
model SubcontractOrder {
  id               String                 @id @db.Uuid
  tenantId         String                 @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId        String                 @db.Uuid
  /// The work order's site: it owns the stock sent out, and the workshop's location is one of its locations.
  siteId           String                 @db.Uuid
  /// The number from the company's SUBCONTRACT series, unique in the company.
  number           String
  /// The workshop (a party with the SUBCONTRACTOR role).
  partyId          String                 @db.Uuid
  /// The workshop's stock location on the site: kind SUBCONTRACTOR, owned by `partyId` (the triggers check both).
  locationId       String                 @db.Uuid
  /// The work order whose operations it does.
  workOrderId      String                 @db.Uuid
  status           SubcontractOrderStatus @default(DRAFT)
  orderDate        DateTime               @db.Date
  /// When the goods are due back at the site.
  expectedBackDate DateTime?              @db.Date
  /// W2b-5 (schema wave 41/44, B-W2b-286; PLN-164, the kit-timing popover): when the kit must leave for the work to start
  /// on time (not after the day the goods are due back); one of the order's terms (changed while DRAFT); null: not planned.
  kitDueAt         DateTime?              @db.Timestamptz(3)
  /// ISO 4217: the currency of its fees.
  currency         String                 @default("EUR")
  /// The sum of its operations' amounts, in minor units; fixed when it is issued (the triggers check the sum).
  /// @grain cost
  netAmount        Int                    @default(0)
  /// Printed on the job sheet, for the workshop.
  note             String?
  /// For the office only.
  /// @internal
  internalNote     String?
  /// When the job sheet went to the workshop and who sent it: set exactly from ISSUED on (cleared when it goes back to
  /// DRAFT).
  issuedAt         DateTime?              @db.Timestamptz(3)
  issuedById       String?                @db.Uuid
  /// Set exactly while CLOSED.
  closedAt         DateTime?              @db.Timestamptz(3)
  /// Set exactly while CANCELLED, with the reason.
  cancelledAt      DateTime?              @db.Timestamptz(3)
  cancelReason     String?
  /// W2b (wave 22/22, B-W2b-158; JOB_ACCEPT, PLN-163, SCM-154; design links.job, portal.supplier.jobs "Accept job",
  /// "Decline this job"): the workshop's answer to the job, given once, through its JOB_ACCEPT link, the portal, or the
  /// office for a workshop without e-mail (Owner answer C3); cleared only when the order goes back to DRAFT. Accepted
  /// (while ISSUED, AT_WORKSHOP or PARTLY_RECEIVED): when, the name it gave (optional), and another due-back date it
  /// proposes with why (optional). Declined (while ISSUED or AT_WORKSHOP): when, why, the name it gave (optional).
  acceptedAt              DateTime?                 @db.Timestamptz(3)
  acceptedByName          String?
  proposedDate            DateTime?                 @db.Date
  proposedDateReason      String?
  declinedAt              DateTime?                 @db.Timestamptz(3)
  declinedByName          String?
  declineReason           String?
  /// The office's answer to the proposed date, once: ACCEPTED (the expected-back date becomes it) or REFUSED; when, by
  /// whom (a partner session reads the answer and its time, never who).
  proposedDateDecision    PurchaseProposalDecision?
  proposedDateDecidedAt   DateTime?                 @db.Timestamptz(3)
  proposedDateDecidedById String?                   @db.Uuid
  version          Int                    @default(1)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  createdById      String?                @db.Uuid

  site       Site                   @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  party      Party                  @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location   Location               @relation(fields: [tenantId, siteId, locationId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrder  WorkOrder              @relation(fields: [tenantId, siteId, workOrderId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  operations SubcontractOperation[]
  kitLines   SubcontractKitLine[]
  // W2b-5 production.prisma, planning-depth.prisma (wave 41/44): the work order's operations outsourced to it, and the
  // planned work order it was made from.
  outsourcedOperations WorkOrderOperation[] @relation("WorkOrderOperationOutsourced")
  plannedWorkOrders    PlannedWorkOrder[]
  // W2b (B-W2b-01): the bundles that went out with its kit, and what came back.
  bundles    SubcontractBundle[]
  receipts   SubcontractReceipt[]
  // W2b portal-supply.prisma (wave 22/22): the workshop's progress reports and return notices.
  progressReports SubcontractProgressReport[]
  returnNotices   SubcontractReturnNotice[]
  // W2b-2 cutting.prisma (wave 13/16): the secondary processes it takes outside.
  secondaryProcesses SecondaryProcess[]
  // W2a payables.prisma, cost-ledger.prisma (wave 7/7): the subcontractor's invoice lines that bill it, their matches,
  // and the work-order cost entries of its work.
  supplierInvoiceLines   SupplierInvoiceLine[]
  supplierInvoiceMatches SupplierInvoiceMatch[]
  /// @not-money the relation to the cost ledger (the rows carry the grain)
  costEntries            WorkOrderCostEntry[]

  @@unique([tenantId, companyId, number])
  // The target of the operations' reference: an operation of the order's own work order.
  @@unique([tenantId, siteId, workOrderId, id])
  // The target of the kit lines' reference: a line names its order's site and workshop.
  @@unique([tenantId, siteId, partyId, id])
  // W2b (wave 22/22): the target of the progress reports' and return notices' reference: of the order's site, work order
  // and workshop.
  @@unique([tenantId, siteId, workOrderId, partyId, id])
}

/// DRAFT → ISSUED → AT_WORKSHOP → PARTLY_RECEIVED → RECEIVED → CLOSED; ISSUED → DRAFT (to change it); AT_WORKSHOP →
/// ISSUED (the kit came back unsent), PARTLY_RECEIVED → AT_WORKSHOP and RECEIVED → PARTLY_RECEIVED (a receipt
/// reversed); DRAFT or ISSUED → CANCELLED. CLOSED and CANCELLED are final.
enum SubcontractOrderStatus {
  DRAFT
  ISSUED
  AT_WORKSHOP
  PARTLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// One operation of the work order done at the workshop (PRD-120, SCM-138): how many pieces (per size), the fee per
/// piece, when they are due back, and how many went out and came back good, defective or scrapped.
model SubcontractOperation {
  id                   String    @id @db.Uuid
  tenantId             String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and work order.
  siteId               String    @db.Uuid
  workOrderId          String    @db.Uuid
  subcontractOrderId   String    @db.Uuid
  /// Its place on the order: 10, 20, 30 …
  seq                  Int
  /// The work order's operation it is (its routing step: production.prisma WorkOrderOperation).
  workOrderOperationId String    @db.Uuid
  /// How many pieces the workshop works, above 0.
  pieces               Int
  /// The pieces per cell of the work order (production.prisma WorkOrderSize: a colourway in a size), summing to
  /// `pieces`; empty: not split: [{ "workOrderSizeId": "…", "pieces": 4 }].
  sizes                Json      @default("[]")
  /// The fee per piece, in the order's currency (the routing step's by default).
  /// @grain cost
  pricePerPiece        Decimal   @db.Decimal(18, 6)
  /// pieces × fee, rounded to minor units (factory-domain money).
  /// @grain cost
  netAmount            Int
  /// When this operation's pieces are due back (the order's by default).
  expectedBackDate     DateTime? @db.Date
  /// The pieces sent with the kit, and back from the workshop: good, defective, scrapped there (back ≤ sent ≤ pieces).
  piecesSent           Int       @default(0)
  piecesBackGood       Int       @default(0)
  piecesBackDefective  Int       @default(0)
  piecesScrapped       Int       @default(0)
  note                 String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?   @db.Uuid

  subcontractOrder   SubcontractOrder   @relation(fields: [tenantId, siteId, workOrderId, subcontractOrderId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrderOperation WorkOrderOperation @relation(fields: [tenantId, siteId, workOrderId, workOrderOperationId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  // W2b (B-W2b-01): what came back of it, receipt by receipt.
  receiptLines       SubcontractReceiptLine[]
  // W2b portal-supply.prisma (wave 22/22): the workshop's progress reports of it.
  progressReports    SubcontractProgressReport[]

  @@unique([tenantId, subcontractOrderId, seq])
  // W2b: the target of the receipt lines' reference: an operation of the line's own work order.
  @@unique([tenantId, siteId, workOrderId, id])
  // W2b (wave 22/22): the target of the progress reports' reference: an operation of the report's own order.
  @@unique([tenantId, siteId, workOrderId, subcontractOrderId, id])
}

/// One component of the kit sent to the workshop (SCM-140): what, which colour, lot and hide, how much; once SENT, the
/// TRANSFER move into the workshop's location and the DDT it travelled with.
model SubcontractKitLine {
  id                 String                   @id @db.Uuid
  tenantId           String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and workshop.
  siteId             String                   @db.Uuid
  partyId            String                   @db.Uuid
  subcontractOrderId String                   @db.Uuid
  /// Its place on the kit: 10, 20, 30 …
  seq                Int
  itemId             String                   @db.Uuid
  itemColourId       String?                  @db.Uuid
  /// The lot (and hide) sent, when the item is tracked: of the line's item, on the order's site. Null while PLANNED
  /// before the warehouse picks it.
  lotId              String?                  @db.Uuid
  hideId             String?                  @db.Uuid
  /// Above 0, in `uom`, and in the item's base unit.
  quantity           Decimal                  @db.Decimal(18, 4)
  uom                Uom
  baseQuantity       Decimal                  @db.Decimal(18, 4)
  status             SubcontractKitLineStatus @default(PLANNED)
  /// Set exactly while SENT: when, the TRANSFER move into the workshop's location, and the DDT it went with.
  sentAt             DateTime?                @db.Timestamptz(3)
  moveId             String?                  @db.Uuid
  ddtId              String?                  @db.Uuid
  note               String?
  /// W2b (wave 22/22, B-W2b-158; SCM-155, design portal.supplier.jobs "Kit received"): the workshop's check of what came:
  /// when, how much it counted (in `uom`, 0 or more; "all received as listed" is the line's quantity), and what was
  /// missing or damaged, in its words (a photo of it is a file of the line). Written once, all together, only while the
  /// line is SENT and not before it was sent, by the workshop (portal or link) or the office for it; cleared only when the
  /// line goes back to PLANNED (its transfer reversed).
  receivedByWorkshopAt       DateTime?        @db.Timestamptz(3)
  receivedByWorkshopQuantity Decimal?         @db.Decimal(18, 4)
  receivedByWorkshopNote     String?
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?                  @db.Uuid

  subcontractOrder SubcontractOrder @relation(fields: [tenantId, siteId, partyId, subcontractOrderId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  item             Item             @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and itemId.
  itemColour       ItemColour?      @relation(fields: [tenantId, itemId, itemColourId], references: [tenantId, itemId, id], onDelete: Restrict, onUpdate: Restrict)
  lot              Lot?             @relation(fields: [tenantId, siteId, itemId, lotId], references: [tenantId, siteId, itemId, id], onDelete: Restrict, onUpdate: Restrict)
  hide             Hide?            @relation(fields: [tenantId, siteId, lotId, hideId], references: [tenantId, siteId, lotId, id], onDelete: Restrict, onUpdate: Restrict)
  move             StockMove?       @relation(fields: [tenantId, siteId, moveId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  ddt              Ddt?             @relation(fields: [tenantId, siteId, partyId, ddtId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, subcontractOrderId, seq])
}

/// PLANNED → SENT | CANCELLED; SENT → PLANNED when its transfer was reversed (the kit did not leave). CANCELLED is final.
enum SubcontractKitLineStatus {
  PLANNED
  SENT
  CANCELLED
}

/// A bundle of cut pieces that went to the workshop with a subcontract order's kit (W2b, B-W2b-01; SCM-140, SCM-142;
/// floor.kits "Rows per bundle and size: out / back / rejected"): which bundle (of the order's work order), how many
/// garments it carried and when; what came back of it is in the receipt lines. Written in the kit's send; never
/// changed; removed only while nothing of it came back (a send undone). One row per order and bundle is the module's.
model SubcontractBundle {
  id                 String   @id @db.Uuid
  tenantId           String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and work order.
  siteId             String   @db.Uuid
  workOrderId        String   @db.Uuid
  subcontractOrderId String   @db.Uuid
  /// An ACTIVE bundle of the work order when it went out.
  bundleId           String   @db.Uuid
  /// The garments (sets of cut pieces) it carried: 1 up to the bundle's.
  quantity           Int
  /// When it went out (the kit's send).
  sentAt             DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  createdById        String?  @db.Uuid

  subcontractOrder SubcontractOrder @relation(fields: [tenantId, siteId, workOrderId, subcontractOrderId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  bundle           Bundle           @relation(fields: [tenantId, siteId, workOrderId, bundleId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, subcontractOrderId])
  @@index([tenantId, bundleId])
}

/// One visit of goods back from the workshop (W2b, B-W2b-01; SCM-142, SCM-145; design purchasing.subcontracting
/// "Received back", floor.kits "Receive back"): when, the workshop's transport document, the TRANSFER moves of the
/// material and offcuts it returned, and its lines per operation and bundle. Written once, in the receive command (with
/// the operations' counts and the order's status); never changed or removed.
/// @append-only
model SubcontractReceipt {
  id                 String    @id @db.Uuid
  tenantId           String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and work order.
  siteId             String    @db.Uuid
  workOrderId        String    @db.Uuid
  subcontractOrderId String    @db.Uuid
  /// Its place among the order's receipts: 1, 2, 3 …
  seq                Int
  /// When the goods came back.
  receivedAt         DateTime  @db.Timestamptz(3)
  /// The workshop's DDT the goods came back with, as printed, and its date (only with a number).
  workshopDdtNumber  String?
  workshopDdtDate    DateTime? @db.Date
  /// The material and offcuts sent back: the TRANSFER moves out of the order's workshop location into the site's stock,
  /// each once (plain ids: the stock ledger keeps the moves; the trigger checks each).
  returnMoveIds      String[]  @default([]) @db.Uuid
  note               String?
  /// The floor device it was received on (B-W2a-76's kit task); null: the office.
  deviceId           String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  /// The office user who received it; null for the floor's kit task (the tenant's system caller; the audit row names
  /// the tablet and its operator, inside the one record).
  createdById        String?   @db.Uuid

  subcontractOrder SubcontractOrder         @relation(fields: [tenantId, siteId, workOrderId, subcontractOrderId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and siteId.
  device           Device?                  @relation(fields: [tenantId, siteId, deviceId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  lines            SubcontractReceiptLine[]
  // W2b inspection-plans.prisma (wave 10/16): the incoming inspections of what came back.
  incomingInspections IncomingInspection[]
  // W2b portal-supply.prisma (wave 22/22): the workshop's return notices it was written from.
  returnNotices    SubcontractReturnNotice[]

  @@unique([tenantId, subcontractOrderId, seq])
  // The target of the lines' reference: a receipt of the line's own site and work order.
  @@unique([tenantId, siteId, workOrderId, id])
  // W2b (wave 22/22): the target of the return notices' reference: a receipt of the notice's own order.
  @@unique([tenantId, siteId, workOrderId, subcontractOrderId, id])
}

/// One operation (and bundle) of a receipt (W2b, B-W2b-01): how many pieces came back good, defective (rejected) and
/// scrapped at the workshop, and why (a code of the REWORK list, as text, and its words). Written with its receipt;
/// never changed or removed. A bundle never comes back more than its garments per operation, over every receipt (the
/// trigger, under a lock per bundle and operation).
/// @append-only
model SubcontractReceiptLine {
  id                     String   @id @db.Uuid
  tenantId               String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The receipt's site and work order.
  siteId                 String   @db.Uuid
  workOrderId            String   @db.Uuid
  receiptId              String   @db.Uuid
  /// Its place on the receipt: 10, 20, 30 …
  seq                    Int
  /// The operation of the receipt's order it reports.
  subcontractOperationId String   @db.Uuid
  /// The bundle that came back (of the work order, of a cell the operation sends); null: pieces counted without one.
  bundleId               String?  @db.Uuid
  /// Pieces back: good, defective (rejected at our check) and scrapped at the workshop; each from 0, at least one in all.
  goodQuantity           Int      @default(0)
  defectiveQuantity      Int      @default(0)
  scrappedQuantity       Int      @default(0)
  /// Why pieces were rejected or scrapped: a code of the REWORK list (not blank, no spaces) and the words.
  reasonCode             String?
  reasonNote             String?
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  createdById            String?  @db.Uuid

  receipt   SubcontractReceipt   @relation(fields: [tenantId, siteId, workOrderId, receiptId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  operation SubcontractOperation @relation(fields: [tenantId, siteId, workOrderId, subcontractOperationId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and
  // workOrderId.
  bundle    Bundle?              @relation(fields: [tenantId, siteId, workOrderId, bundleId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  // production.prisma: the scan that reported the outside operation from it.
  scans     OperationScan[]

  @@unique([tenantId, receiptId, seq])
  // The target of the scans' reference: a line of the scan's own site and work order.
  @@unique([tenantId, siteId, workOrderId, id])
  // What came back of a bundle (the trigger's sums).
  @@index([tenantId, bundleId])
}
