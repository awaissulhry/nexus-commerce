// Subcontracting (W2a schema wave 3/7; plan W2A §5; features SCM-138, SCM-140, SCM-141, SCM-142, PRD-120): work sent to
// an outside workshop (a terzista: CMT sewing, embroidery, armour pockets, finishing) for one work order: the
// operations it does with the pieces and the fee per piece, the kit of our material sent with a DDT for work on our
// behalf (conto lavorazione), and what comes back. apps/factory-api's modules/purchasing/subcontracting writes them
// (B-W2a-25), always through command().
//
// A subcontract order (SC-… from the company's SUBCONTRACT series) belongs to one work order of the site that owns
// the stock, names the workshop (a party with the SUBCONTRACTOR role; the module checks the role) and the workshop's
// stock location there (inventory.prisma Location kind SUBCONTRACTOR, owned by that party: our material at the
// workshop stays ours and in our books). DRAFT while prepared → ISSUED (the job sheet sent; the kit to send) →
// AT_WORKSHOP (the kit went out) → PARTLY_RECEIVED → RECEIVED (goods back) → CLOSED; DRAFT or ISSUED → CANCELLED while
// nothing is at the workshop. Its terms and operations change only while DRAFT (an ISSUED order goes back to DRAFT to
// be changed); the counts of pieces sent and back move as the work goes out and comes back.
//
// The kit: each line is one component to send (PLANNED, from the work order's materials), and once sent the TRANSFER
// move that put it into the workshop's location (same item, colour, lot, hide and quantity) and the DDT it travelled
// with (shipping.prisma Ddt, B-W2a-17). The material balance (sent = in the goods + returned + scrap + loss) is W2b.
//
// Money (A1 §2.6): the fee per piece and the order's amount are costs (`@grain cost`), office only.
//
// Who sees what (ownership/subcontract.json): the office reads and writes; the floor and portal or link sessions read
// none of it (the floor moves the kit through the stock ledger; a workshop portal is W2b). Nobody deletes an order (it
// is cancelled); the office deletes the operations of a DRAFT order and the kit lines still PLANNED.
//
// Every child row carries its order's siteId (and work order or workshop) in its reference, so it can never belong to
// another site's order. Uniqueness made only of references (one operation row per work order operation) is the
// module's: a unique key of ids alone cannot be copied by the generated isolation tests.

/// An order to an outside workshop for operations of one work order (SCM-138).
model SubcontractOrder {
  id               String                 @id @db.Uuid
  tenantId         String                 @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId        String                 @db.Uuid
  /// The work order's site: it owns the stock sent out, and the workshop's location is one of its locations.
  siteId           String                 @db.Uuid
  /// The number from the company's SUBCONTRACT series, unique in the company.
  number           String
  /// The workshop (a party with the SUBCONTRACTOR role).
  partyId          String                 @db.Uuid
  /// The workshop's stock location on the site: kind SUBCONTRACTOR, owned by `partyId` (the triggers check both).
  locationId       String                 @db.Uuid
  /// The work order whose operations it does.
  workOrderId      String                 @db.Uuid
  status           SubcontractOrderStatus @default(DRAFT)
  orderDate        DateTime               @db.Date
  /// When the goods are due back at the site.
  expectedBackDate DateTime?              @db.Date
  /// ISO 4217: the currency of its fees.
  currency         String                 @default("EUR")
  /// The sum of its operations' amounts, in minor units; fixed when it is issued (the triggers check the sum).
  /// @grain cost
  netAmount        Int                    @default(0)
  /// Printed on the job sheet, for the workshop.
  note             String?
  /// For the office only.
  /// @internal
  internalNote     String?
  /// When the job sheet went to the workshop and who sent it: set exactly from ISSUED on (cleared when it goes back to
  /// DRAFT).
  issuedAt         DateTime?              @db.Timestamptz(3)
  issuedById       String?                @db.Uuid
  /// Set exactly while CLOSED.
  closedAt         DateTime?              @db.Timestamptz(3)
  /// Set exactly while CANCELLED, with the reason.
  cancelledAt      DateTime?              @db.Timestamptz(3)
  cancelReason     String?
  version          Int                    @default(1)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  createdById      String?                @db.Uuid

  site       Site                   @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  party      Party                  @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location   Location               @relation(fields: [tenantId, siteId, locationId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrder  WorkOrder              @relation(fields: [tenantId, siteId, workOrderId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  operations SubcontractOperation[]
  kitLines   SubcontractKitLine[]
  // W2a payables.prisma, cost-ledger.prisma (wave 7/7): the subcontractor's invoice lines that bill it, their matches,
  // and the work-order cost entries of its work.
  supplierInvoiceLines   SupplierInvoiceLine[]
  supplierInvoiceMatches SupplierInvoiceMatch[]
  /// @not-money the relation to the cost ledger (the rows carry the grain)
  costEntries            WorkOrderCostEntry[]

  @@unique([tenantId, companyId, number])
  // The target of the operations' reference: an operation of the order's own work order.
  @@unique([tenantId, siteId, workOrderId, id])
  // The target of the kit lines' reference: a line names its order's site and workshop.
  @@unique([tenantId, siteId, partyId, id])
}

/// DRAFT → ISSUED → AT_WORKSHOP → PARTLY_RECEIVED → RECEIVED → CLOSED; ISSUED → DRAFT (to change it); AT_WORKSHOP →
/// ISSUED (the kit came back unsent), PARTLY_RECEIVED → AT_WORKSHOP and RECEIVED → PARTLY_RECEIVED (a receipt
/// reversed); DRAFT or ISSUED → CANCELLED. CLOSED and CANCELLED are final.
enum SubcontractOrderStatus {
  DRAFT
  ISSUED
  AT_WORKSHOP
  PARTLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// One operation of the work order done at the workshop (PRD-120, SCM-138): how many pieces (per size), the fee per
/// piece, when they are due back, and how many went out and came back good, defective or scrapped.
model SubcontractOperation {
  id                   String    @id @db.Uuid
  tenantId             String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and work order.
  siteId               String    @db.Uuid
  workOrderId          String    @db.Uuid
  subcontractOrderId   String    @db.Uuid
  /// Its place on the order: 10, 20, 30 …
  seq                  Int
  /// The work order's operation it is (its routing step: production.prisma WorkOrderOperation).
  workOrderOperationId String    @db.Uuid
  /// How many pieces the workshop works, above 0.
  pieces               Int
  /// The pieces per cell of the work order (production.prisma WorkOrderSize: a colourway in a size), summing to
  /// `pieces`; empty: not split: [{ "workOrderSizeId": "…", "pieces": 4 }].
  sizes                Json      @default("[]")
  /// The fee per piece, in the order's currency (the routing step's by default).
  /// @grain cost
  pricePerPiece        Decimal   @db.Decimal(18, 6)
  /// pieces × fee, rounded to minor units (factory-domain money).
  /// @grain cost
  netAmount            Int
  /// When this operation's pieces are due back (the order's by default).
  expectedBackDate     DateTime? @db.Date
  /// The pieces sent with the kit, and back from the workshop: good, defective, scrapped there (back ≤ sent ≤ pieces).
  piecesSent           Int       @default(0)
  piecesBackGood       Int       @default(0)
  piecesBackDefective  Int       @default(0)
  piecesScrapped       Int       @default(0)
  note                 String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?   @db.Uuid

  subcontractOrder   SubcontractOrder   @relation(fields: [tenantId, siteId, workOrderId, subcontractOrderId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrderOperation WorkOrderOperation @relation(fields: [tenantId, siteId, workOrderId, workOrderOperationId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, subcontractOrderId, seq])
}

/// One component of the kit sent to the workshop (SCM-140): what, which colour, lot and hide, how much; once SENT, the
/// TRANSFER move into the workshop's location and the DDT it travelled with.
model SubcontractKitLine {
  id                 String                   @id @db.Uuid
  tenantId           String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's site and workshop.
  siteId             String                   @db.Uuid
  partyId            String                   @db.Uuid
  subcontractOrderId String                   @db.Uuid
  /// Its place on the kit: 10, 20, 30 …
  seq                Int
  itemId             String                   @db.Uuid
  itemColourId       String?                  @db.Uuid
  /// The lot (and hide) sent, when the item is tracked: of the line's item, on the order's site. Null while PLANNED
  /// before the warehouse picks it.
  lotId              String?                  @db.Uuid
  hideId             String?                  @db.Uuid
  /// Above 0, in `uom`, and in the item's base unit.
  quantity           Decimal                  @db.Decimal(18, 4)
  uom                Uom
  baseQuantity       Decimal                  @db.Decimal(18, 4)
  status             SubcontractKitLineStatus @default(PLANNED)
  /// Set exactly while SENT: when, the TRANSFER move into the workshop's location, and the DDT it went with.
  sentAt             DateTime?                @db.Timestamptz(3)
  moveId             String?                  @db.Uuid
  ddtId              String?                  @db.Uuid
  note               String?
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  createdById        String?                  @db.Uuid

  subcontractOrder SubcontractOrder @relation(fields: [tenantId, siteId, partyId, subcontractOrderId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  item             Item             @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and itemId.
  itemColour       ItemColour?      @relation(fields: [tenantId, itemId, itemColourId], references: [tenantId, itemId, id], onDelete: Restrict, onUpdate: Restrict)
  lot              Lot?             @relation(fields: [tenantId, siteId, itemId, lotId], references: [tenantId, siteId, itemId, id], onDelete: Restrict, onUpdate: Restrict)
  hide             Hide?            @relation(fields: [tenantId, siteId, lotId, hideId], references: [tenantId, siteId, lotId, id], onDelete: Restrict, onUpdate: Restrict)
  move             StockMove?       @relation(fields: [tenantId, siteId, moveId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  ddt              Ddt?             @relation(fields: [tenantId, siteId, partyId, ddtId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, subcontractOrderId, seq])
}

/// PLANNED → SENT | CANCELLED; SENT → PLANNED when its transfer was reversed (the kit did not leave). CANCELLED is final.
enum SubcontractKitLineStatus {
  PLANNED
  SENT
  CANCELLED
}
