// Roles and their assignments (plan A1 §2.3, §3.11; features PLT-029, PLT-030, PLT-032, PLT-034): what each person of
// a tenant may do, in which companies, sites and parties, and which money they see. apps/factory-api's
// platform/auth/roles keeps them through command(); the session's grants are built from the live assignments
// (platform/auth/sessions/grants.ts). Permission names, grains and the system templates live in
// @nexus/factory-domain (auth/permissions, auth/grains, auth/roles).
//
// Identity is per tenant (auth.prisma): an assignment names the tenant's User directly.

/// A bundle of permissions and money grains. A system role (`system`) is one of the templates of factory-domain
/// auth/roles, kept equal to it by the API's syncSystemRoles; nobody edits it. A custom role belongs to the tenant: it
/// is created (often as a copy of a template) and edited through the roles routes, and a later change of its template
/// never changes it by itself.
model Role {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The template's key for a system role (`owner`, `sales`…); `custom.<slug>` for a custom role. Unique in the tenant.
  key         String
  name        String
  description String?
  system      Boolean      @default(false)
  /// The template a custom role was copied from, if any (its later additions are shown, never applied by themselves).
  basedOn     String?
  /// Who it is for: office users (RoleAssignment), floor workers (WorkerRole) or, from W2b-3, partner users
  /// (RoleAssignment bound to their party).
  audience    RoleAudience @default(OFFICE)
  /// A session holds none of this role's permissions until two-factor was proved on it.
  requireMfa  Boolean      @default(false)
  /// W2b (B-W2b-03; B-W2a-36's grace): since when it asks for two-factor: a session made before this keeps the role
  /// until its next sign-in. Kept by the database (the …_followups_platform_w2b_guards trigger): set when requireMfa is
  /// switched on (the time given, else the transaction's), cleared when it is switched off, never moved while it stays
  /// on. Null on a role that asked before W2b (no grace: the audit rows say when).
  requireMfaSince DateTime? @db.Timestamptz(3)
  /// Declared `<area>.<action>` permissions (factory-domain auth/permissions), sorted; never a `money.*` one.
  permissions String[]     @default([])
  /// The money grains it sees: price, cost, margin, wages (factory-domain auth/grains).
  grains      String[]     @default([])
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments RoleAssignment[]
  // floor-auth.prisma: the floor workers holding this (floor) role.
  workerRoles WorkerRole[]
  // views.prisma, alerts.prisma: the saved views shared with its holders, the alert rules that tell them.
  savedViews  SavedView[]
  alertRules  AlertRule[]
  // W2b-5 approvals.prisma (wave 35/44): the approval rules and the requests whose yes its holders give.
  approvalRules ApprovalRule[] @relation("ApprovalRuleApproverRole")
  approvalTasks ApprovalTask[] @relation("ApprovalTaskApproverRole")
  // W2b quality.prisma (wave 11/16): the quality alert rules that tell them.
  qualityAlertRules QualityAlertRule[]

  @@unique([tenantId, key])
  // The target of the tenant-safe references from the assignments.
  @@unique([tenantId, id])
}

enum RoleAudience {
  OFFICE
  /// Given to floor workers (floor-auth.prisma WorkerRole), held only by a floor session on an enrolled device.
  FLOOR
  /// W2b (B-W2b-152; PLT-006, SAL-060, SCM-092): given to partner users (User.audience PARTNER), each assignment bound to
  /// the person's own party; held only by a portal session. At most the price grain (the guards; never cost, margin,
  /// wages or pay), and only partner permissions (the API). The audience of a role never changes to or from PARTNER.
  PARTNER
}

/// One role given to one person, limited to some companies, sites and parties, for a time. Never deleted: ending an
/// assignment sets endedAt, so the history says who could do what, when. W2b (B-W2b-152): a PARTNER role goes only to a
/// partner user and a partner user holds only PARTNER roles, each assignment bound to exactly the person's own party
/// (partyIds = [their party], no site limit; the guards).
model RoleAssignment {
  id           String    @id @db.Uuid
  tenantId     String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  userId       String    @db.Uuid
  roleId       String    @db.Uuid
  /// Every company of the tenant, also those added later. Otherwise exactly companyIds (never empty then).
  allCompanies Boolean   @default(false)
  companyIds   String[]  @default([]) @db.Uuid
  /// Empty: no site limit (every site of the companies reached).
  siteIds      String[]  @default([]) @db.Uuid
  /// Empty: no party limit. Otherwise only the records of these customers or suppliers (a sales rep's accounts).
  partyIds     String[]  @default([]) @db.Uuid
  validFrom    DateTime  @db.Timestamptz(3)
  /// A planned end (cover during a holiday); null: until ended.
  validTo      DateTime? @db.Timestamptz(3)
  grantedById  String?   @db.Uuid
  endedAt      DateTime? @db.Timestamptz(3)
  endedById    String?   @db.Uuid
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, userId])
  @@index([tenantId, roleId])
}
