// The tenancy core: the tenant (one manufacturing group), its companies (legal entities), their sites, and the floor
// structure of a site: lines, stations and work centres. The generator and the datasource live in schema.prisma.
//
// Conventions (plan A1 §2.1), for every model in every file of this folder:
//   - `id String @id @db.Uuid`, made by the app (UUIDv7 from newId()); no cuid(), no autoincrement.
//   - Tenant tables carry `tenantId` with the default below: the app never sets it, the policy's WITH CHECK refuses a
//     wrong one, and without a tenant scope the insert fails (NULL into a NOT NULL column).
//   - References inside a tenant include `tenantId` (and `siteId` where both rows sit on a site), so a row can never
//     point at another tenant's or another site's row: foreign-key checks skip row-level security, these keys do not.
//   - `version` for compare-and-set updates; `createdAt`, `updatedAt` as timestamptz; `createdById` (a user id; the
//     user table comes with sign-in).
//   - Master data in use is archived (status ARCHIVED), never deleted; no cascade deletes.
// Who may read and write each model: ownership/_core.json. Every model must be classified there.

/// One manufacturing group: the row-level-security wall. A platform table: only factory_platform lists and creates
/// tenants; a tenant session reads its own row.
model Tenant {
  id            String       @id @db.Uuid
  slug          String       @unique
  name          String
  status        TenantStatus @default(ACTIVE)
  defaultLocale String       @default("it")
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById   String?      @db.Uuid

  companies Company[]
  // auth.prisma: the people of the tenant.
  users     User[]
  // roles.prisma: the tenant's system and custom roles.
  roles     Role[]
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A legal entity of the tenant: the seller on quotes, DDTs and invoices (FatturaPA CedentePrestatore). Many per tenant.
model Company {
  id                   String       @id @db.Uuid
  tenantId             String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// Short code, unique in the tenant; the Office URL /w/<code>/… uses it.
  code                 String
  legalName            String
  tradeName            String?
  /// Partita IVA, with its country prefix (IT…).
  vatNumber            String?
  /// Codice fiscale.
  fiscalCode           String?
  /// FatturaPA RegimeFiscale code (RF01 ordinary, …); checked by the invoicing module, not by an enum here.
  regimeFiscale        String?
  /// REA registration: the province of the office and the number.
  reaOffice            String?
  reaNumber            String?
  /// Capitale sociale. Decimal, not Int minor units: it can pass the Int cap of a document amount.
  shareCapital         Decimal?     @db.Decimal(18, 2)
  /// A S.p.A. or S.r.l. with one shareholder: its documents say so (c.c. art. 2250 c. 4; FatturaPA SocioUnico SU).
  soleShareholder      Boolean      @default(false)
  /// In liquidation: its documents say so after its name (c.c. art. 2250 c. 3; FatturaPA StatoLiquidazione LS).
  inLiquidation        Boolean      @default(false)
  /// The registered office: { line1, line2?, postalCode, city, province?, country }.
  address              Json?
  pec                  String?
  /// Codice destinatario for invoices this company receives through SDI.
  sdiReceiverCode      String?
  /// ISO 3166-1 alpha-2.
  country              String       @default("IT")
  /// Base currency, ISO 4217.
  currency             String       @default("EUR")
  timezone             String       @default("Europe/Rome")
  locale               String       @default("it")
  /// Month (1-12) the fiscal year starts in.
  fiscalYearStartMonth Int          @default(1)
  /// Footer text printed on this company's documents.
  documentFooter       String?
  /// The logo file (FileObject, which comes with files on R2).
  logoFileId           String?      @db.Uuid
  /// The bank account the company's customers pay to (Q12: deposits by bank transfer; FatturaPA DatiPagamento MP05):
  /// the account holder, the IBAN (country, check digits, ISO 7064 mod 97-10; upper case, no spaces), the BIC and the
  /// bank's name. All four null, or the holder and the IBAN set. Written only by the office with a step-up and audited
  /// from → to (a changed IBAN is a fraud vector); the floor and the partner role never select them: a deposit page or a
  /// document shows them read in the tenant's system scope (modules/sales/deposits companyBankDetails).
  bankAccountHolder    String?
  iban                 String?
  bic                  String?
  bankName             String?
  status               MasterStatus @default(ACTIVE)
  version              Int          @default(1)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?      @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sites        Site[]
  numberSeries NumberSeries[]
  // auth.prisma: the sessions that start in this company.
  sessions     Session[]
  // integration.prisma: the company's accounts with outside services.
  integrationAccounts IntegrationAccount[]
  // files.prisma: the company's files.
  files               StoredFile[]
  // links.prisma: the one-off links that open the company's records.
  oneOffLinks         OneOffLink[]
  // threads.prisma: the threads of the company's records.
  threads             Thread[]
  // imports.prisma: the company's imports.
  importJobs          ImportJob[]
  // parties.prisma: the parties of this company only (tenant-wide ones have none), and the VIES checks it requested.
  parties             Party[]
  viesChecks          ViesCheck[]
  // email.prisma: the company's sending identities (its mail goes out through them).
  emailIdentities     EmailIdentity[]
  // product.prisma: the company's own master data (tenant-wide rows have none).
  colours              Colour[]
  items                Item[]
  sizeScales           SizeScale[]
  styles               Style[]
  operations           Operation[]
  measurementTemplates MeasurementTemplate[]
  // compliance.prisma: the certificates it holds, its label templates and compliance documents.
  certificates         Certificate[]
  labelTemplates       LabelTemplate[]
  complianceDocuments  ComplianceDocument[]
  // email-in.prisma: the mail received through the company's SES account.
  inboundEmails        InboundEmail[]
  // sales.prisma: its quotes, sales orders and deposit requests.
  quotes               Quote[]
  salesOrders          SalesOrder[]
  depositRequests      DepositRequest[]
  // quality.prisma: its PPE register and its quality settings (the Cr VI evidence rule).
  ppeRegisterEntries   PpeRegisterEntry[]
  qualitySettings      QualitySettings[]
  // money.prisma: its invoices and the payments it received.
  invoices             Invoice[]
  payments             Payment[]
  // W2a receivables.prisma, payables.prisma, cost-ledger.prisma, accounting.prisma (wave 7/7): its refunds, payment
  // reminders and receivables settings, the supplier invoices it received, its standard costs, accounting exports and
  // period locks.
  refunds              Refund[]
  paymentReminders     PaymentReminder[]
  receivablesSettings  ReceivablesSettings[]
  supplierInvoices     SupplierInvoice[]
  /// @not-money the relation to its standard costs (the rows carry the grain)
  standardCosts        StandardCost[]
  accountingExports    AccountingExport[]
  periodLocks          PeriodLock[]
  // costing.prisma: its own labour rates and costing settings (tenant-wide rows have none).
  labourRates          LabourRate[]
  /// @not-money the relation to its costing settings rows (an overhead percentage, no amount)
  costingSettings      CostingSettings[]
  // sales.prisma: the company's sales settings (its margin floor, discount limit, validity and deposit).
  salesSettings        SalesSettings[]
  // privacy.prisma: its privacy notices, DPIAs and record of processing activities.
  privacyNotices       PrivacyNotice[]
  privacyDpias         PrivacyDpia[]
  processingActivities ProcessingActivity[]
  // pricing.prisma, complaints.prisma: its payment terms and price lists (tenant-wide rows have none), its complaints.
  paymentTerms         PaymentTerms[]
  /// @not-money the relation to its price lists
  priceLists           PriceList[]
  complaints           Complaint[]
  // calendar.prisma: its calendars (its own and its sites', lines', workshops' and suppliers') and its shift patterns.
  workCalendars        WorkCalendar[]
  shiftPatterns        ShiftPattern[]
  // views.prisma: the saved views of its lists and the reports sent about it.
  savedViews           SavedView[]
  reportSubscriptions  ReportSubscription[]
  // alerts.prisma: the alert rules that look at it.
  alertRules           AlertRule[]
  // W2a sourcing.prisma: the approved sources held for the company only.
  supplierItems        SupplierItem[]

  @@unique([tenantId, code])
  // The target of the tenant-safe references from the company's rows.
  @@unique([tenantId, id])
}

/// A plant, warehouse or office of a company. Physical rows (stock, work orders, scans, devices…) carry its siteId.
model Site {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId   String       @db.Uuid
  /// Short code, unique in the tenant; used in document numbers and on labels.
  code        String
  name        String
  kind        SiteKind
  /// { line1, line2?, postalCode, city, province?, country }.
  address     Json?
  timezone    String       @default("Europe/Rome")
  /// The languages its floor workers read (PLT-128, B-W2a-41): ISO 639 codes, at least one, no repeats. A language is
  /// offered on the site's tablets only with the worker notice in it (the API checks it; Owner list Q23).
  floorLocales String[]    @default(["it", "en"])
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  company       Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines         Line[]
  workCentres   WorkCentre[]
  stations      Station[]
  // files.prisma: the files shared with this site's floor.
  floorFiles    StoredFile[]
  // floor-auth.prisma: the site's enrolled devices, floor workers and floor session times.
  devices       Device[]
  workers       Worker[]
  floorSettings FloorSettings[]
  // threads.prisma: the threads of the site's records.
  threads       Thread[]
  // print.prisma: the site's printers.
  printers      Printer[]
  // sales.prisma: the sales order lines it makes.
  salesOrderLines SalesOrderLine[]
  // supply.prisma: the purchase orders delivered to it and its planning runs.
  purchaseOrders  PurchaseOrder[]
  planningRuns    PlanningRun[]
  // W2a reservations.prisma, stockcount.prisma, planning.prisma: its reservations and stock counts; its planning settings,
  // item parameters, line and work-centre capacity and planning exceptions; the item parameters of other sites it makes for.
  reservations         Reservation[]
  stockCounts          StockCount[]
  planningSettings     PlanningSettings[]
  itemPlannings        ItemPlanning[]
  lineCapacities       LineCapacity[]
  workCentreCapacities WorkCentreCapacity[]
  planningExceptions   PlanningException[]
  madeItemPlannings    ItemPlanning[]       @relation("ItemPlanningMakeSite")
  // inventory.prisma: its locations, goods receipts, lots, stock moves and their values.
  locations       Location[]
  goodsReceipts   GoodsReceipt[]
  lots            Lot[]
  stockMoves      StockMove[]
  stockValuations StockValuation[]
  // production.prisma: its floor rules and the work orders it makes.
  productionSettings ProductionSettings[]
  workOrders         WorkOrder[]
  // quality.prisma: its final inspections, quality releases and their reversals.
  inspections             Inspection[]
  qualityReleases         QualityRelease[]
  qualityReleaseReversals QualityReleaseReversal[]
  // quality.prisma: the lab results and supplier documents of its lots.
  labResults              LabResult[]
  lotDocuments            LotDocument[]
  // W2a holds.prisma, ncr.prisma, plant.prisma: the goods it has on hold, its nonconformances, its machines, their
  // requests and maintenance jobs.
  qualityHolds            QualityHold[]
  nonconformances         Nonconformance[]
  machines                Machine[]
  maintenanceRequests     MaintenanceRequest[]
  maintenanceJobs         MaintenanceJob[]
  // production.prisma: its garment label prints (B-W1-44) and bundle ticket reprints.
  garmentLabelPrints      GarmentLabelPrint[]
  bundleReprints          BundleReprint[]
  // floor-sync.prisma: the refused queued actions of its tablets.
  refusedActions          FloorRefusedAction[]
  // shipping.prisma: its shipping settings, the shipments that leave it and their DDTs.
  shippingSettings   ShippingSettings[]
  shipments          Shipment[]
  ddts               Ddt[]
  // W2b gendocs.prisma (B-W2b-01): the documents generated for its records (packing lists, claim letters, job sheets).
  generatedDocuments GeneratedDocument[]
  // returns.prisma: the returns coming back to it and the repairs it makes.
  returnAuthorisations ReturnAuthorisation[]
  repairOrders         RepairOrder[]
  // calendar.prisma, views.prisma, alerts.prisma: its calendar, the reports sent about it, the alert rules that look at it.
  workCalendars       WorkCalendar[]
  reportSubscriptions ReportSubscription[]
  alertRules          AlertRule[]
  // W2a claims.prisma, subcontract.prisma: the claims about goods at the site, the work it sends to workshops.
  supplierClaims     SupplierClaim[]
  subcontractOrders  SubcontractOrder[]
  // W2a rework.prisma, schedule.prisma: its rework and replacements, its working plan and published plans.
  reworkOrders        ReworkOrder[]
  replacementRequests ReplacementRequest[]
  planVersions        PlanVersion[]

  @@unique([tenantId, code])
  @@unique([tenantId, companyId, id])
}

enum SiteKind {
  PLANT
  WAREHOUSE
  OFFICE
}

/// A production line of a site (a sewing line, a cutting room, a finishing cell). Its stations sit on it.
model Line {
  id          String       @id @db.Uuid
  tenantId    String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId   String       @db.Uuid
  siteId      String       @db.Uuid
  /// Short code, unique on the site.
  code        String
  name        String
  status      MasterStatus @default(ACTIVE)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?      @db.Uuid

  site     Site      @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  stations Station[]
  // W2a planning.prisma: its planned efficiency and people (one row, the line's id).
  capacity LineCapacity[]
  // calendar.prisma: its calendar.
  workCalendars WorkCalendar[]
  // W2a production.prisma, schedule.prisma: the work orders allocated to it, its slots on the planning board.
  workOrders    WorkOrder[]
  scheduleSlots ScheduleSlot[]

  @@unique([tenantId, siteId, code])
  @@unique([tenantId, siteId, id])
}

/// A kind of work on a site with its own capacity (cutting, sewing, inspection…). Routing operations run at a work
/// centre; a station belongs to one.
model WorkCentre {
  id          String         @id @db.Uuid
  tenantId    String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId   String         @db.Uuid
  siteId      String         @db.Uuid
  /// Short code, unique on the site.
  code        String
  name        String
  kind        WorkCentreKind
  status      MasterStatus   @default(ACTIVE)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?        @db.Uuid

  site     Site      @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  stations Station[]
  // W2a planning.prisma: its planned units and efficiency (one row, the work centre's id).
  capacity WorkCentreCapacity[]
  // production.prisma: the work order operations mapped to it.
  workOrderOperations WorkOrderOperation[]
  // W2a plant.prisma: its machines.
  machines            Machine[]
  // calendar.prisma: its calendar (a workshop's).
  workCalendars       WorkCalendar[]
  // W2a schedule.prisma: its slots on the planning board.
  scheduleSlots       ScheduleSlot[]

  @@unique([tenantId, siteId, code])
  @@unique([tenantId, siteId, id])
}

enum WorkCentreKind {
  CUTTING
  SEWING
  ASSEMBLY
  FINISHING
  INSPECTION
  PACKING
  SUBCONTRACT
}

/// One place where work is done and scanned; a floor device is enrolled to a station. It sits on a line, or stands
/// alone on the site (a cutting table, an inspection bench), and belongs to one work centre, which says what work it does.
model Station {
  id           String       @id @db.Uuid
  tenantId     String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId    String       @db.Uuid
  siteId       String       @db.Uuid
  /// Empty for a station that stands alone; a set line is on the same site (the reference includes tenantId and siteId).
  lineId       String?      @db.Uuid
  workCentreId String       @db.Uuid
  /// Short code, unique on the site; printed on the station's label.
  code         String
  name         String
  /// The label printer of the station (MES-184; print.prisma): a LABEL_ZPL printer of the same site where its devices'
  /// bundle tickets print when they name no printer. Empty: the site's own label printer, if it has only one.
  labelPrinterId String?    @db.Uuid
  status       MasterStatus @default(ACTIVE)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById  String?      @db.Uuid

  site       Site       @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and siteId.
  line       Line?      @relation(fields: [tenantId, siteId, lineId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  workCentre WorkCentre @relation(fields: [tenantId, siteId, workCentreId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, companyId, siteId.
  labelPrinter Printer? @relation(fields: [tenantId, companyId, siteId, labelPrinterId], references: [tenantId, companyId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  // floor-auth.prisma: the devices enrolled at this station.
  devices    Device[]
  // production.prisma: the cut logs and scans that name the station (a site that records stations, not workers).
  cutLogs        CutLog[]
  operationScans OperationScan[]
  // W2a plant.prisma: the machines standing at it and the requests it reported.
  machines            Machine[]
  maintenanceRequests MaintenanceRequest[]
  // B-W1-42: correction requests asked and refused scans sent at the station.
  scanCorrectionRequests ScanCorrectionRequest[]
  scanRefusals           FloorScanRefusal[]
  // floor-sync.prisma: the refused queued actions of its tablets.
  refusedActions         FloorRefusedAction[]

  @@unique([tenantId, siteId, code])
  // The target of the tenant- and site-safe references from the station's rows (a device at a station).
  @@unique([tenantId, siteId, id])
}

/// Master data in use is archived, never deleted.
enum MasterStatus {
  ACTIVE
  ARCHIVED
}
