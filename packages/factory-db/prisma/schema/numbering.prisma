// Number series and the numbers they issued (plan A1 §2.3 NumberSeries, §3.9; PLAN §2.8; features PLT-122, PLT-123).
// The formats, kinds and rules live in @nexus/factory-domain/numbering; apps/factory-api's allocateNumber takes a
// number inside the issuing command's transaction (src/platform/numbering/allocate.ts).
//
// Gapless: a number is taken under the series row's lock (SELECT … FOR UPDATE) and the counter moves in the same
// transaction as the document, its NumberAllocation row and its audit row, so a rolled-back command consumes nothing
// and two commands never get the same number. The hand-written migration …_numbering_guards adds what Prisma does not
// model: a series' counter never moves back and its pattern, start and identity are fixed once it moved (trigger), and
// NumberAllocation is append-only (`@append-only`, scripts/factory/check-append-only.mjs).
//
// Floor tablets number the floor's document kinds (@nexus/factory-domain/numbering/kinds FLOOR_DOCUMENT_KINDS: goods
// receipts, lots, inspections, releases) from their own commands, online, through the same allocateNumber: the floor's
// policies reach only the series and numbers of those kinds (ownership/numbering.json onlyValues), and the hand-written
// …_numbering_floor_documents_guards triggers hold that a tablet never touches a fiscal series, numbers only for its own
// site's company, moves a counter one number at a time past a number it recorded, and adds only a new year of a series.

/// One counter: the numbers of one kind of document of one company, in one series (sezionale) and one period (the
/// calendar year of a yearly series, `ALL` for one that never resets). A new year's row is made from the family's
/// newest row when its first number is taken. Closed (status CLOSED), never deleted.
model NumberSeries {
  id             String             @id @db.Uuid
  tenantId       String             @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId      String             @db.Uuid
  kind           NumberKind
  /// The series inside the company and kind (sezionale): `MAIN`, `A`, `B`… (1-16 capitals, digits, hyphens).
  code           String
  /// The period the counter runs in: the calendar year (`2026`) when reset is YEARLY, `ALL` when NEVER.
  scopeKey       String
  reset          NumberReset
  /// The printed form, e.g. `FT-{YYYY}-{N:5}` (@nexus/factory-domain/numbering/format). Fixed once a number is issued.
  pattern        String
  /// An invoice, deposit invoice, credit note or DDT series (DPR 633/1972 art. 21; DPR 472/1996): no gap, no reuse,
  /// no date before the last number's, at most 20 characters. Set from the kind.
  fiscal         Boolean
  /// The first number of the period: 1, or where a paper booklet or the accountant's software stopped plus one.
  startValue     Int                @default(1)
  /// The number the next document gets. Only moves forward once it left startValue.
  nextValue      Int                @default(1)
  /// The business date (Europe/Rome) of the newest document numbered here: a fiscal series refuses an earlier one.
  lastIssuedDate DateTime?          @db.Date
  status         NumberSeriesStatus @default(ACTIVE)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  /// Who made the row: a user, the system actor, or the tablet whose command opened a new year (the ledger names no
  /// worker: L. 300/1970 art. 4; the audit row keeps who was signed in).
  createdById    String?            @db.Uuid

  company     Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  allocations NumberAllocation[]
  // shipping.prisma: the DDTs numbered from it.
  ddts        Ddt[]
  // money.prisma: the invoices and credit notes numbered from it.
  invoices    Invoice[]

  @@unique([tenantId, companyId, kind, code, scopeKey])
  // The target of the allocations' tenant- and company-safe reference.
  @@unique([tenantId, companyId, id])
}

/// What a series numbers (the same list as NUMBER_KINDS in @nexus/factory-domain/numbering/kinds). Additive.
enum NumberKind {
  QUOTE
  SALES_ORDER
  PURCHASE_ORDER
  GOODS_RECEIPT
  WORK_ORDER
  SHIPMENT
  DDT
  INVOICE
  DEPOSIT_INVOICE
  CREDIT_NOTE
  /// A return authorisation's number (RMA-…; returns.prisma ReturnAuthorisation.number).
  RETURN
  LOT
  BATCH
  /// The PPE register's entries (REG-…; quality.prisma PpeRegisterEntry.reference).
  PPE_REGISTER
  /// Scan-id kinds (@nexus/factory-domain/numbering/kinds SCAN_ID_KINDS): ONE tenant-wide counter each, kept as the
  /// NumberBlock ledger below, never a NumberSeries (the …_numbering_floor_guards triggers refuse both ways).
  /// A bundle ticket's code (BN-…; production.prisma Bundle.code).
  BUNDLE
  /// A hide's tag (HD-…; inventory.prisma Hide.code).
  HIDE
  /// A finished garment's serial (SN-…).
  GARMENT_SERIAL
  /// A final inspection's number (INS-…; quality.prisma Inspection.number). A floor document kind: the bench numbers it.
  INSPECTION
  /// A quality release's number (REL-…; quality.prisma QualityRelease.number). A floor document kind too.
  RELEASE
  /// A repair order's number (REP-…; returns.prisma RepairOrder.number).
  REPAIR
  /// A customer complaint's number (CMP-…; complaints.prisma Complaint.number).
  COMPLAINT
  /// W2a wave 3: a supplier claim's number (CLM-…; claims.prisma SupplierClaim.number).
  CLAIM
  /// W2a wave 3: a subcontract order's number (SC-…; subcontract.prisma SubcontractOrder.number).
  SUBCONTRACT
}

enum NumberReset {
  YEARLY
  NEVER
}

/// A closed series issues no more numbers.
enum NumberSeriesStatus {
  ACTIVE
  CLOSED
}

/// One issued number: which series gave which number to which record, when, for whom. Written by allocateNumber in
/// the issuing command's transaction; never changed or removed (a voided document keeps its number).
/// @append-only
model NumberAllocation {
  /// UUIDv7 from newId().
  id            String     @id @db.Uuid
  tenantId      String     @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId     String     @db.Uuid
  seriesId      String     @db.Uuid
  /// The series' kind, kept here for the one-number-per-record key.
  kind          NumberKind
  value         Int
  /// The number as printed on the document (the series' pattern, fixed once used, so it is unique like the value).
  formatted     String
  /// The document's business date (Europe/Rome).
  documentDate  DateTime   @db.Date
  /// The numbered record: its model name and id.
  recordType    String
  recordId      String     @db.Uuid
  /// The command's server time.
  allocatedAt   DateTime   @db.Timestamptz(3)
  /// The caller of the command: a user, the system actor of a job, or the tablet of a floor command (the ledger names
  /// no worker: L. 300/1970 art. 4; the audit row keeps who was signed in).
  allocatedById String     @db.Uuid
  /// The request (or job) that issued it, as on its audit rows.
  requestId     String

  series NumberSeries @relation(fields: [tenantId, companyId, seriesId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)

  // Never the same number twice in a series period.
  @@unique([tenantId, seriesId, formatted])
  // A record gets one number of each kind.
  @@unique([tenantId, recordType, recordId, kind])
  @@index([tenantId, seriesId, value])
}

/// A block of scan-id references of one scan-id kind (BUNDLE, HIDE, GARMENT_SERIAL; the `TT-GG-RRRRRR-C` codes of
/// @nexus/factory-domain/numbering/scan-id): the tenant's ledger of every reference handed out (design 02-sections-floor:
/// "tags print offline from numbers reserved per tablet"). A scan id carries the tenant's tag, never the company, so each
/// kind has ONE counter per tenant: the highest `toRef` here. A new block starts above every block of its kind before it
/// (the …_numbering_floor_guards trigger, under the tenant's `factory.scan-ids` lock), so no reference is handed out twice.
/// ONLINE: taken by one command and used by it at once (apps/factory-api allocateScanIds). DEVICE: reserved for one floor
/// tablet, which numbers from it offline; each number it used is a NumberBlockUse row. Gaps are fine: these are not
/// fiscal series. Closed (a lost or retired tablet), never deleted; its range never changes.
model NumberBlock {
  /// UUIDv7 from newId().
  id           String             @id @db.Uuid
  tenantId     String             @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  kind         NumberKind
  purpose      NumberBlockPurpose
  fromRef      Int
  toRef        Int
  /// The tablet a DEVICE block is reserved for (null for ONLINE). Not a foreign key: a Device is keyed by its site, and
  /// this ledger is the tenant's (every tablet reads it whole, to see the counter); the guard trigger checks the device
  /// is ACTIVE and one the inserting session sees (a tablet: its own site's).
  deviceId     String?            @db.Uuid
  status       NumberBlockStatus  @default(ACTIVE)
  /// Why the office closed it (a lost tablet, a retired one): its numbers left are never used.
  closedReason String?
  closedAt     DateTime?          @db.Timestamptz(3)
  /// The request (or job) that took it, as on its audit rows.
  requestId    String
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  uses NumberBlockUse[]

  // The counter: a block starts after the highest one (the trigger); no two blocks share a first or a last reference.
  @@unique([tenantId, kind, fromRef])
  @@unique([tenantId, kind, toRef])
  // The target of the uses' tenant-safe reference.
  @@unique([tenantId, id])
  @@index([tenantId, deviceId, kind])
}

enum NumberBlockPurpose {
  ONLINE
  DEVICE
}

enum NumberBlockStatus {
  ACTIVE
  CLOSED
}

/// One number of a DEVICE block that its tablet used: printed on a label (offline too) and sent with what it numbered.
/// The guard trigger holds that it lies in its block, the block is open and of the same kind and tablet; the unique
/// printed code holds that a number is used once (the code is one-to-one with kind and reference, as NumberAllocation's
/// printed number is with its value). Written by apps/factory-api useScanIds inside the tablet's command; never changed.
/// @append-only
model NumberBlockUse {
  /// UUIDv7 from newId().
  id         String     @id @db.Uuid
  tenantId   String     @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The tablet's site.
  siteId     String     @db.Uuid
  deviceId   String     @db.Uuid
  blockId    String     @db.Uuid
  kind       NumberKind
  ref        Int
  /// The scan id as printed (`HD-7K-0003RJ-M`).
  code       String
  /// The record that took the number: its model name and id (Hide, Bundle, GarmentSerial).
  recordType String
  recordId   String     @db.Uuid
  /// The command's server time.
  usedAt     DateTime   @db.Timestamptz(3)
  /// The request that sent it, as on its audit rows (who is in the audit row, never here: floor rule, L. 300/1970 art. 4).
  requestId  String

  block  NumberBlock @relation(fields: [tenantId, blockId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  device Device      @relation(fields: [tenantId, siteId, deviceId], references: [tenantId, siteId, id], onDelete: Restrict, onUpdate: Restrict)

  // A number is used once in the tenant.
  @@unique([tenantId, code])
  @@index([tenantId, blockId])
  @@index([tenantId, siteId, deviceId])
}
