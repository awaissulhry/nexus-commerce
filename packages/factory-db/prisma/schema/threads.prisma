// Record threads (plan A1 §2.3 Thread / Message, §3.7; features COL-001, COL-002, COL-003, COL-020). Every record
// (an order, a quote, a PO, a lot, a customer …) has at most ONE thread: its conversation. Staff write internal notes
// into it; the email steps write the mail sent to the record's customer or supplier (OUTBOUND) and their replies
// (INBOUND) into the same thread, found by its reply address (`r-<replyToken>@reply.<domain>`). The record's timeline
// (COL-002) is not stored: apps/factory-api's platform/threads merges the record's audit rows, the thread's messages and
// the record's files when it is read, so nothing is written twice.
//
// Who sees what (COL-003: internal notes never reach a customer): a message is for the OFFICE only (every internal
// note) or shared with the record's party (PARTNER: what was sent to them or came from them). `partyId` is set on a
// message exactly when it is shared, and is then the thread's party (the second reference below pins it), so the
// partner role's policy (partyId = its party) reads only the shared messages of its own records. The floor's role reads
// none; a tablet is served the notes of a work order that are `forFloor` by the API, after the floor's checks (B-W2b-F5).
//
// A thread's company, site and party are the record's own, read from the record when the thread is made (a resolver
// per record type in the API), never sent by the caller. Messages are append-only (a correction is a new message);
// rows of either table are never deleted. The guard triggers of the hand-written …_threads_guards migration hold the
// rules for every login.
//
// TH-2 (threads plan, schema wave 4/9, B-TH-023; gaps G10, N2, X-G05): a thread names who answers it (ownerId: one office
// person; none, the record's own: a request's assignee, else its maker, B-TH-028), hidden from the record's party; and
// ThreadRead keeps how far each person has read each thread (the last message they read), so the thread shows "New since your
// last visit" and the lists count new messages (B-TH-027). Office people and the party's portal people have one; the floor
// never (no read record of a floor worker: Statuto dei Lavoratori art. 4, L. 300/1970, no remote watch of a worker), and no
// "seen by" list exists: each person reads only their own (the API), a portal session only its own party's people's (the
// policy), the floor nothing. A read mark is the person's own data: named in the privacy notice, removed with the person's
// erasure (the …_threads_reads_th_guards trigger on ErasureRecord).
//
// TH-3 (threads plan, schema wave 5/9, B-TH-038; gaps N7, thread-G08, thread-G19, thread-G20): the composer in depth. A
// message may carry a typed amount (price grain; internal notes only, hidden from the partner role, never for the floor), the
// message it answers or corrects (same thread; a shared message points only at a shared one), and `held`: the OUTBOUND
// message of a mail waiting in its 10-second undo window, or taken back, which the partner role never reads. Message stays
// append-only: the one change is the database's own release of `held` when its mail leaves the window (…_threads_composer_th_
// guards). collab.prisma's Task names the message it came from; email.prisma's EmailOutbound holds the window and the take-back.
//
// TH-9 (threads plan, schema wave 9/9, B-TH-090; gaps N4, N18): a thread may be Done, a work state apart from CLOSED (an office
// person marked it done for everyone: it leaves the "waiting" views, the customer can still write, and a new shared message
// opens it again: B-TH-093), hidden from the record's party; and ThreadPin keeps the messages pinned on it (who, when, which
// message: "2 pinned"), the office's, of which the party reads only the pins of messages shared with it (B-TH-091).
// collab.prisma's ComposerDraft keeps each person's unsent text per record (B-TH-092).

/// The one conversation of one record (COL-001), made when its first message is written.
model Thread {
  id            String       @id @db.Uuid
  tenantId      String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The record's company (null: a tenant-wide record). Never changes.
  companyId     String?      @db.Uuid
  /// The record's site, when the record sits on one (a work order, a lot). Never changes.
  siteId        String?      @db.Uuid
  /// The record's party (its customer, supplier or subcontractor): the only party its shared messages reach. Set once,
  /// when the thread is made or when the record first has one; never changed after. The parties module adds its
  /// reference.
  partyId       String?      @db.Uuid
  /// The record: its model name (`Quote`, `PurchaseOrder`) and id. One thread per record.
  recordType    String
  recordId      String       @db.Uuid
  /// The reply address's secret part (`r-<replyToken>@reply.<domain>`, COL-020): 26 random lower-case base32
  /// characters (130 bits), unique across every tenant, so the email-in step finds the thread from the address alone.
  /// Never changes; never shown to a partner role.
  replyToken    String
  /// OPEN, or CLOSED (no new notes; the email-in step decides what a reply to a closed thread does).
  status        ThreadStatus @default(OPEN)
  /// When the newest message entered the thread (null: none yet). Moves only later. Hidden from the partner role: it
  /// counts internal notes too.
  lastMessageAt DateTime?    @db.Timestamptz(3)
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  /// Who wrote the first message (a user), or null (the system, an inbound mail).
  createdById   String?      @db.Uuid
  /// TH-2 (schema wave 4/9, B-TH-023; N2, X-G05): who answers this conversation, when someone is named for it: an office
  /// person of the tenant (active when named); null: the record's own owner (a request's assignee, else the record's maker:
  /// B-TH-028). Changed by whoever may post on the thread. Hidden from the partner role (the portal shows no owner).
  ownerId       String?      @db.Uuid
  /// TH-9 (schema wave 9/9, B-TH-090; N18, feature T1-F13): Done, a work state apart from CLOSED: when an office person marked
  /// the conversation done for everyone (not in the future) and who (an active office person when set or changed), both or
  /// neither; null: open work. Never set when the thread is made; the customer can still write (B-TH-093 opens it again on a
  /// new shared message). Hidden from the partner role (the work state is the office's).
  doneAt        DateTime?    @db.Timestamptz(3)
  doneById      String?      @db.Uuid

  company        Company?  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // TH-2 (B-TH-023): who answers it (Restrict, not Prisma's SetNull default for an optional relation: that would also clear
  // tenantId).
  owner          User?     @relation("ThreadOwner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // TH-9 (B-TH-090): who marked it done (Restrict, as above).
  doneBy         User?     @relation("ThreadDoneBy", fields: [tenantId, doneById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // A site-bound record belongs to a company, and the site is one of its sites.
  site           Site?     @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  messages       Message[] @relation("ThreadMessages")
  sharedMessages Message[] @relation("ThreadSharedMessages")
  // email.prisma: the mail sent from this thread.
  emailOutbound  EmailOutbound[]
  // email-in.prisma: the mail received for this thread (joined, or waiting for a person).
  inboundEmails  InboundEmail[]
  // collab.prisma: the @mentions in its notes.
  mentions       MessageMention[]
  // TH-2 (B-TH-023): how far each person has read it, and the portal people's marks (they name its party).
  reads          ThreadRead[] @relation("ThreadReads")
  sharedReads    ThreadRead[] @relation("ThreadSharedReads")
  // TH-9 (B-TH-090): the messages pinned on it.
  pins           ThreadPin[]

  @@unique([tenantId, recordType, recordId])
  @@unique([replyToken])
  // The targets of the messages' tenant-safe references: the thread, and the thread with its party.
  @@unique([tenantId, id])
  @@unique([tenantId, id, partyId])
  @@index([tenantId, partyId])
  // TH-2 (B-TH-023): the conversations a person answers.
  @@index([tenantId, ownerId])
}

/// OPEN → CLOSED → OPEN (threads.manage).
enum ThreadStatus {
  OPEN
  CLOSED
}

/// One message of a thread: an internal note, a message sent to the record's party, or one received from it. Never
/// changes and is never deleted (a correction is a new message).
/// @append-only
model Message {
  /// UUIDv7 from newId(), so a thread's messages sort in time order.
  id                String            @id @db.Uuid
  tenantId          String            @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  threadId          String            @db.Uuid
  /// The thread's party, set exactly when the message is shared with it (audience PARTNER): the partner role's policy
  /// key. Null on every internal note.
  partyId           String?           @db.Uuid
  direction         MessageDirection
  /// OFFICE: staff only (every internal note; `forFloor` says when the tablets read one too). PARTNER: shared with the
  /// thread's party (sent to it or received from it).
  audience          MessageAudience
  channel           MessageChannel
  authorKind        MessageAuthorKind
  /// The user (USER), floor worker (WORKER) or party contact (PARTY) who wrote it; null for the system and for an
  /// inbound sender who is not a known contact. Hidden from the partner role.
  authorId          String?           @db.Uuid
  /// The author's name as shown when it was written (the portal and the mail show it).
  authorName        String?
  /// The text: what staff typed, or the plain-text part of an inbound mail.
  bodyText          String
  /// The sanitised HTML of an inbound mail (the email-in step's sanitiser). Never set from the app's composer.
  bodyHtml          String?
  /// The office users this internal note notifies (an event per user). Hidden from the partner role.
  /// W2b (B-W2b-156): the default is the database's, so a Prisma insert leaves the column out: a portal session posts
  /// (COL-060) without a grant on it. A cast from text, so Prisma reads it back as it is written.
  mentionedUserIds  String[]          @default(dbgenerated("('{}'::text)::uuid[]")) @db.Uuid
  /// True: the tablets working on the work order read this internal note too (B-W2b-F5): its writer in the office ticked
  /// "For the floor", or the floor wrote it. False, the default, for every other message: it stays in the office. Set
  /// when it is written, like the rest of the message. Hidden from the partner role.
  /// @internal
  /// W2b (B-W2b-156): the default is the database's, as mentionedUserIds' (a portal post leaves it out).
  forFloor          Boolean           @default(dbgenerated("('false'::text)::boolean"))
  /// The record's files attached to it, in order (StoredFile ids; files are never deleted, only marked DELETED). Each
  /// reader sees only the ones its own file rules let it see.
  attachmentFileIds String[]          @default([]) @db.Uuid
  /// The RFC 5322 Message-ID (outbound: ours; inbound: the sender's), for In-Reply-To and References and to take an
  /// inbound mail once. Unique in the tenant.
  emailMessageId    String?
  /// When it entered the thread: posted (server time) or received (an inbound mail's arrival).
  at                DateTime          @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  /// TH-3 (threads plan, schema wave 5/9, B-TH-038; gap N7, feature T8-F04): a price typed in the composer's amount field
  /// instead of the text, in minor units (cents) of `amountCurrency` (ISO 4217): both or neither, 0 or more. Only on an
  /// internal note that stays in the office (never `forFloor`), so the API shows it only to people with the price grain
  /// (B-TH-049) and the text keeps no money. Hidden from the partner role; the floor's role reads no message. Written with
  /// the note, never changed.
  /// @grain price
  amount            Int?
  /// @not-money the ISO 4217 currency of the amount (hidden with it from the portal; the floor reads no message)
  amountCurrency    String?
  /// TH-3 (B-TH-038; thread-G20, features T3-F07, T3-F11): the message it answers ("In reply to") or corrects ("Correct":
  /// messages are never edited, a correction is a new message linked to the old one), at most one of the two: a message of
  /// the same thread (the reference includes the thread), written before it. A message shared with the party answers or
  /// corrects only a message shared with it (never an internal note, never a held mail); a correction keeps the direction
  /// (so the audience) of what it corrects. Written with the message, never changed.
  replyToMessageId  String?           @db.Uuid
  correctsMessageId String?           @db.Uuid
  /// TH-3 (B-TH-038; thread-G08, feature T7-F06, Owner decision 6 "undo send, 10 seconds"): true while the mail that carries
  /// this OUTBOUND message waits in its undo window (EmailOutbound.sendAfter), and for good when that mail is taken back
  /// (WITHDRAWN). The database clears it, once, when the mail leaves the window (the worker claims it, or it fails); nothing
  /// else of the message changes. The partner role reads only messages that are not held, so a customer never sees a mail
  /// that was taken back (its policy: onlyValues). False for every other message.
  held              Boolean           @default(false)

  thread       Thread  @relation("ThreadMessages", fields: [tenantId, threadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // A shared message names its thread's own party: the reference is checked whenever partyId is set.
  sharedThread Thread? @relation("ThreadSharedMessages", fields: [tenantId, threadId, partyId], references: [tenantId, id, partyId], onDelete: Restrict, onUpdate: Restrict)
  // collab.prisma: one row per office user the note mentions.
  mentions     MessageMention[]
  // W2b notify-depth.prisma (wave 47/57): the reminders about it.
  reminders    Reminder[]
  // TH-2 (B-TH-023): the read marks that stop at it.
  readMarks    ThreadRead[]
  // TH-3 (B-TH-038): the message it answers or corrects, in its own thread (the reference includes the thread), and the
  // messages that answer or correct it. Restrict, not Prisma's SetNull default for an optional relation: that would also
  // clear tenantId and threadId.
  replyTo      Message?  @relation("MessageReplies", fields: [tenantId, threadId, replyToMessageId], references: [tenantId, threadId, id], onDelete: Restrict, onUpdate: Restrict)
  replies      Message[] @relation("MessageReplies")
  corrects     Message?  @relation("MessageCorrections", fields: [tenantId, threadId, correctsMessageId], references: [tenantId, threadId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections  Message[] @relation("MessageCorrections")
  // collab.prisma (TH-3, B-TH-038): the tasks made from it.
  tasks        Task[]
  // TH-9 (B-TH-090): its pin, when it is pinned.
  pins         ThreadPin[]

  @@unique([tenantId, emailMessageId])
  // The target of the mentions' tenant-safe reference.
  @@unique([tenantId, id])
  // TH-3 (B-TH-038): the target of a reply's and a correction's reference (a message of the same thread).
  @@unique([tenantId, threadId, id])
  // A thread's messages, newest first (the record panel and the timeline).
  @@index([tenantId, threadId, at])
  @@index([tenantId, partyId])
}

/// Which way a message went.
enum MessageDirection {
  /// Written by staff for staff (COL-003): never reaches a party.
  INTERNAL_NOTE
  /// Sent to the record's party (the email-out step; the portal later).
  OUTBOUND
  /// Received from the record's party (the email-in step; the portal later).
  INBOUND
}

/// Who may read a message.
enum MessageAudience {
  /// The office staff only.
  OFFICE
  /// The office and the thread's party (its portal users and its one-off link for the record).
  PARTNER
}

/// How a message came in or went out.
enum MessageChannel {
  /// Written in the factory app.
  APP
  EMAIL
  PORTAL
}

/// Who wrote a message.
enum MessageAuthorKind {
  USER
  WORKER
  PARTY
  SYSTEM
}

/// TH-2 (threads plan, schema wave 4/9, B-TH-023; G10): how far one person has read one thread: the last message they read
/// there and when. One row per thread and person, made when they first open it, moved as they read (or back: "Mark unread"),
/// removed by "Mark unread" on a whole thread and with the person's erasure (GDPR art. 17). An office person, or a portal
/// person of the thread's party (whose row names that party: the partner policy's key); never a floor worker (Statuto dei
/// Lavoratori art. 4: no read record of the floor). Nobody reads another person's marks: no "seen by" list (the API keeps
/// each person to their own; a portal session sees only its own party's people's rows, the floor none).
model ThreadRead {
  id                String   @id @db.Uuid
  tenantId          String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  threadId          String   @db.Uuid
  /// The person: an office user, or a portal user of the thread's party. Never changes.
  userId            String   @db.Uuid
  /// `read:<threadId>:<userId>`: one mark per thread and person (the unique key, as a person's dashboard layout's). Never
  /// changes.
  key               String
  /// A portal person's party, the thread's own, set exactly when the person is a portal user (and then theirs); null for an
  /// office person. Never changes.
  partyId           String?  @db.Uuid
  /// The newest message the person has read: a message of this thread; a portal person's, one shared with their party.
  lastReadMessageId String   @db.Uuid
  /// When they read it (server time; not in the future).
  readAt            DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  thread          Thread  @relation("ThreadReads", fields: [tenantId, threadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // A portal person's mark names its thread's own party: the reference is checked whenever partyId is set.
  sharedThread    Thread? @relation("ThreadSharedReads", fields: [tenantId, threadId, partyId], references: [tenantId, id, partyId], onDelete: Restrict, onUpdate: Restrict)
  user            User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lastReadMessage Message @relation(fields: [tenantId, lastReadMessageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // One mark per thread and person (the key).
  @@unique([tenantId, key])
  // A person's marks (the lists' new-message counts, the erasure).
  @@index([tenantId, userId])
  @@index([tenantId, partyId])
}

/// TH-9 (threads plan, schema wave 9/9, B-TH-090; gap N4, features T2-F07, T3-F12, PROJ.thread-F06): a message pinned on its
/// thread ("2 pinned"; a project's outcome and key decisions): which message, who pinned it and when. One pin per message; never
/// changed (unpinning removes it, the audit keeps who did what). Pinned by the office (B-TH-091); the record's party reads the
/// pins of the messages shared with it, never a pin of an internal note nor who pinned it.
model ThreadPin {
  id         String   @id @db.Uuid
  tenantId   String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  threadId   String   @db.Uuid
  /// The message pinned: a message of this thread (the reference includes the thread), never a held one (a mail in its undo
  /// window or taken back).
  messageId  String   @db.Uuid
  /// The message's party, copied by the database at insert (the app never writes it): set exactly when the pinned message is
  /// shared with the thread's party (the partner policy's key); null for a pinned internal note.
  partyId    String?  @db.Uuid
  /// `pin:<threadId>:<messageId>`: a message is pinned once (the unique key; the isolation tests' copies add a `-…` suffix, as a
  /// read mark's key takes one).
  key        String
  /// Who pinned it (an active office person) and when (server time, not in the future). Hidden from the partner role.
  pinnedById String   @db.Uuid
  pinnedAt   DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  thread   Thread  @relation(fields: [tenantId, threadId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  message  Message @relation(fields: [tenantId, threadId, messageId], references: [tenantId, threadId, id], onDelete: Restrict, onUpdate: Restrict)
  pinnedBy User    @relation("ThreadPinPinnedBy", fields: [tenantId, pinnedById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // One pin per message (the key).
  @@unique([tenantId, key])
  // A thread's pins (the T2 line).
  @@index([tenantId, threadId])
  @@index([tenantId, partyId])
}
