// Generated documents (W2b schema wave 1/7, B-W2b-01; the B-W2a-25, -43, -44, -48 notes; features LOG-062 packing list,
// SCM-135 the claim letter, SCM-138 the job sheet, SAL-346 the RMA sheet): every version of a document the factory
// makes for one of its records and keeps as a file: the packing lists of a shipment, the letter of a supplier claim, the
// job sheet of a subcontract order or a maintenance job, the RMA sheet of a return. Until W2b these were audit rows
// (`shipping.packingListVersion`) or print pages; later W2b steps write the rows (B-W2b-14 claim letter, B-W2b-16 RMA
// sheet, B-W2b-19 packing lists), always through command().
//
// One row per version: what was printed (the kind, its language and layout, the number printed on it, a SHA-256
// fingerprint of its contents) and the stored PDF (StoredFile, a file of the same record). Versions count up per record
// and kind; contents that go back to an earlier version are a new version (reusing that version's file when the
// fingerprint is the same), so the newest version is always the current one. Never changed or removed (append-only, for
// every login: the …_followups_stock_w2b_guards triggers); the record is named by type and id (it may be of any later
// wave's table), checked by the trigger to be of the document's company and site.
//
// W2b schema wave 11/16 (B-W2b-79): the quality and safety documents. A record of the whole company (a Capa, a Complaint) has
// no site, so neither has its document: siteId is null there, and the floor reads none of them.
//
// Who sees what (ownership/gendocs.json): the office reads and writes; the floor of the record's site reads the rows (its
// packing station prints the current packing list; the file itself has its own audiences); portal and link sessions
// read none (a customer portal reads its documents through their files, W2b-3).

/// One version of a document made for one record (W2b, B-W2b-01): the kind, version, language, layout, number, the
/// fingerprint of its contents and its stored file.
/// @append-only
model GeneratedDocument {
  id          String                @id @db.Uuid
  tenantId    String                @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The record's company and site (null: a record of the whole company, a Capa or a Complaint).
  companyId   String                @db.Uuid
  siteId      String?               @db.Uuid
  /// The record it was made for: Shipment (PACKING_LIST, CERTIFICATE_OF_CONFORMITY), SupplierClaim (CLAIM_LETTER),
  /// SubcontractOrder or MaintenanceJob (JOB_SHEET), ReturnAuthorisation (RMA_SHEET), Inspection or IncomingInspection
  /// (INSPECTION_REPORT), Nonconformance (NCR_REPORT), Capa (EIGHT_D), Complaint (COMPLAINT_ANSWER), and, once their
  /// tables exist, MachineCheckResult (CHECK_REPORT), RiskAssessmentVersion (DVR_FROZEN), PpeIssue (PPE_RECEIPT).
  /// W2b-5 (wave 39/44): SalesOrder (ORDER_CONFIRMATION). W2b-5 (wave 44/44): MeasurementProfile (MTM_WORKSHEET; a profile
  /// has no company: the document names the company whose papers it is, and no site).
  recordType  String
  recordId    String                @db.Uuid
  kind        GeneratedDocumentKind
  /// 1, 2, 3 … per record and kind (unique), the newest the current one.
  version     Int
  /// SHA-256 of what it shows (lower-case hex; factory-domain's contents key of the kind): the same contents, the same
  /// fingerprint.
  fingerprint String
  /// The language it was printed in (ISO 639-1, two lower-case letters) and the layout it used (the document template's
  /// name; null: the standard one).
  language    String
  layout      String?
  /// The number printed on it, when it carries one (the shipment's number on its packing list).
  number      String?
  /// The PDF: a file of the same record (StoredFile recordType and recordId).
  fileId      String                @db.Uuid
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  /// Who made it (null: the system, a document made by a handler).
  createdById String?               @db.Uuid

  // W2b (B-W2b-79): the company stands on its own, the site reference checks nothing without a site. Restrict, not Prisma's
  // SetNull default for an optional relation: that would also clear tenantId and companyId.
  company Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  site    Site?      @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  file    StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // complaints.prisma (W2b, B-W2b-79): the complaints answered with this version.
  complaintAnswers Complaint[]

  @@unique([tenantId, recordId, kind, version])
  // The target of the complaints' tenant-safe reference.
  @@unique([tenantId, id])
  // A record's documents (the record's Documents tab).
  @@index([tenantId, recordType, recordId])
}

/// What a generated document is (additive: a new kind is a migration).
enum GeneratedDocumentKind {
  /// A shipment's packing list (LOG-062): what each parcel holds.
  PACKING_LIST
  /// The letter of a supplier claim (SCM-135): what is wrong, with the remedy asked (no price, C2).
  CLAIM_LETTER
  /// The job sheet of a subcontract order (SCM-138: printed and sent with the kit) or of a maintenance job (for the
  /// technician).
  JOB_SHEET
  /// The RMA sheet of a return (SAL-346): its scannable number for the parcel.
  RMA_SHEET
  /// W2b (B-W2b-79): the report of an inspection, for the customer (QHS-059): no pay or cost figure.
  INSPECTION_REPORT
  /// The certificate of conformity of a shipment (QHS-145).
  CERTIFICATE_OF_CONFORMITY
  /// The report of an NCR, to send to a supplier or attach to a complaint.
  NCR_REPORT
  /// The 8D report of a CAPA, in the language chosen (QHS-094).
  EIGHT_D
  /// The answer letter of a complaint, in the customer's language (QHS-116).
  COMPLAINT_ANSWER
  /// The report of a statutory machine check (D.Lgs. 81/2008 art. 71).
  CHECK_REPORT
  /// A risk assessment version frozen with its signatures (D.Lgs. 81/2008 arts. 28-29).
  DVR_FROZEN
  /// The receipt of PPE handed to a person.
  PPE_RECEIPT
  /// W2b-4 (schema wave 32/33, B-W2b-218): a shipment's compliance pack (PRD-300): its DoC, user information and certificate
  /// summary, of a Shipment.
  COMPLIANCE_PACK
  /// An evidence pack's PDF bundle (PRD-299), of an EvidencePack.
  EVIDENCE_PACK
  /// A tech pack per audience (B-W2b-230), of a StyleRevision: a partner's copy has no cost, margin or pay figure.
  TECH_PACK
  /// A generated user-information leaflet (B-W2b-258), of a ComplianceDocument of kind USER_INFORMATION.
  USER_INFORMATION
  /// W2b-5 (schema wave 39/44, B-W2b-281; SAL-208): the confirmation of a SalesOrder (no site): its lines, sizes, prices,
  /// dates, terms and the certificate class per style, sent on the order's thread (SalesOrder.confirmationSentAt).
  ORDER_CONFIRMATION
  /// W2b-5 (schema wave 44/44, B-W2b-297; SAL-303): the made-to-measure worksheet and order form of a MeasurementProfile
  /// revision (no site): its measurements, colours, padding and options, and an order form to sign at the fitting. Body
  /// measures: office only.
  MTM_WORKSHEET
}
