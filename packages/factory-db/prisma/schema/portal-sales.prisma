// The customer portal (W2b schema wave 21/22, B-W2b-157; plan W2b-3; design 02 portal-links: portal.customer.neworder,
// portal.customer.orders, links.pay; features SAL-072, SAL-073, SAL-074, SAL-077, SAL-078, FIN-118, FIN-123): what a
// customer sends from the portal or a link. An order request (picked styles, a past order copied, a sheet uploaded) is NOT
// an order: the office makes the order or a quote from it (prices again) or refuses it in words, so the sales-order state
// machine of sales.prisma does not change (SalesOrder has no DRAFT, plan §9). A change or cancel request asks for a
// change of a confirmed order; the office accepts it with W2a's amendment command (SalesOrderAmendment) or refuses it in
// words; the cut-off rules it is checked against are SalesSettings' (sales.prisma). A payment intent is one card or SEPA
// payment of a deposit request or an invoice at the payment provider: the provider's own fields take the card, so no card
// data ever reaches our database (FIN-123, PSD2 by the provider); its Payment is recorded by the payments command when
// the provider's signed webhook says it succeeded. The measurements a rider sends by link are MeasurementProfile
// revisions (parties.prisma).
//
// Who writes what (ownership/portal-sales.json; the …_portal_sales_w2b_guards triggers hold it for every login): a portal
// session (factory_partner_runtime behind its party's wall) keeps its own drafts (the request, its lines and their sizes)
// and sends or withdraws them, asks for a change or a cancel of its own orders and withdraws the ask, and reads its own
// payment intents. The office (factory_runtime; the system context of the worker and the webhook) numbers and sends a
// draft for the portal (the partner role has no numbering grant), decides requests and change requests, and makes and
// moves payment intents. The floor reads none of it. No cost or margin column anywhere; the price a customer was shown
// is the price grain.
//
// Every child row carries its parent's partyId in its reference, so it can never belong to another party than its
// request; uniqueness made of ids only (one open change request per order) is the API's, as in sales.prisma.

/// An order request from the portal (SAL-072, SAL-073, SAL-074; design portal.customer.neworder): a draft kept with us
/// while the customer builds it (the portal's "Draft saved 10:42"), then sent with a number of the company's
/// PORTAL_REQUEST series ("our request RQ-0087"). The office makes the order or a quote from it (ACCEPTED, naming it) or
/// refuses it in words (REFUSED); the customer may withdraw it before that (WITHDRAWN). DRAFT → SENT → ACCEPTED | REFUSED
/// | WITHDRAWN; the last three are final. A draft is deleted when the customer discards it (it has no number); nothing
/// else is ever deleted. Its lines and sizes change only while it is a DRAFT.
model PortalOrderRequest {
  id            String                   @id @db.Uuid
  tenantId      String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The selling company it asks.
  companyId     String                   @db.Uuid
  /// The customer (the partner role's policy key).
  partyId       String                   @db.Uuid
  /// The number from the company's PORTAL_REQUEST series, given when it is sent (null while DRAFT); unique in the company,
  /// never changed.
  number        String?
  /// How the customer started it: styles picked from the catalogue, a past order copied at today's prices, a sheet
  /// uploaded. One draft may gather lines of every way (each line names a copied order line).
  source        PortalOrderRequestSource @default(PICKER)
  /// Their purchase order number (the API asks it when the account requires one).
  customerRef   String?
  /// The delivery address asked: one of the party's own addresses, a SHIP_TO one, not archived when chosen. Null: the
  /// party's default.
  shipToAddressId String?                @db.Uuid
  /// The delivery date they would like (we confirm the date).
  requestedDate DateTime?                @db.Date
  /// Their note to us.
  note          String?
  /// ISO 4217: the currency of the prices shown on its lines.
  currency      String                   @default("EUR")
  status        PortalOrderRequestStatus @default(DRAFT)
  /// When it was sent, and the partner user who sent it; set exactly from SENT on, never changed.
  sentAt        DateTime?                @db.Timestamptz(3)
  sentById      String?                  @db.Uuid
  /// The office's decision: when and by whom (set exactly when ACCEPTED or REFUSED), and the words of a refusal (exactly
  /// when REFUSED).
  decidedAt     DateTime?                @db.Timestamptz(3)
  decidedById   String?                  @db.Uuid
  refuseReason  String?
  /// What it became (ACCEPTED: exactly one, of the same company and party): the order the office made from it, or the
  /// quote it sent instead.
  salesOrderId  String?                  @db.Uuid
  quoteId       String?                  @db.Uuid
  /// Set exactly when WITHDRAWN.
  withdrawnAt   DateTime?                @db.Timestamptz(3)
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  /// The partner user who started the draft.
  createdById   String?                  @db.Uuid

  company    Company                  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  party      Party                    @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and partyId.
  shipTo     PartyAddress?            @relation("PortalOrderRequestShipTo", fields: [tenantId, partyId, shipToAddressId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  salesOrder SalesOrder?              @relation("PortalOrderRequestOrder", fields: [tenantId, companyId, partyId, salesOrderId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  quote      Quote?                   @relation("PortalOrderRequestQuote", fields: [tenantId, partyId, quoteId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  lines      PortalOrderRequestLine[]

  @@unique([tenantId, companyId, number])
  // The target of its lines' reference: a line of the same party.
  @@unique([tenantId, partyId, id])
  // The office's Approvals source (what waits) and the customer's drafts.
  @@index([tenantId, status])
  @@index([tenantId, partyId, status])
  // The request an order came from.
  @@index([tenantId, salesOrderId])
}

/// How an order request was started (design portal.customer.neworder "How do you want to order?").
enum PortalOrderRequestSource {
  /// Styles picked from the customer's catalogue (SAL-071).
  PICKER
  /// A past order copied at today's prices, every difference named (SAL-072).
  REORDER
  /// A sheet uploaded, with a dry run per row (SAL-073).
  UPLOAD
}

/// DRAFT (kept with us while the customer builds it) → SENT (numbered; it waits for the office) → ACCEPTED (the order or
/// quote made from it) | REFUSED (in words) | WITHDRAWN (by the customer, before the office decided).
enum PortalOrderRequestStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  WITHDRAWN
}

/// One line of an order request: one style in one colourway, the size run in its size rows, the price the customer was
/// shown. Written by the customer while the request is a DRAFT; frozen when it is sent.
model PortalOrderRequestLine {
  id                String   @id @db.Uuid
  tenantId          String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The request's party (the partner role's policy key).
  partyId           String   @db.Uuid
  requestId         String   @db.Uuid
  /// The line's place on the request: 1, 2, 3 …
  seq               Int
  styleId           String   @db.Uuid
  colourwayId       String   @db.Uuid
  /// A reorder's line: the past order's line it was copied from (of the same party), so the draft names every
  /// difference again (price, style revision, size run, a style no longer sold) when it is opened later.
  sourceOrderLineId String?  @db.Uuid
  /// The net unit price the customer was shown (their price list's, on that day), frozen when the request is sent; at
  /// least 0. Null: no price was shown (a portal role without prices). The office prices again when it makes the order.
  /// @grain price
  unitPriceShown    Decimal? @db.Decimal(18, 6)
  /// Their note on the line (their own style code, a remark).
  note              String?
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById       String?  @db.Uuid

  request         PortalOrderRequest       @relation(fields: [tenantId, partyId, requestId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  style           Style                    @relation("PortalOrderRequestLineStyle", fields: [tenantId, styleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  colourway       Colourway                @relation("PortalOrderRequestLineColourway", fields: [tenantId, styleId, colourwayId], references: [tenantId, styleId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceOrderLine SalesOrderLine?          @relation("PortalOrderRequestLineSource", fields: [tenantId, partyId, sourceOrderLineId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  sizes           PortalOrderRequestSize[]

  @@unique([tenantId, requestId, seq])
  // The target of its size rows' reference: a size of the same party.
  @@unique([tenantId, partyId, id])
}

/// The pieces of one size of an order request's line (the size grid as rows); above 0. Written while the request is a
/// DRAFT. Whether the style offers the size, and the minimum per size, are the API's (the portal shows them per cell).
model PortalOrderRequestSize {
  id          String   @id @db.Uuid
  tenantId    String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The line's party (the partner role's policy key).
  partyId     String   @db.Uuid
  lineId      String   @db.Uuid
  /// A size code of the style's range.
  size        String
  quantity    Int
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById String?  @db.Uuid

  line PortalOrderRequestLine @relation(fields: [tenantId, partyId, lineId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, lineId, size])
}

/// A customer's request to change or cancel a confirmed order (SAL-077, SAL-078; design portal.customer.orders "Ask for
/// a change", "Ask to cancel"): what they ask (the lines and sizes in its rows, a date, an address, their reason), checked
/// before the click against the company's cut-off rules (SalesSettings; the API refuses in words). The office answers:
/// ACCEPTED (a change through W2a's amendment command, named here; a cancel of the whole order by cancelling it) or
/// REFUSED (in words); the customer may withdraw it while OPEN. OPEN → ACCEPTED | REFUSED | WITHDRAWN; all three final.
/// Asked only of an order that is CONFIRMED, IN_PRODUCTION or READY. Never deleted.
model OrderChangeRequest {
  id              String                   @id @db.Uuid
  tenantId        String                   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's company and party (the reference's keys; the party is the partner role's policy key).
  companyId       String                   @db.Uuid
  partyId         String                   @db.Uuid
  orderId         String                   @db.Uuid
  kind            OrderChangeRequestKind
  /// A cancel's reason: a code of the CANCEL reason list (reasons.prisma ReasonCode, kept as text); required on a CANCEL,
  /// none on a CHANGE.
  reasonCode      String?
  /// Their words: a change's note, a cancel's note.
  reason          String?
  /// A change only: the delivery date they would like, and the address they ask the goods to go to (one of their own
  /// addresses); null: unchanged.
  requestedDate   DateTime?                @db.Date
  shipToAddressId String?                  @db.Uuid
  status          OrderChangeRequestStatus @default(OPEN)
  /// The office's answer: its words (required to refuse), when and by whom; set exactly when ACCEPTED or REFUSED.
  answer          String?
  answeredAt      DateTime?                @db.Timestamptz(3)
  answeredById    String?                  @db.Uuid
  /// ACCEPTED: the amendment of the order it made (sales.prisma SalesOrderAmendment, of the same order), when the
  /// order's lines or dates changed by one; set once, never changed.
  amendmentId     String?                  @db.Uuid
  /// Set exactly when WITHDRAWN.
  withdrawnAt     DateTime?                @db.Timestamptz(3)
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)
  /// The partner user who asked.
  createdById     String?                  @db.Uuid

  order     SalesOrder               @relation("OrderChangeRequestOrder", fields: [tenantId, companyId, partyId, orderId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, partyId and orderId.
  shipTo    PartyAddress?            @relation("OrderChangeRequestShipTo", fields: [tenantId, partyId, shipToAddressId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  amendment SalesOrderAmendment?     @relation("OrderChangeRequestAmendment", fields: [tenantId, orderId, amendmentId], references: [tenantId, orderId, id], onDelete: Restrict, onUpdate: Restrict)
  lines     OrderChangeRequestLine[]

  // The target of its rows' reference: a row of the same party.
  @@unique([tenantId, partyId, id])
  // An amendment answers one request.
  @@unique([tenantId, amendmentId])
  // The order's requests, and the office's Approvals source (what waits).
  @@index([tenantId, orderId, status])
  @@index([tenantId, status])
}

/// What a customer asks of an order (design portal.customer.orders).
enum OrderChangeRequestKind {
  /// Quantities and sizes, the date, the delivery address.
  CHANGE
  /// The whole order, or some of its lines.
  CANCEL
}

/// OPEN → ACCEPTED | REFUSED (the office) | WITHDRAWN (the customer).
enum OrderChangeRequestStatus {
  OPEN
  ACCEPTED
  REFUSED
  WITHDRAWN
}

/// One cell a change or cancel request asks for: an order line, one of its sizes (or the line as a whole: a
/// made-to-measure unit, a line cancelled whole), the pieces it held when they asked and the pieces they ask for (0
/// removes them; a cancel asks 0). Written with the request, while it is OPEN; never changed or removed. A CANCEL with no
/// rows asks for the whole order.
model OrderChangeRequestLine {
  id             String   @id @db.Uuid
  tenantId       String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The request's party (the partner role's policy key).
  partyId        String   @db.Uuid
  requestId      String   @db.Uuid
  /// A line of the request's order.
  orderLineId    String   @db.Uuid
  /// A size code of the line; null: the line as a whole.
  size           String?
  /// The pieces as they were when asked (what the customer saw), and the pieces asked; both at least 0.
  quantityBefore Int
  quantity       Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  /// The partner user who asked.
  createdById    String?  @db.Uuid

  request   OrderChangeRequest @relation(fields: [tenantId, partyId, requestId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  orderLine SalesOrderLine     @relation("OrderChangeRequestLineOrderLine", fields: [tenantId, partyId, orderLineId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, requestId, orderLineId, size])
}

/// One card or SEPA payment of a deposit request or an invoice at the payment provider (FIN-118, FIN-123; design links.pay
/// "Pay by card", portal.customer.orders "Pay the deposit"): what it pays, how much, at which provider account and under
/// which of the provider's ids, and how it ended. The provider's own fields take the card or the mandate: no card number,
/// expiry, security code or client secret ever reaches our database. Made by the API (in the tenant's system context)
/// before it calls the provider; moved by the provider's signed webhook (a repeated webhook changes nothing); when it
/// succeeded, the payments command records its Payment (allocated to the deposit request or the invoice) and names it
/// here. CREATED → WAITING (the bank asks: 3-D Secure, a SEPA debit clearing) → SUCCEEDED | FAILED | CANCELLED; CREATED →
/// SUCCEEDED | FAILED | CANCELLED too. The last three are final. A retry is a new intent. Never deleted. Live card
/// payments wait for the Owner's yes with the provider's exact cost (GATE-SPEND); the FAKE provider until then.
model PaymentIntent {
  id                String              @id @db.Uuid
  tenantId          String              @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company paid, and the party paying (the partner role's policy key).
  companyId         String              @db.Uuid
  partyId           String              @db.Uuid
  /// What it pays, exactly one (of the same company and party): an OPEN deposit request, or an issued TD01 / TD24
  /// invoice (a TD02 is paid through its deposit request; a credit note is not paid).
  depositRequestId  String?             @db.Uuid
  invoiceId         String?             @db.Uuid
  method            PaymentIntentMethod
  /// The amount asked of the provider, in minor units of the currency; above 0 and at most what it pays (the deposit
  /// request's amount, the invoice's gross total).
  /// @grain price
  amount            Int
  /// ISO 4217: the currency of what it pays.
  currency          String
  /// The payment provider's account (integration.prisma IntegrationAccount of provider PAYMENT_FAKE or STRIPE), of the
  /// company or tenant-wide.
  providerAccountId String              @db.Uuid
  /// The provider's own id of the intent (Stripe's `pi_…`), once it answered; unique per account, set once. Letters,
  /// digits, `_` and `-` only, never a run of twelve digits or more (no card number can be kept here).
  providerRef       String?
  status            PaymentIntentStatus @default(CREATED)
  /// FAILED: the provider's reason code ("card_declined"), told in our words; the same letters as providerRef.
  failureCode       String?
  /// When it reached SUCCEEDED, FAILED or CANCELLED; set exactly then.
  finishedAt        DateTime?           @db.Timestamptz(3)
  /// SUCCEEDED: the Payment the payments command recorded for it (of the same company and party, the same amount and
  /// currency); set once.
  paymentId         String?             @db.Uuid
  /// The link it was started from (a PAYMENT or DEPOSIT_INFO link of the same company and party); null: from the portal
  /// (createdById names the partner user).
  linkId            String?             @db.Uuid
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  /// The partner user who started it in the portal (null by link, or the system).
  createdById       String?             @db.Uuid

  company         Company            @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  party           Party              @relation(fields: [tenantId, partyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, companyId and partyId.
  depositRequest  DepositRequest?    @relation(fields: [tenantId, companyId, partyId, depositRequestId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice         Invoice?           @relation(fields: [tenantId, companyId, partyId, invoiceId], references: [tenantId, companyId, buyerPartyId, id], onDelete: Restrict, onUpdate: Restrict)
  providerAccount IntegrationAccount @relation(fields: [tenantId, providerAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  payment         Payment?           @relation(fields: [tenantId, companyId, partyId, paymentId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  link            OneOffLink?        @relation(fields: [tenantId, partyId, linkId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  // The provider's id is unique per account (its webhook names it); a payment is made by one intent.
  @@unique([tenantId, providerAccountId, providerRef])
  @@unique([tenantId, paymentId])
  @@index([tenantId, depositRequestId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
}

/// How the customer pays at the provider (design links.pay "Method: Card · SEPA Direct Debit"). A bank transfer has no
/// intent (W1's DEPOSIT_INFO way, always shown).
enum PaymentIntentMethod {
  CARD
  SEPA_DEBIT
}

/// CREATED (made, the provider called) → WAITING (the bank asks: 3-D Secure, a SEPA debit clearing) → SUCCEEDED | FAILED |
/// CANCELLED; the last three are final.
enum PaymentIntentStatus {
  CREATED
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}
