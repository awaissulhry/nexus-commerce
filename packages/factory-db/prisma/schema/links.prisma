// One-off links (plan A1 §3.10 "Links", §2.2 the partner wall; features SAL-099, PLT-007, PLT-035): a customer or a
// supplier opens ONE record of its own, for ONE purpose, through a link, with no account. apps/factory-api's
// platform/links makes, reads and revokes them (office) and opens and answers them (link sessions, as
// factory_partner_runtime behind the party's wall); the purposes, the token and the evidence rules are factory-domain's
// links/.
//
// The token is never stored: only SHA-256 of it. A link session's grants come from its purpose, never from a role.
// Moving the party or the tenant of a link is refused by the policies for the runtime roles, and every column but the
// use counters, the revocation and the office note is fixed once the link exists (the …_links_guards migration's
// trigger, for every login).
//
// W2b (schema wave 19/22, B-W2b-154): nine more purposes, a password (its hash only) with its tries, the receipt, the
// contact and the renewed link; links-depth.prisma has the link's files and draft, record shares and approval requests.
// The …_links_depth_w2b_guards migration redefines the link's guard: the password tries and the receipt may move too,
// and no link ever opens a record that holds pay figures (Owner, 11-02).

/// One link: one purpose on one record of one party of the tenant, with an expiry and a use limit. Revoked or used up,
/// it opens nothing; never deleted (its evidence keeps pointing at it).
model OneOffLink {
  id          String      @id @db.Uuid
  tenantId    String      @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The company whose record the link opens (the seller of the quote, the buyer of the purchase order).
  companyId   String      @db.Uuid
  /// The customer, supplier or subcontractor the link was made for: its session sits behind this party's wall. A
  /// plain id until the parties module brings the Party table.
  partyId     String      @db.Uuid
  purpose     LinkPurpose
  /// The one record the link opens: its model name (one of the purpose's record types) and id.
  recordType  String
  recordId    String      @db.Uuid
  /// SHA-256 (hex) of the whole token; the token itself is never stored.
  tokenHash   String      @unique
  /// The address the link was sent to, trimmed and lower case; an accept checks a typed address against it. Null: the
  /// address is not known (the accept records NOT_KNOWN).
  email       String?
  /// Why the office made it, for the office only: the partner role can neither read nor write it.
  /// @internal
  note        String?
  expiresAt   DateTime    @db.Timestamptz(3)
  /// How many counted uses it allows (the purpose's default or the office's choice within the purpose's maximum).
  maxUses     Int
  /// Counted uses so far: never down, never past maxUses (the guard trigger).
  uses        Int         @default(0)
  /// The last open or answer.
  lastUsedAt  DateTime?   @db.Timestamptz(3)
  revokedAt   DateTime?   @db.Timestamptz(3)
  revokedById String?     @db.Uuid
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(3)
  /// The office user who made it (or the system actor, for a link a job made).
  createdById String      @db.Uuid
  /// W2b (wave 19/22; COL-051, MES-274): the password sent apart from the link (DOCUMENT_VIEW and SECURE_FILE only), as
  /// its scrypt hash in the PHC string format of factory-domain auth/password, never the password itself. Hidden from the
  /// partner role: the API checks a typed password in the tenant's system scope, so a link session can never read the
  /// hash and guess offline past the five tries. Fixed once the link exists.
  passwordHash      String?
  /// Wrong passwords typed in a row, 0 to 5 (design links.document: "5 tries, then held 15 minutes"): the fifth holds
  /// the link until `passwordHeldUntil` (15 minutes at most, set exactly at 5); once that passed the count starts again;
  /// a right password sets it back to 0. Only on a link with a password.
  passwordTries     Int         @default(0)
  passwordHeldUntil DateTime?   @db.Timestamptz(3)
  /// W2b (wave 19/22; SECURE_FILE): the receipt "I received these files": when, and the name typed (optional). Written
  /// once by the link session, never changed, never on a revoked link; not a counted use.
  receivedAt        DateTime?   @db.Timestamptz(3)
  receivedName      String?
  /// W2b (wave 19/22): the party contact it was sent to; null: an address with no contact, or a link whose party is no
  /// Party (B-W2b-54's payroll link names its export). Fixed once made.
  contactId         String?     @db.Uuid
  /// W2b (wave 19/22; "Ask for a new link", B-W1-49's renew made general): the link this one replaces, of the same
  /// company, party, purpose and record. Fixed once made; the old link is revoked, used up or expired on its own.
  renewalOfId       String?     @db.Uuid

  company  Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  evidence LinkEvidence[]
  // W2b (wave 19/22): the contact it went to, the link it renews and its renewals. Restrict, not Prisma's SetNull
  // default for an optional relation: that would also clear tenantId and partyId.
  contact   PartyContact? @relation(fields: [tenantId, partyId, contactId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  renewalOf OneOffLink?   @relation("OneOffLinkRenewal", fields: [tenantId, partyId, renewalOfId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  renewals  OneOffLink[]  @relation("OneOffLinkRenewal")
  // W2b links-depth.prisma (wave 19/22): its files, its form's draft, the record share it opens, the approval answered
  // through it.
  files           LinkFile[]
  drafts          LinkDraft[]
  recordShare     RecordShare?
  approvalAnswers ApprovalRequest[]
  // sales.prisma: the quote acceptances made through it.
  quoteAcceptances QuoteAcceptance[]
  // supply.prisma: the purchase orders confirmed through it (PO_CONFIRM), and those it proposed changes to.
  purchaseOrderConfirmations PurchaseOrder[] @relation("PurchaseOrderConfirmLink")
  purchaseOrderProposals     PurchaseOrder[] @relation("PurchaseOrderProposalLink")
  // W2b portal-sales.prisma, parties.prisma (wave 21/22): the payment intents started through it (PAYMENT, DEPOSIT_INFO),
  // the measurement revisions sent through it (MEASUREMENTS).
  paymentIntents             PaymentIntent[]
  measurementSubmissions     MeasurementProfile[] @relation("MeasurementProfileSubmittedVia")
  // W2b portal-supply.prisma (wave 22/22): the supplier questionnaire answers sent through it (SUPPLIER_ONBOARD).
  questionnaireResponses     SupplierQuestionnaireResponse[]

  // The target of the evidence rows' reference: an evidence row names its link's party.
  @@unique([tenantId, partyId, id])
  // The links of one record (the office list).
  @@index([tenantId, recordType, recordId])
}

/// What a link lets its holder do (factory-domain links/purposes).
enum LinkPurpose {
  /// Open one sent quote with its own prices; accept (typed name, email checked when known) or decline it.
  QUOTE_ACCEPT
  /// Open one purchase order, without any price; confirm or decline it.
  PO_CONFIRM
  /// Open one of the party's own documents.
  DOCUMENT_VIEW
  /// Open the deposit request of an accepted quote.
  DEPOSIT_INFO
  /// W2b (wave 19/22; design 02 "New link purposes"). Track one shipment: its steps and the carrier's tracking, no price
  /// (SAL-095); opens only.
  SHIPMENT_TRACK
  /// Send the measurements (and body photos) of one measurement profile; a draft kept with us; one submit.
  MEASUREMENTS
  /// Report a problem with one sales order or shipment (a return or a complaint); a draft kept with us; a few submits.
  CLAIM
  /// Pay one deposit request or invoice online (the price of the party's own document); until it is paid.
  PAYMENT
  /// Answer the supplier questionnaire for one prospective supplier (typed name); a draft kept with us; one submit.
  SUPPLIER_ONBOARD
  /// Accept or decline one subcontract order, or propose another date; no price.
  JOB_ACCEPT
  /// Answer one approval request (links-depth.prisma ApprovalRequest): approve, approve with changes or refuse, signed
  /// with a typed name.
  APPROVAL
  /// Join one record's thread and files with what its record share allows (view, comment, upload).
  RECORD_INVITE
  /// Download a set of files (LinkFile), with an optional password sent apart and the receipt "I received these files".
  SECURE_FILE
}

/// The evidence of one open or answer of a link (ported from the old app's acceptance evidence, EPQ.5: typed name,
/// server time, hashed client address, user agent): written by the link session in the command of the use.
/// @append-only
model LinkEvidence {
  id         String             @id @db.Uuid
  tenantId   String             @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The link's party (the partner policy checks it on insert).
  partyId    String             @db.Uuid
  linkId     String             @db.Uuid
  action     LinkEvidenceAction
  /// The link's counted uses after this one (1 … maxUses); null when it did not count.
  useNumber  Int?
  /// The full name the person typed, as typed (trimmed); null when not asked or not given.
  typedName  String?
  emailCheck LinkEmailCheck
  /// HMAC of the shortened client address (/24, /64), never the address.
  ipHash     String?
  userAgent  String?
  /// Server time (the command's).
  at         DateTime           @db.Timestamptz(3)
  /// The request that used the link; its audit rows share it.
  requestId  String

  link OneOffLink @relation(fields: [tenantId, partyId, linkId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, linkId, at])
}

enum LinkEvidenceAction {
  OPENED
  ACCEPTED
  DECLINED
  CONFIRMED
  /// W2b (wave 19/22; the B-W1-49 gap: a download left an audit row only). A file downloaded through the link.
  DOWNLOADED
  /// The receipt "I received these files" (SECURE_FILE).
  RECEIVED
  /// A form sent (MEASUREMENTS, CLAIM, SUPPLIER_ONBOARD).
  SUBMITTED
  /// An approval request approved (with or without changes) or refused (APPROVAL).
  APPROVED
  REFUSED
  /// A payment made (PAYMENT).
  PAID
  /// Another date proposed (JOB_ACCEPT; ACCEPTED and DECLINED serve its other answers).
  MOVED_DATE
  /// A message posted and a file uploaded on a shared record (RECORD_INVITE).
  POSTED
  UPLOADED
}

/// The email check of an answer (factory-domain links/evidence): a typed address that differs is refused, never stored.
enum LinkEmailCheck {
  /// The person typed the address the link was sent to.
  MATCHED
  /// The answer checks the address, but the link has none.
  NOT_KNOWN
  /// The action does not check it.
  NOT_ASKED
}
