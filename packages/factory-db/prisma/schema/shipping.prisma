// Shipping (plan A1 §2.1 "Append-only", "Issued documents", §2.4 F, §2.5 "Shipment"; PLAN §2.8 "DDT", "Sequential,
// gap-free numbering", §4.7 stage 14-ship; features LOG-001, LOG-039, LOG-054, LOG-059, LOG-117, QHS-058): the shipping
// settings of each site, shipments of a sales order's released garments in parcels, the transport document (DDT) that
// travels with them and its cancellation, and the carrier's tracking events. apps/factory-api's modules/shipping writes
// them (B-W1-46 settings, shipments and packing, B-W1-47 DDT, B-W1-48 carrier labels and tracking through Sendcloud,
// B-W1-49 the Declaration of Conformity with the shipment), always through command(); the floor packs through
// floorCommand.
//
// A shipment (LOG-001) sends garments of one sales order from one site to the order's party: DRAFT (lines and parcels
// are planned and packed) → PACKED (every parcel weighed; a serial-tracked line holds its serials; carrier labels are
// bought) → SHIPPED (the goods left; with its DDT) → DELIVERED | RETURNED (the carrier brought them back); CANCELLED from
// DRAFT or PACKED. Its lines are cells (colourway x size) of the order's work orders: only RELEASED garments ship, so
// the lines of a cell, over every shipment that is not CANCELLED, never hold more than the cell's quality releases
// (QHS-058, LOG-001; the …_quality_shipping_guards triggers, under a lock per cell).
//
// The DDT (Documento di trasporto, DPR 472/1996 art. 1 c.3 with DPR 627/1978; LOG-054): numbered from the company's
// DDT series (NumberKind DDT, fiscal: gapless per company and year; apps/factory-api's allocateNumber in the issuing
// command), with the sender, the recipient, the goods (nature, quality, quantity), the reason for the transport, who
// carries it, its start, the goods' appearance, the packages and the weight. Issued once, then never changed or removed
// (append-only, for every login); a wrong DDT is cancelled by a DdtCancellation row (it keeps its number) and a new one
// is issued. Its PDF is a file of the row (StoredFile recordType "Ddt", kind FISCAL_ARCHIVE: ten years). A shipment
// leaves (SHIPPED) only with a DDT that is not cancelled, unless an immediate invoice travels with the goods
// (ddtRequired false; DPR 633/1972 art. 21 c.4).
//
// Carriers (LOG-039, LOG-059): Sendcloud through the integration gateway (B-W1-48), or the company's own van, or the
// customer's carrier. A parcel carries its tracking number and its carrier label (a file of the row); tracking events
// are append-only.
//
// W2a (schema wave 6/7; B-W2a-17, B-W2a-48; LOG-056, LOG-105, LOG-090): a DDT for another reason has no shipment but a
// source record (a subcontract order's kit sent to the workshop on conto lavorazione, a supplier claim's return, a repair
// going back to its customer, a return sent back unchanged: type and id), with every W1 DDT rule (the company's DDT
// series, gapless per year, frozen once issued, every DPR 472/1996 field; the …_quality_plant_w2a_guards trigger names
// the reasons each source may give). A shipment carries the freight charged to the customer (a site's freight rule
// gives it, the office may change it; the invoice charges it, B-W2a-54) and, for a sale to another EU country, the
// state of its transport evidence (art. 41 DL 331/93, Reg. (EU) 282/2011 art. 45a: the POD, CMR and carrier invoice are
// files of the shipment). A quality hold (holds.prisma) on a shipment, a parcel, a work order or a serial keeps the
// goods from being packed and from leaving.
//
// Who sees what (ownership/shipping.json): the office reads and writes; the floor reads its OWN site's settings,
// shipments, lines, parcels, DDTs and their cancellations, packs (lines and parcels of a DRAFT shipment; DRAFT ⇄
// PACKED), and never reads a freight figure; a portal or link session (DOCUMENT_VIEW) reads its OWN party's shipments
// (with the freight charged to it), lines, parcels, DDTs, cancellations and tracking, never an internal note nor who in
// the office wrote a row. The freight charged is a price; W2b's freight cost is a cost (office only).
//
// W2b (schema wave 1/7, B-W2b-01; the B-W2a-17, -39, -48 notes): a shipment records how its freight charge was decided
// (the site's rule or typed by the office), what the carrier charged us (the freight cost: a cost, office only) and its
// mode of transport for Intrastat; a DDT keeps the language it was printed in and its mode of transport. Garments leave
// finished-goods stock as SHIPMENT moves naming the shipment line (inventory.prisma); a shipment's evidence files carry
// their category (files.prisma); its packing-list versions are GeneratedDocument rows (gendocs.prisma).

/// Who carries the goods (trasporto a cura del; DPR 472/1996), as factory-domain documents DDT_TRANSPORT_BY.
enum TransportBy {
  /// The sender: our own van.
  SENDER
  /// The recipient: the customer collects (ex works, LOG-053).
  RECIPIENT
  /// A carrier (Sendcloud's carriers, or one named on the DDT).
  CARRIER
}

/// A site's shipping settings (LOG-117): the sender and return addresses printed on labels and DDTs, the default carrier
/// account and service, the default transport and goods' appearance, the label and document printers of the packing
/// station, and the daily cut-off. The site's row has the site's own id.
model ShippingSettings {
  /// The site's own id (`siteId`): a site has at most one row, read by the site's id.
  id                     String       @id @db.Uuid
  tenantId               String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  companyId              String       @db.Uuid
  siteId                 String       @db.Uuid
  /// The sender as printed on carrier labels and DDTs: { name, line1, line2?, postalCode, city, province?, country,
  /// phone?, email? }; and where returns go (null: the sender's address).
  senderAddress          Json
  returnAddress          Json?
  /// The Sendcloud account (integration.prisma, provider SENDCLOUD) labels are bought with, its default carrier code
  /// ("brt", "gls") and service (Sendcloud's shipping method); null: none set.
  integrationAccountId   String?      @db.Uuid
  defaultCarrierCode     String?
  defaultServiceCode     String?
  defaultTransportBy     TransportBy  @default(CARRIER)
  /// The goods' appearance a DDT starts with (aspetto esteriore dei beni: "scatole di cartone").
  defaultGoodsAppearance String?
  /// The packing station's printers (print.prisma, this site's): carrier labels and A4 documents (DDT, DoC).
  labelPrinterId         String?      @db.Uuid
  documentPrinterId      String?      @db.Uuid
  /// The time of day (HH:MM, the site's zone) after which a parcel leaves the next working day.
  cutOffTime             String?
  /// W2a (LOG-105): the freight a shipment from the site charges its customer by default: NONE, a flat amount PER_SHIPMENT
  /// or PER_PARCEL (in the company's currency, minor units, 0 or more; exactly with a charging rule), free from an order
  /// value (net, minor units; null: never free). A customer's own terms (Party incoterm) are the API's to weigh.
  freightRule            FreightRule  @default(NONE)
  /// @grain price
  freightAmount          Int?
  /// @grain price
  freightFreeFrom        Int?
  version                Int          @default(1)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  createdById            String?      @db.Uuid

  site               Site                @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, companyId and
  // siteId.
  integrationAccount IntegrationAccount? @relation(fields: [tenantId, integrationAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  labelPrinter       Printer?            @relation("ShippingLabelPrinter", fields: [tenantId, companyId, siteId, labelPrinterId], references: [tenantId, companyId, siteId, id], onDelete: Restrict, onUpdate: Restrict)
  documentPrinter    Printer?            @relation("ShippingDocumentPrinter", fields: [tenantId, companyId, siteId, documentPrinterId], references: [tenantId, companyId, siteId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, siteId])
}

/// The mode of transport (W2b, B-W2a-39; Intrastat: the transport mode codes of the Intrastat declaration, Reg. (EU)
/// 2019/2152 and its implementing rules), with its code.
enum TransportMode {
  /// 1: by sea.
  SEA
  /// 2: by rail.
  RAIL
  /// 3: by road.
  ROAD
  /// 4: by air.
  AIR
  /// 5: by post.
  POST
  /// 7: by fixed transport installation.
  FIXED_INSTALLATION
  /// 8: by inland waterway.
  INLAND_WATERWAY
  /// 9: by own propulsion.
  OWN_PROPULSION
}

/// How a shipment's freight charge was decided (W2b, B-W2a-48).
enum FreightBasis {
  /// The site's freight rule gave it (ShippingSettings.freightRule).
  RULE
  /// Typed by the office.
  MANUAL
}

/// How a site charges freight by default (W2a, LOG-105).
enum FreightRule {
  /// No freight charged (the default; the office may still type one on a shipment).
  NONE
  PER_SHIPMENT
  PER_PARCEL
}

/// The state of a shipment's intra-EU transport evidence (W2a, LOG-090; art. 41 DL 331/93, Reg. (EU) 282/2011 art. 45a).
enum TransportEvidenceStatus {
  /// Not an intra-EU supply (a domestic or export sale), or not decided.
  NOT_NEEDED
  /// The goods left for another EU country; no evidence yet.
  AWAITED
  /// Some evidence is on file, not enough (two non-contradictory items from independent parties).
  PARTIAL
  /// Enough evidence on file (checked by a person).
  COMPLETE
}

/// A shipment (LOG-001, LOG-039; A1 §2.4 F Shipment): released garments of one sales order sent from one site to the
/// order's party, in parcels, with its DDT. DRAFT → PACKED → SHIPPED → DELIVERED | RETURNED; CANCELLED (with a reason)
/// from DRAFT or PACKED. Never deleted.
model Shipment {
  id                   String         @id @db.Uuid
  tenantId             String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The order's company, and the site the goods leave from (one of its sites).
  companyId            String         @db.Uuid
  siteId               String         @db.Uuid
  /// The order's party (the partner role's policy key).
  partyId              String         @db.Uuid
  salesOrderId         String         @db.Uuid
  /// The number from the company's SHIPMENT series, unique in the company.
  number               String
  /// DRAFT → PACKED → SHIPPED → DELIVERED | RETURNED; PACKED → DRAFT (unpacked); CANCELLED from DRAFT or PACKED.
  /// DELIVERED, RETURNED and CANCELLED are final.
  status               ShipmentStatus @default(DRAFT)
  /// The delivery address it goes to (the party's), and as sent (a snapshot, the shape of SalesOrder.shipTo; fixed
  /// once SHIPPED).
  shipToAddressId      String?        @db.Uuid
  shipTo               Json
  transportBy          TransportBy    @default(CARRIER)
  /// The Sendcloud account its labels were bought with (B-W1-48): for the office only.
  /// @internal
  integrationAccountId String?        @db.Uuid
  /// The carrier (Sendcloud's code, and its name as printed), the service, and the carrier's id of the shipment.
  carrierCode          String?
  carrierName          String?
  serviceCode          String?
  carrierShipmentId    String?
  /// False only when an immediate invoice travels with the goods instead of a DDT (DPR 633/1972 art. 21 c.4): then it
  /// leaves without one.
  ddtRequired          Boolean        @default(true)
  /// Set from PACKED on (cleared when unpacked); shipped from SHIPPED on; delivered exactly when DELIVERED; returned
  /// exactly when RETURNED.
  packedAt             DateTime?      @db.Timestamptz(3)
  shippedAt            DateTime?      @db.Timestamptz(3)
  deliveredAt          DateTime?      @db.Timestamptz(3)
  returnedAt           DateTime?      @db.Timestamptz(3)
  /// Set exactly when CANCELLED.
  cancelledAt          DateTime?      @db.Timestamptz(3)
  cancelReason         String?
  /// For the office and the packers only: the partner role can neither read nor write it.
  /// @internal
  internalNote         String?
  /// W2a (LOG-105): the freight charged to the customer for it, in the order's currency (minor units, 0 or more; the
  /// site's rule gives it, the office may change it until the shipment is cancelled); null: none decided.
  /// @grain price
  freightCharge        Int?
  /// W2a (LOG-090): the state of its intra-EU transport evidence (anything but NOT_NEEDED only once it left), and
  /// COMPLETE's time and checker (exactly then).
  transportEvidence          TransportEvidenceStatus @default(NOT_NEEDED)
  transportEvidenceAt        DateTime?               @db.Timestamptz(3)
  transportEvidenceById      String?                 @db.Uuid
  /// What is on file and what is missing, for the office only.
  /// @internal
  transportEvidenceNote      String?
  /// W2b (B-W2a-48): how the freight charged was decided; set only with a freight charge (a charge set before W2b has
  /// none).
  freightBasis               FreightBasis?
  /// W2b (B-W2a-29, -48): what the carrier charged us for it (its invoice), in minor units of `freightCostCurrency`, 0
  /// or more; both or neither; still set after the goods left (the invoice comes later), until the shipment is
  /// cancelled. A cost: office only.
  /// @grain cost
  freightCost                Int?
  /// @not-money the ISO 4217 currency of the freight cost (hidden with it from the floor and portal sessions)
  freightCostCurrency        String?
  /// W2b (B-W2a-39): the mode of transport (Intrastat); still set after the goods left.
  transportMode              TransportMode?
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  createdById          String?        @db.Uuid

  site               Site                @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  salesOrder         SalesOrder          @relation(fields: [tenantId, companyId, partyId, salesOrderId], references: [tenantId, companyId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId and partyId.
  shipToAddress      PartyAddress?       @relation(fields: [tenantId, partyId, shipToAddressId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  integrationAccount IntegrationAccount? @relation(fields: [tenantId, integrationAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  lines              ShipmentLine[]
  parcels            Parcel[]
  ddts               Ddt[]
  trackingEvents     TrackingEvent[]

  @@unique([tenantId, companyId, number])
  // The target of the references from its lines, parcels, DDTs and tracking events: the same site and party.
  @@unique([tenantId, siteId, partyId, id])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, status])
}

enum ShipmentStatus {
  DRAFT
  PACKED
  SHIPPED
  DELIVERED
  /// The carrier brought the goods back (not delivered).
  RETURNED
  CANCELLED
}

/// One line of a shipment (LOG-001): garments of one cell (colourway x size) of a work order that makes a line of the
/// shipment's order, released by quality, and the parcel they are packed in. A serial-tracked style's line holds its
/// serials (GarmentSerial.shipmentLineId) once PACKED. Written, changed and removed only while the shipment is a DRAFT.
model ShipmentLine {
  id               String   @id @db.Uuid
  tenantId         String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  siteId           String   @db.Uuid
  /// The shipment's party (the partner role's policy key).
  partyId          String   @db.Uuid
  shipmentId       String   @db.Uuid
  /// The parcel it is packed in; null: not packed yet.
  parcelId         String?  @db.Uuid
  /// The work order cell the garments come from, and that cell's sales order line and size (copied; kept equal).
  workOrderId      String   @db.Uuid
  workOrderSizeId  String   @db.Uuid
  salesOrderLineId String   @db.Uuid
  size             String
  /// Garments, from 1.
  quantity         Int
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  createdById      String?  @db.Uuid

  shipment       Shipment        @relation(fields: [tenantId, siteId, partyId, shipmentId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and
  // shipmentId.
  parcel         Parcel?         @relation(fields: [tenantId, siteId, shipmentId, parcelId], references: [tenantId, siteId, shipmentId, id], onDelete: Restrict, onUpdate: Restrict)
  workOrderSize  WorkOrderSize   @relation(fields: [tenantId, siteId, workOrderId, workOrderSizeId], references: [tenantId, siteId, workOrderId, id], onDelete: Restrict, onUpdate: Restrict)
  salesOrderLine SalesOrderLine  @relation(fields: [tenantId, partyId, salesOrderLineId], references: [tenantId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  serials        GarmentSerial[]
  // W2b inventory.prisma (B-W2b-01): the SHIPMENT moves that took its garments out of finished goods.
  stockMoves     StockMove[]

  // The target of the serials' reference: a line of the serial's cell.
  @@unique([tenantId, siteId, workOrderSizeId, id])
  // W2b: the target of the SHIPMENT moves' reference: a line of the move's site.
  @@unique([tenantId, siteId, id])
  @@index([tenantId, shipmentId])
  // The shipped garments per cell (only released ones ship).
  @@index([tenantId, workOrderSizeId])
}

/// One parcel of a shipment (LOG-039: one consignment of several boxes): its place, weight and size, and once a carrier
/// label is bought its tracking number and the carrier's parcel id; the label is a file of the row (StoredFile
/// recordType "Parcel"). Added and removed while the shipment is a DRAFT; its weight, size and label change until it
/// leaves (DRAFT or PACKED).
model Parcel {
  id              String    @id @db.Uuid
  tenantId        String    @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  siteId          String    @db.Uuid
  /// The shipment's party (the partner role's policy key).
  partyId         String    @db.Uuid
  shipmentId      String    @db.Uuid
  /// 1, 2, 3 … in the shipment.
  seq             Int
  /// Kilograms, above 0; every parcel has one from PACKED on.
  grossWeightKg   Decimal?  @db.Decimal(18, 4)
  /// Centimetres, above 0.
  lengthCm        Decimal?  @db.Decimal(10, 2)
  widthCm         Decimal?  @db.Decimal(10, 2)
  heightCm        Decimal?  @db.Decimal(10, 2)
  /// The carrier's tracking number and its id of the parcel, set when the label is bought.
  trackingNumber  String?
  carrierParcelId String?
  labelledAt      DateTime? @db.Timestamptz(3)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  createdById     String?   @db.Uuid

  shipment       Shipment        @relation(fields: [tenantId, siteId, partyId, shipmentId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  lines          ShipmentLine[]
  trackingEvents TrackingEvent[]

  @@unique([tenantId, shipmentId, seq])
  // The target of the lines' and tracking events' references: a parcel of the same site and shipment.
  @@unique([tenantId, siteId, shipmentId, id])
  @@index([tenantId, trackingNumber])
}

/// A transport document (DDT, Documento di trasporto; DPR 472/1996; LOG-054; A1 §2.4 F TransportDocument): issued for a
/// PACKED or SHIPPED shipment — or, W2a (LOG-056), for goods of another source record (a subcontract order, a supplier
/// claim, a repair, a return: exactly one of the two) — with a number from the company's DDT series, and frozen: the
/// data printed on its PDF.
/// Never changed or removed (the triggers, for every login); cancelled by a DdtCancellation row, which keeps its number
/// (a new DDT replaces it).
/// @append-only
model Ddt {
  id             String       @id @db.Uuid
  tenantId       String       @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  /// The shipment's company (the sender) and site (where the transport starts).
  companyId      String       @db.Uuid
  siteId         String       @db.Uuid
  /// The recipient: the shipment's (or the source's) party (the partner role's policy key).
  partyId        String       @db.Uuid
  /// The shipment it carries; null: a DDT for another reason (W2a), with its source.
  shipmentId     String?      @db.Uuid
  /// W2a (LOG-056): the record whose goods it carries when it has no shipment (SubcontractOrder, SupplierClaim,
  /// RepairOrder, ReturnAuthorisation), of its company, site and party: type and id, exactly without a shipment.
  sourceType     String?
  sourceId       String?      @db.Uuid
  /// The number series (a company's DDT series, NumberKind DDT, for the year) and the number it gave, as printed;
  /// unique in the series. allocateNumber's NumberAllocation row (recordType "Ddt") holds the same number.
  numberSeriesId String       @db.Uuid
  number         String
  /// The DDT's date (Europe/Rome).
  documentDate   DateTime     @db.Date
  /// The reason for the transport (causale; factory-domain DDT_REASONS); OTHER says it in words.
  reason         DdtReason
  reasonText     String?
  transportBy    TransportBy
  /// W2b (B-W2a-17, -39): the language it was printed in (ISO 639-1, two lower-case letters: a re-print takes it, not the
  /// party's language at print time), and the mode of transport (Intrastat); set when it is issued, never changed.
  language       String?
  transportMode  TransportMode?
  /// The carrier's identity when a carrier carries it: { name, address?, vatNumber? }.
  carrier        Json?
  /// The start of the transport (data e ora di inizio trasporto).
  startAt        DateTime     @db.Timestamptz(3)
  /// The goods' external appearance (aspetto esteriore dei beni).
  appearance     String
  /// The number of packages (numero colli), from 1: the shipment's parcels.
  packages       Int
  /// Kilograms, above 0; the net weight at most the gross.
  grossWeightKg  Decimal      @db.Decimal(18, 4)
  netWeightKg    Decimal?     @db.Decimal(18, 4)
  /// Porto: FREE (franco) or FORWARD (assegnato), when printed.
  freight        DdtFreight?
  /// As printed: the sender (the company's c.c. art. 2250 data), the recipient { name, address, vatNumber?, fiscalCode? }
  /// and the place of delivery when it differs (factory-domain documents' DocumentParty and DdtTransport.destination).
  sender         Json
  recipient      Json
  destination    Json?
  /// The goods, as printed (nature, quality, quantity; no price): [{ "seq": 1, "description": "…", "quantity": "2",
  /// "uom": "PCS", "salesOrderLineId": "…", "size": "52", "batchNumber": "…", "serials": ["…"] }], at least one.
  lines          Json
  /// The documents it refers to (the customer's order number), as factory-domain DocumentReference: [{ kind, number,
  /// date? }].
  documentRefs   Json?
  /// Printed remarks.
  remarks        String?
  /// For the office only: the partner role can neither read nor write it.
  /// @internal
  internalNote   String?
  /// The issuing command's server time; who issued it is createdById.
  issuedAt       DateTime     @db.Timestamptz(3)
  createdById    String?      @db.Uuid

  site          Site              @relation(fields: [tenantId, companyId, siteId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and partyId.
  shipment      Shipment?         @relation(fields: [tenantId, siteId, partyId, shipmentId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  numberSeries  NumberSeries      @relation(fields: [tenantId, companyId, numberSeriesId], references: [tenantId, companyId, id], onDelete: Restrict, onUpdate: Restrict)
  cancellations DdtCancellation[]
  // money.prisma: the invoice lines of the goods it carried (TD24).
  invoiceLines  InvoiceLine[]
  // W2a claims.prisma, subcontract.prisma: the goods returned to a supplier and the kit sent to a workshop with it.
  claimLines    SupplierClaimLine[]
  kitLines      SubcontractKitLine[]

  // Never the same number twice in a series period.
  @@unique([tenantId, numberSeriesId, number])
  // The target of the cancellations' reference: the same site and party.
  @@unique([tenantId, siteId, partyId, id])
  // The target of the invoice lines' reference: the same party.
  @@unique([tenantId, partyId, id])
  @@index([tenantId, shipmentId])
  // A source record's DDTs (W2a).
  @@index([tenantId, sourceType, sourceId])
}

/// Why the goods travel (causale del trasporto), as factory-domain documents DDT_REASONS.
enum DdtReason {
  SALE
  /// Goods sent to be worked on (conto lavorazione).
  WORK_ON_ACCOUNT
  RETURN_FROM_WORK
  RETURN
  ON_APPROVAL
  REPAIR
  SAMPLE
  TRANSFER
  OTHER
}

/// Porto (who pays the carriage), as factory-domain documents DDT_FREIGHT.
enum DdtFreight {
  /// Franco: the sender pays.
  FREE
  /// Assegnato: the recipient pays.
  FORWARD
}

/// The cancellation of an issued DDT (A1 §2.5: a DDT is never deleted; LOG-054): why and when. The DDT keeps its number
/// in the series (no gap); a new DDT replaces it. Never changed or removed (the triggers, for every login). One per DDT
/// (the shipping module's, under the DDT's lock: a unique key of ids alone cannot be copied by the generated isolation
/// tests).
/// @append-only
model DdtCancellation {
  id          String   @id @db.Uuid
  tenantId    String   @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  siteId      String   @db.Uuid
  /// The DDT's party (the partner role's policy key).
  partyId     String   @db.Uuid
  ddtId       String   @db.Uuid
  reason      String
  cancelledAt DateTime @db.Timestamptz(3)
  createdById String?  @db.Uuid

  ddt Ddt @relation(fields: [tenantId, siteId, partyId, ddtId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, ddtId])
}

/// One tracking event of a shipment or one of its parcels (LOG-059; A1 §2.4 F TrackingEvent): the carrier's status
/// mapped to one list, when it happened, where, and where the event came from (a Sendcloud webhook, a poll, or typed by
/// the office for our own van). A resent carrier event is recorded once (externalEventId). Never changed or removed (the
/// triggers, for every login).
/// @append-only
model TrackingEvent {
  id                String         @id @db.Uuid
  tenantId          String         @default(dbgenerated("(NULLIF(current_setting('factory.tenant_id'::text, true), ''::text))::uuid")) @db.Uuid
  siteId            String         @db.Uuid
  /// The shipment's party (the partner role's policy key).
  partyId           String         @db.Uuid
  shipmentId        String         @db.Uuid
  /// The parcel it is about; null: the whole shipment.
  parcelId          String?        @db.Uuid
  status            TrackingStatus
  /// The carrier's own status code and text, and the place, as reported.
  carrierStatusCode String?
  description       String?
  location          String?
  /// When it happened (the carrier's time), and when the factory recorded it.
  occurredAt        DateTime       @db.Timestamptz(3)
  recordedAt        DateTime       @default(now()) @db.Timestamptz(3)
  source            TrackingSource
  /// The carrier's (or Sendcloud's) id of the event: one row per shipment and id; null for a typed event.
  externalEventId   String?
  createdById       String?        @db.Uuid

  shipment Shipment @relation(fields: [tenantId, siteId, partyId, shipmentId], references: [tenantId, siteId, partyId, id], onDelete: Restrict, onUpdate: Restrict)
  // Restrict, not Prisma's SetNull default for an optional relation: that would also clear tenantId, siteId and
  // shipmentId.
  parcel   Parcel?  @relation(fields: [tenantId, siteId, shipmentId, parcelId], references: [tenantId, siteId, shipmentId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, shipmentId, externalEventId])
  @@index([tenantId, shipmentId, occurredAt])
}

/// One status list for every carrier (LOG-059).
enum TrackingStatus {
  /// The label is printed; the carrier has not collected it.
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  /// A delay, an address problem, a failed delivery.
  EXCEPTION
  /// Going or gone back to the sender.
  RETURNED
}

/// Where a tracking event came from.
enum TrackingSource {
  /// A verified Sendcloud webhook (the inbound ledger).
  WEBHOOK
  /// A poll of the carrier through the gateway.
  POLL
  /// Typed by the office (our own van, the customer's carrier).
  MANUAL
}
