{
  "name": "@nexus/database",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "nexus-model-metadata": "./scripts/generate-model-metadata.cjs"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    "./model-metadata": {
      "types": "./model-metadata.d.ts",
      "default": "./model-metadata.js"
    },
    "./runtime-role": {
      "types": "./runtime-role.d.ts",
      "default": "./runtime-role.js"
    },
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./workspace-context": {
      "types": "./workspace-context.d.ts",
      "import": "./workspace-context.js",
      "default": "./workspace-context.js"
    },
    "./workspace-adapter": {
      "types": "./workspace-adapter.d.ts",
      "import": "./workspace-adapter.js",
      "default": "./workspace-adapter.js"
    },
    "./workspace-client": {
      "types": "./workspace-client.d.ts",
      "import": "./workspace-client.js",
      "default": "./workspace-client.js"
    },
    "./workspace-router": {
      "types": "./workspace-router.d.ts",
      "import": "./workspace-router.js",
      "default": "./workspace-router.js"
    }
  },
  "scripts": {
    "dev": "echo \"Add your database dev command here\"",
    "build": "prisma generate && node scripts/build-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate && node scripts/build-runtime.mjs",
    "check:drift": "node scripts/check-schema-drift.mjs",
    "check:column-drift": "node scripts/check-column-drift.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/generator-helper": "7.10.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
