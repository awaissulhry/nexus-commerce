{
  // Mirrors its siblings `packages/events` and `packages/shared`: no `extends` (there is no
  // `tsconfig.base.json` at the repo root) and `include: ["*.ts"]` (this package has no `src/` —
  // its sources are `index.ts` plus `migrations/` and `scripts/`).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "*.vitest.test.ts",
    // 🔴 GENERATED — its first line reads `// This file was generated by Prisma`. It fails `strict`
    // with `url: process.env["DATABASE_URL"]` (string | undefined vs string), and editing it is
    // unstable because the next `prisma generate` reverts the fix. A generated file is not ours to
    // typecheck; excluding it is what makes this package's gate green for a real reason rather than
    // red for one nobody may act on. See TECH_DEBT #63.
    "prisma.config.ts"
  ]
}
