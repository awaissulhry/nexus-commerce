{
  // 2026-09-30: typecheck's cache key must hold every file this tsc program reads from outside apps/api. turbo hashes
  // only the package's own folder and the builds it depends on, so an edit to apps/web/src (presence.ts, registry.ts
  // and tone.ts are compiled here through `@nexus/web/src/…` imports) or to packages/database (its .d.ts files and the
  // schema the Prisma types come from) left the hash unchanged, and a cached pass replayed. That local cache is one
  // directory shared by every worktree of a checkout. See ci.yml, "Typecheck both apps".
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**", "$TURBO_ROOT$/packages/database/**"]
    }
  }
}
