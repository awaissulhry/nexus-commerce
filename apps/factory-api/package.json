{
  "name": "@nexus/factory-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx src/background.ts worker",
    "dev:scheduler": "tsx src/background.ts scheduler",
    "build": "npm run generate -w @nexus/factory-db && node build.mjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/background.js worker",
    "start:scheduler": "node dist/background.js scheduler",
    "typecheck": "node --max-old-space-size=8192 ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@nexus/db-kit": "*",
    "@nexus/factory-db": "*",
    "@nexus/factory-domain": "*",
    "bullmq": "^5.76.2",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "postal-mime": "^3.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
