# Copy to apps/factory-api/.env (git-ignored). The API reads ONLY that file and ONLY FACTORY_ variables.
# Loopback only: with FACTORY_ENV=local or test the loader refuses any other database or Redis host.
# Never put a staging or production value here; those live only in Railway variables.
FACTORY_ENV=local
# One database per worktree: factory_<step> (for example factory_w9_01), on the local stack (infra/factory).
# The runtime login factory_app (made by the migrations, no password on loopback): the boot audit refuses a superuser
# or an owner such as postgres.
FACTORY_DATABASE_URL=postgresql://factory_app@127.0.0.1:5442/factory_<step>
FACTORY_REDIS_URL=redis://127.0.0.1:6399
# Required locally: the local Redis is shared by every worktree, so every queue, cron lock and live-screen key of this
# worktree sits under its own prefix, the step (for example w9_01). Railway defaults it to `factory`.
FACTORY_QUEUE_PREFIX=<step>
FACTORY_PORT=8190
# Optional locally (staging and production set them in Railway):
# FACTORY_WEB_ORIGIN=http://localhost:3200
# FACTORY_COOKIE_SECRET=   (local and test use a fixed placeholder)
# FACTORY_TRUST_PROXY_HOPS=0
