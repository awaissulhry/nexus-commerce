# Turbo
.turbo/
.next/
# Every Next build dir, not an enumerated few. NEXT_DIST_DIR / FACTORY_BUILD_DIR let any
# session name its own (.next-dev, .next-push-$$, .next-check-*, .next-diag-*, .next-verify,
# .next-ar0 …), and the enumerated list fell behind: on 2026-08-27 three such dirs were
# sitting UNIGNORED in the tree. Directory-only, and no tracked path starts with `.next-`.
.next-*/

# Cache
.cache/
.eslintcache

# Prisma
prisma/migrations/
.vercel

# Generated tool output
repomix-output.xml

# Session-analysis artifacts (screen recordings, frame dumps) — never in VCS (GitHub 100MB hard limit; a 500MB .raw here blocked every push on 2026-07-18)
.analysis/

# Obsidian UI state — rewrites on every pane move, pure commit noise
obsidian-vault/.obsidian/workspace.json

# Local Claude Code permission overrides — machine-specific, and has held DB credentials
.claude/settings.local.json
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/ds-pkg/dist/

# design-sync emits a declaration tree beside the DS source (ds-pkg/build.mjs step 1, so the
# converter can read each component's API). They are BUILD OUTPUT sitting in a source directory:
# 78 of them, regenerated every sync, and a stale one next to its .tsx invites the reader to trust
# the wrong file. TypeScript resolves .ts/.tsx first so they do not shadow anything at build time.
apps/web/src/design-system/**/*.d.ts
