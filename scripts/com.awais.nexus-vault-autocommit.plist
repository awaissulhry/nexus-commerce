<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scoped Obsidian-vault auto-commit timer. Install with:

    cp scripts/com.awais.nexus-vault-autocommit.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.awais.nexus-vault-autocommit.plist

  Uninstall with:

    launchctl bootout gui/$(id -u)/com.awais.nexus-vault-autocommit
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.awais.nexus-vault-autocommit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/awais/nexus-commerce/scripts/vault-autocommit.sh</string>
    </array>

    <!-- Every 5 minutes. The script exits immediately when the vault is
         unchanged, so an idle tick costs essentially nothing. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/vault-autocommit.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vault-autocommit.err</string>
</dict>
</plist>
