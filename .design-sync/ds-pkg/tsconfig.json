{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "../../apps/web/src/design-system",
    "baseUrl": "../..",
    "paths": { "@/*": ["apps/web/src/*"] },
    "types": []
  },
  "include": [
    "../../apps/web/src/design-system/**/*.ts",
    "../../apps/web/src/design-system/**/*.tsx"
  ],
  "exclude": [
    "../../apps/web/src/design-system/tools/**",
    "../../apps/web/src/design-system/catalog/**",
    "../../apps/web/src/design-system/**/*.test.ts",
    "../../apps/web/src/design-system/**/*.test.tsx"
  ]
}
