{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "../../apps/web/src/design-system",
    "baseUrl": "../..",
    "paths": { "@/*": ["apps/web/src/*"] },
    // `modules.ts` reads `process.env.NODE_ENV` to register AG's ValidationModule in development
    // only. That is a build-time constant the bundler inlines, but the DECLARATION build still has
    // to type it, and `[]` left it as "Cannot find name 'process'" — which failed the whole DS
    // declaration emit, for every component. Node types are declaration-only here: this config
    // emits `.d.ts` and nothing else, so nothing node-shaped can reach a browser bundle.
    "types": ["node"]
  },
  "include": [
    "../../apps/web/src/design-system/**/*.ts",
    "../../apps/web/src/design-system/**/*.tsx"
  ],
  "exclude": [
    "../../apps/web/src/design-system/tools/**",
    "../../apps/web/src/design-system/catalog/**",
    "../../apps/web/src/design-system/**/*.test.ts",
    "../../apps/web/src/design-system/**/*.test.tsx"
  ]
}
